load "lst-in"
load "lst-toset"
load "dlist.ath"
load "function.ath"
open Function
module DL_L_S {
    define [f]     := [?f:(fn 'S N)]
    define [b]     := [?b:Boolean]
    define [sets s0]  := [?sets:(Set.Set 'S) ?s0:(Set.Set 'S)]
    define [lsts lsts1 lsts2 tail_s]  := [?lsts:(Lst 'S) ?lsts1:(Lst 'S) ?lsts2:(Lst 'S) ?tail_s:(Lst 'S)]
    define [tail_l1 tail_l2] := [?tail_l1:(Lst Location) ?tail_l2:(Lst Location)]
    define [l1 l2] := [?l1:Location ?l2:Location]
    define [s htv v v0 head]       := [?s:'S ?htv:'S ?v:'S ?v0:'S ?head:(Lst 'S)]
    define [n rv rv0 bucket bucket0]  := [?n:N ?rv:N ?rv0:N ?bucket:N ?bucket0:N]
    define [dlls tail_dlls o_dlls]  :=
           [?dlls:(DLst (Lst 'S)) ?tail_dlls:(DLst (Lst 'S)) ?o_dlls:(DLst (Lst 'S))]
    # Extra dlls binders used by the location-preservation / available-key
    # invariance lemmas below.
    define [dlls1 dlls2 o_dlls1 o_dlls2] :=
           [?dlls1:(DLst (Lst 'S)) ?dlls2:(DLst (Lst 'S))
            ?o_dlls1:(DLst (Lst 'S)) ?o_dlls2:(DLst (Lst 'S))]
    # Extra N binders used by available_key invariance statements (so the
    # quantified `B R` aren't confused with the insert's `bucket rv`).
    define [B R] := [?B:N ?R:N]
    define [l l0 lh htl htl0 ll tail_l tail_l0] := 
           [?l:Location ?l0:Location ?lh:Location ?htl:Location ?htl0:Location
            ?ll:(Lst Location) ?tail_l:(Lst Location) ?tail_l0:(Lst Location)]

    # Pattern variables that spell out a NON-EMPTY `o_dlls`. They let the
    # wrap-around clauses of `in` and `available_key` name an explicitly
    # `dlst`-shaped original list, which is what keeps those clauses disjoint
    # from the empty-`o_dlls` clause (see the soundness notes below).
    define [olh olsts otail_dlls] :=
           [?olh:Location ?olsts:(Lst 'S) ?otail_dlls:(DLst (Lst 'S))]

    # Fresh binders for existentials that assert a bucket list is a `dlst`,
    # used where the pattern variables above are already bound by a case split.
    define [lh2 lsts2 tail_dlls2] :=
           [?lh2:Location ?lsts2:(Lst 'S) ?tail_dlls2:(DLst (Lst 'S))]

    ### initDPrList
    ### Purpose:
    ###     Initialize a distributed list of buckets, one bucket per input location. Each
    ###     bucket is initialize as an empty list. You might notice that f is never use,
    ###     the reason being that is the way to have information about 'S in the parameter
    ###     input list.
    ###
    ### Parameters:
    ###     f::(fn S N)         : A hash function
    ###     htl0::Location      : default tail location (for dempty)
    ###     lsts:(Lst Location) : list of locations to initialize
    ###
    ### Returns:
    ###     A (DLst (Lst S)) where every location in lsts
    ###     corresponds to an empty bucket (list).
    declare initDPrList: (S) [(fn S N) Location (Lst Location)] -> (DLst (Lst S))
    assert  initDPrList_axioms := 
         (fun [ 
            (initDPrList f htl0 empty) = (dempty htl0)
            (initDPrList f htl0 (lst l tail_l)) = (dlst l empty (initDPrList f htl0 tail_l))
        ])

    # Shape of an initialized bucket list (PROVEN, by cases on the location list).
    # Stated first with the location list outermost, so that datatype-cases can
    # split on it, and then re-quantified in the order used by its call sites.
    define initDPrList_char_aux :=
        (forall ll f htl . (
                    ((initDPrList f htl ll) = (dempty htl))
                  | (exists l tail_l . (initDPrList f htl ll) = (dlst l empty (initDPrList f htl tail_l)))))

    datatype-cases initDPrList_char_aux {
      (ll as empty) =>
        pick-any f htl
          (!either (!chain [(initDPrList f htl ll) = (dempty htl)   [initDPrList_axioms]])
                   (exists l tail_l . (initDPrList f htl ll) = (dlst l empty (initDPrList f htl tail_l))))
    | (ll as (lst l1 tail_l1)) =>
        pick-any f htl
          let {_  := (!chain [(initDPrList f htl ll)
                              = (dlst l1 empty (initDPrList f htl tail_l1))   [initDPrList_axioms]]);
               ex := (!egen* (exists l tail_l . (initDPrList f htl ll) = (dlst l empty (initDPrList f htl tail_l)))
                             [l1 tail_l1])}
          (!either ((initDPrList f htl ll) = (dempty htl)) ex)
    }

    define initDPrList_characterization :=
        (forall f htl ll . (
                    ((initDPrList f htl ll) = (dempty htl))
                  | (exists l tail_l . (initDPrList f htl ll) = (dlst l empty (initDPrList f htl tail_l)))))
    conclude initDPrList_characterization
        pick-any f htl ll
            (!uspec* initDPrList_char_aux [ll f htl])

    ### insertNAt
    ### Purpose:
    ###     Helper that prepends `v` to the buckets at positions
    ###     [bucket, bucket+1, ..., bucket+n-1] of `dlls`. Insertions whose target
    ###     position lies past the end of the list are silently dropped; i.e. this
    ###     helper does NOT wrap around. Callers compose it with `countWraps`
    ###     (below) to obtain the full modulo semantics.
    ###
    ### Parameters:
    ###     bucket::N            : position of the first insertion.
    ###     n::N                 : number of consecutive insertions to perform.
    ###     v::S                 : value to be inserted.
    ###     dlls::(DLst (Lst S)) : distributed list to update.
    declare insertNAt: (S) [N N S (DLst (Lst S))] -> (DLst (Lst S))
    assert insertNAt_axioms := (fun [
            (insertNAt bucket zero v dlls) = dlls
            (insertNAt bucket (S n) v (dempty htl)) = (dempty htl)
            (insertNAt zero (S n) v (dlst lh lsts tail_dlls)) =
                (dlst lh (lst v lsts) (insertNAt zero n v tail_dlls))
            (insertNAt (S bucket) (S n) v (dlst lh lsts tail_dlls)) =
                (dlst lh lsts (insertNAt bucket (S n) v tail_dlls))
        ])

    ### countWraps
    ### Purpose:
    ###     Helper that returns how many of `n` consecutive insertions starting at
    ###     position `bucket` would fall past the end of `dlls` and therefore need
    ###     to wrap around to the front of the original list. Equal to
    ###     max(0, bucket + n - size(dlls)).
    ###
    ### Parameters:
    ###     bucket::N            : position of the first insertion.
    ###     n::N                 : number of consecutive insertions to consider.
    ###     dlls::(DLst (Lst S)) : distributed list whose length determines wrap.
    declare countWraps: (S) [N N (DLst (Lst S))] -> N
    assert countWraps_axioms := (fun [
            (countWraps bucket zero dlls) = zero
            (countWraps bucket (S n) (dempty htl)) = (S n)
            (countWraps zero (S n) (dlst lh lsts tail_dlls)) =
                (countWraps zero n tail_dlls)
            (countWraps (S bucket) (S n) (dlst lh lsts tail_dlls)) =
                (countWraps bucket (S n) tail_dlls)
        ])

    ### insertDPrList
    ### Purpose:
    ###     Insert a value `v` into the bucket at position `bucket` and into the
    ###     next `rv` replica buckets, with wrap-around modulo the size of the
    ###     distributed list. This realises the paper's replication semantics:
    ###     every value is replicated across (rv+1) consecutive buckets, indices
    ###     being taken modulo the number of buckets so that positions past the
    ###     end wrap back to the front. The (rv+1) buckets touched here are
    ###     exactly the (rv+1) buckets that `in` and `available_key` traverse on
    ###     the read side, closing the soundness gap between the write path
    ###     and the read path.
    ###
    ### Parameters:
    ###     bucket::N            : primary bucket index where insertion begins.
    ###                            Any natural number. It is reduced modulo
    ###                            size(dlls) by `bucketIndex` below.
    ###     rv::N                : replication factor; insertion writes to rv+1
    ###                            buckets in total (every bucket once when
    ###                            rv + 1 >= size(dlls)).
    ###     v::S                 : value of type S to be inserted.
    ###     dlls::(DLst (Lst S)) : distributed list representing buckets of values.
    ###
    ### Returns:
    ###     A new distributed list where `v` has been prepended to every bucket
    ###     at position (bucket + i) mod size(dlls), for i = 0, 1, ..., rv.
    ###     Buckets not in this set are left unchanged.
    ###
    ### Implementation:
    ###     The function is defined in three stages via the helpers above:
    ###         (0) `bucketIndex bucket dlls dlls zero` reduces `bucket` modulo
    ###             size(dlls), walking the list exactly as `available_key` and
    ###             `in` do.
    ###         (1) `insertNAt idx (S rv) v dlls` performs all the insertions
    ###             whose target lies within [idx, size(dlls)), truncating at
    ###             the end of the list.
    ###         (2) `countWraps idx (S rv) dlls` counts how many requested
    ###             insertions overflow past the end and therefore need to wrap.
    ###         (3) A second `insertNAt zero <wrap-count> v _` on the partially
    ###             modified list applies the wrapped insertions at the front,
    ###             completing the modulo semantics.
    ###
    ### Why stage (0) is needed: `insertNAt` and `countWraps` wrap only once,
    ### whereas `available_key` and `in` wrap every time they reach `dempty`, so
    ### they read the bucket index modulo size(dlls). Without stage (0) a hash
    ### value >= size(dlls) made the write window and the read window differ.
    ### For example, with two buckets, rv = zero and bucket = 3, the value was
    ### written to bucket 0 but looked up in bucket 1, so `query` answered
    ### (SOME false) for a value that had just been inserted.

    ### bucketIndex
    ### Purpose:
    ###     Reduce a bucket index modulo the number of buckets, by the same walk
    ###     that `available_key` and `in` perform: one step per real bucket,
    ###     restarting at the head of `o_dlls` when `dempty` is reached.
    ###
    ### Parameters:
    ###     bucket::N              : remaining steps of the walk.
    ###     dlls::(DLst (Lst S))   : suffix being walked.
    ###     o_dlls::(DLst (Lst S)) : original list, used for the wrap-around.
    ###     n::N                   : position of the head of `dlls` in `o_dlls`.
    ###
    ### Returns:
    ###     The position in `o_dlls` where the walk stops, or zero when there are
    ###     no buckets. The clauses are pairwise disjoint and exhaustive, with the
    ###     same patterns as `available_key`.
    declare bucketIndex: (S) [N (DLst (Lst S)) (DLst (Lst S)) N] -> N
    assert bucketIndex_axioms := (fun [
            (bucketIndex bucket (dempty htl0) (dempty htl) n) = zero
            (bucketIndex zero (dlst lh lsts tail_dlls) o_dlls n) = n
            (bucketIndex (S bucket) (dlst lh lsts tail_dlls) o_dlls n) =
                (bucketIndex bucket tail_dlls o_dlls (S n))
            (bucketIndex bucket (dempty htl) (dlst olh olsts otail_dlls) n) =
                (bucketIndex bucket (dlst olh olsts otail_dlls)
                                    (dlst olh olsts otail_dlls) zero)
        ])

    declare insertDPrList: (S) [N N S (DLst (Lst S))] -> (DLst (Lst S))
    assert insertDPrList_axioms := (fun [
            (insertDPrList bucket rv v dlls) =
                (insertNAt zero (countWraps (bucketIndex bucket dlls dlls zero) (S rv) dlls) v
                    (insertNAt (bucketIndex bucket dlls dlls zero) (S rv) v dlls))
        ])

    ### Totality witnesses for insertDPrList.
    ### The original two-axiom insertDPrList left three cases unconstrained:
    ###   (1) (insertDPrList zero v (dlst lh empty tail_dlls))   -- empty bucket
    ###   (2) (insertDPrList zero v (dempty htl))                -- empty dlls
    ###   (3) (insertDPrList (S n) v (dempty htl))               -- out of range
    ### The new definition (with replication factor rv and helpers insertNAt /
    ### countWraps) is total by construction: every constructor combination of
    ### (N, N, DLst) is covered by the helper axioms, and the single equation
    ### above applies for all inputs. The two lemmas below witness the resulting
    ### behavior on the formerly-undefined inputs:
    ###   insert_empty_bucket    -- insertion into an empty bucket prepends v.
    ###   insert_into_empty_dlls -- insertion on an empty dlls is a no-op,
    ###                             covering both (2) and (3).

    define insert_empty_bucket :=
        (forall lh tail_dlls v .
            (insertDPrList zero zero v (dlst lh empty tail_dlls)) =
                (dlst lh (lst v empty) tail_dlls))
    conclude insert_empty_bucket
        pick-any lh tail_dlls v
        (!chain [
            (insertDPrList zero zero v (dlst lh empty tail_dlls))
            = (insertNAt zero (countWraps (bucketIndex zero (dlst lh empty tail_dlls)
                                                            (dlst lh empty tail_dlls) zero)
                                          (S zero) (dlst lh empty tail_dlls)) v
                (insertNAt (bucketIndex zero (dlst lh empty tail_dlls)
                                             (dlst lh empty tail_dlls) zero)
                           (S zero) v (dlst lh empty tail_dlls)))           [insertDPrList_axioms]
            = (insertNAt zero (countWraps zero (S zero) (dlst lh empty tail_dlls)) v
                (insertNAt zero (S zero) v (dlst lh empty tail_dlls)))       [bucketIndex_axioms]
            = (insertNAt zero (countWraps zero zero tail_dlls) v
                (insertNAt zero (S zero) v (dlst lh empty tail_dlls)))       [countWraps_axioms]
            = (insertNAt zero zero v
                (insertNAt zero (S zero) v (dlst lh empty tail_dlls)))       [countWraps_axioms]
            = (insertNAt zero (S zero) v (dlst lh empty tail_dlls))          [insertNAt_axioms]
            = (dlst lh (lst v empty) (insertNAt zero zero v tail_dlls))      [insertNAt_axioms]
            = (dlst lh (lst v empty) tail_dlls)                              [insertNAt_axioms]
        ])

    define insert_into_empty_dlls :=
        (forall bucket rv v htl .
            (insertDPrList bucket rv v (dempty htl)) = (dempty htl))
    conclude insert_into_empty_dlls
        pick-any bucket rv v htl
        (!chain [
            (insertDPrList bucket rv v (dempty htl))
            = (insertNAt zero (countWraps (bucketIndex bucket (dempty htl) (dempty htl) zero)
                                          (S rv) (dempty htl)) v
                (insertNAt (bucketIndex bucket (dempty htl) (dempty htl) zero)
                           (S rv) v (dempty htl)))                          [insertDPrList_axioms]
            = (insertNAt zero (countWraps zero (S rv) (dempty htl)) v
                (insertNAt zero (S rv) v (dempty htl)))                      [bucketIndex_axioms]
            = (insertNAt zero (S rv) v
                (insertNAt zero (S rv) v (dempty htl)))                      [countWraps_axioms]
            = (insertNAt zero (S rv) v (dempty htl))                         [insertNAt_axioms]
            = (dempty htl)                                                    [insertNAt_axioms]
        ])

    ### dlls_locs / location-preservation lemmas
    ###
    ### insertNAt / insertDPrList rewrite only bucket contents (the lsts field of
    ### each dlst node), never bucket locations (the lh field). The lemmas below
    ### make that explicit by projecting a dlls down to its sequence of head
    ### locations and showing that this projection is invariant under insertion.
    ### Downstream, this is the structural fact that lets us prove available_key
    ### is preserved by insertion (since available_key only inspects locations
    ### and the dempty/dlst shape, which dlls_locs jointly captures).

    declare dlls_locs : (S) [(DLst (Lst S))] -> (Lst Location)
    assert dlls_locs_axioms := (fun [
        (dlls_locs (dempty htl)) = empty
        (dlls_locs (dlst lh lsts tail_dlls)) = (lst lh (dlls_locs tail_dlls))
    ])

    ### locs_lst_implies_dlst (PROVEN)
    ###
    ### `dlls_locs` records the emptiness of a bucket list: it returns `empty`
    ### exactly on a `dempty`. So a bucket list whose location projection is a
    ### non-empty list must itself be a `dlst`. This is the small shape fact that
    ### lets `insertDPrList_preserves_locs` carry non-emptiness across an
    ### insertion.
    define locs_lst_implies_dlst :=
        (forall dlls l tail_l .
            ((dlls_locs dlls) = (lst l tail_l))
            ==> (exists lh lsts tail_dlls . dlls = (dlst lh lsts tail_dlls)))
    datatype-cases locs_lst_implies_dlst {
        (dempty htl:Location) =>
            pick-any l:Location tail_l:(Lst Location)
            assume hyp := ((dlls_locs (dempty htl)) = (lst l tail_l))
                let {
                    collapse := (!chain [ (lst l tail_l)
                                        = (dlls_locs (dempty htl)) [hyp]
                                        = empty                    [dlls_locs_axioms] ]);
                    nc := (!uspec* Lst.lst-no-conf-empty [l tail_l])
                }
                (!from-complements
                    (exists lh lsts tail_dlls . (dempty htl) = (dlst lh lsts tail_dlls))
                    (!sym collapse) nc)
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            pick-any l:Location tail_l:(Lst Location)
            assume hyp := ((dlls_locs (dlst lh lsts tail_dlls)) = (lst l tail_l))
                let { r := (!reflex (dlst lh lsts tail_dlls)) }
                (!egen* (exists lh2 lsts2 tail_dlls2 .
                            (dlst lh lsts tail_dlls) = (dlst lh2 lsts2 tail_dlls2))
                        [lh lsts tail_dlls])
    }

    define insertNAt_preserves_locs :=
        (forall dlls bucket n v .
            (dlls_locs (insertNAt bucket n v dlls)) = (dlls_locs dlls))

    by-induction insertNAt_preserves_locs {
        (dempty htl) =>
            pick-any bucket:N n:N v:'S
            datatype-cases
                ((dlls_locs (insertNAt bucket n v (dempty htl))) = (dlls_locs (dempty htl)))
                on n
            {
                zero =>
                    (!chain [
                        (dlls_locs (insertNAt bucket zero v (dempty htl)))
                        = (dlls_locs (dempty htl)) [insertNAt_axioms]
                    ])
              | (S n') =>
                    (!chain [
                        (dlls_locs (insertNAt bucket (S n') v (dempty htl)))
                        = (dlls_locs (dempty htl)) [insertNAt_axioms]
                    ])
            }
      | (dlst lh lsts tail_dlls) =>
            let { IH := (forall bucket n v .
                            (dlls_locs (insertNAt bucket n v tail_dlls)) = (dlls_locs tail_dlls)) }
            pick-any bucket:N n:N v:'S
            datatype-cases
                ((dlls_locs (insertNAt bucket n v (dlst lh lsts tail_dlls))) =
                 (dlls_locs (dlst lh lsts tail_dlls)))
                on n
            {
                zero =>
                    (!chain [
                        (dlls_locs (insertNAt bucket zero v (dlst lh lsts tail_dlls)))
                        = (dlls_locs (dlst lh lsts tail_dlls)) [insertNAt_axioms]
                    ])
              | (S n') =>
                    datatype-cases
                        ((dlls_locs (insertNAt bucket (S n') v (dlst lh lsts tail_dlls))) =
                         (dlls_locs (dlst lh lsts tail_dlls)))
                        on bucket
                    {
                        zero =>
                            let { ih := (!uspec* IH [zero n' v]) }
                            (!chain [
                                (dlls_locs (insertNAt zero (S n') v (dlst lh lsts tail_dlls)))
                                = (dlls_locs (dlst lh (lst v lsts)
                                                (insertNAt zero n' v tail_dlls)))   [insertNAt_axioms]
                                = (lst lh (dlls_locs (insertNAt zero n' v tail_dlls))) [dlls_locs_axioms]
                                = (lst lh (dlls_locs tail_dlls))                       [ih]
                                = (dlls_locs (dlst lh lsts tail_dlls))                 [dlls_locs_axioms]
                            ])
                      | (S bucket') =>
                            let { ih := (!uspec* IH [bucket' (S n') v]) }
                            (!chain [
                                (dlls_locs (insertNAt (S bucket') (S n') v
                                                (dlst lh lsts tail_dlls)))
                                = (dlls_locs (dlst lh lsts
                                                (insertNAt bucket' (S n') v tail_dlls))) [insertNAt_axioms]
                                = (lst lh (dlls_locs
                                            (insertNAt bucket' (S n') v tail_dlls)))     [dlls_locs_axioms]
                                = (lst lh (dlls_locs tail_dlls))                          [ih]
                                = (dlls_locs (dlst lh lsts tail_dlls))                    [dlls_locs_axioms]
                            ])
                    }
            }
    }

    # Corollary: insertDPrList (= two compositions of insertNAt) preserves
    # the list of bucket head-locations.
    define insertDPrList_preserves_locs :=
        (forall bucket rv v dlls .
            (dlls_locs (insertDPrList bucket rv v dlls)) = (dlls_locs dlls))
    conclude insertDPrList_preserves_locs
        pick-any bucket rv v dlls
            let {
                idx      := (bucketIndex bucket dlls dlls zero);
                inner_eq := (!uspec* insertNAt_preserves_locs [dlls idx (S rv) v]);
                outer_eq := (!uspec* insertNAt_preserves_locs
                                    [(insertNAt idx (S rv) v dlls)
                                     zero
                                     (countWraps idx (S rv) dlls)
                                     v])
            }
            (!chain [
                (dlls_locs (insertDPrList bucket rv v dlls))
                = (dlls_locs (insertNAt zero (countWraps idx (S rv) dlls) v
                                (insertNAt idx (S rv) v dlls)))              [insertDPrList_axioms]
                = (dlls_locs (insertNAt idx (S rv) v dlls))                  [outer_eq]
                = (dlls_locs dlls)                                            [inner_eq]
            ])

    ### in
    ### Purpose:
    ###     Replication aware membership predicate for distributed bucket lists.
    ###     Determines whether a value `v` is stored in the bucket indexed by `bucket`,
    ###     or in any of the next `rv` replica buckets, with a wrap around semantics.
    ###
    ### Parameters:
    ###     bucket::N              : primary bucket index to inspect
    ###     rv::N                  : replication factor, number of successor buckets to check
    ###     dlls::(DLst (Lst S))   : current suffix of the distributed list to traverse
    ###     o_dlls::(DLst (Lst S)) : original distributed list (used when wrap-around is required)
    ###     v::S                   : value to search for
    ###
    ### Returns:
    ###     Boolean indicating whether `v` appears in the bucket at position `bucket` or 
    ###      within the next `rv` buckets modulo the length of the list.
    ###
    ### INDEX ARITHMETIC — `in` walks in lock step with `available_key`.
    ###
    ### Three definitions have to agree on which buckets form the window
    ### [bucket, bucket + rv] modulo the number of buckets:
    ###   * `insertDPrList`, the write path, which gets it right by construction
    ###     through `insertNAt` composed with `countWraps`;
    ###   * `available_key`, the availability path, which `query_aux` uses as the
    ###     guard deciding between SOME and NONE;
    ###   * `in`, the read path, whose result `query_aux` returns.
    ### If they disagree, `query_aux` guards one walk with a different walk and
    ### the availability guarantee says nothing about the value returned.
    ###
    ### The clauses below therefore mirror `available_key_axioms` one for one,
    ### with `(Lst.in htv lsts)` exactly where the other has
    ### `(Location.alive lh)`. Two earlier defects broke that correspondence and
    ### are fixed here:
    ###   (i)  the walk did not wrap when `bucket` and `rv` had both reached zero
    ###        at the `dempty` terminus, so a value stored in a wrapped replica
    ###        was reported absent; and
    ###   (ii) the wrap clause decremented `bucket`, which made indices behave
    ###        modulo (#buckets + 1) instead of modulo #buckets.
    ### `test/dlls_index_examples.ath` checks both on a three-bucket ring, against the
    ### old clauses as well as the new ones.
    declare in: (S) [N N (DLst (Lst S)) (DLst (Lst S)) S] -> Boolean
    ### SOUNDNESS NOTE on the clause patterns below — do not make them contradict.
    ###
    ### `fun` does not give its clauses first-match (priority) semantics: each
    ### clause becomes an independent, universally quantified biconditional. Two
    ### clauses whose patterns unify therefore equate the same atom with two
    ### different right-hand sides, which is a contradiction rather than a
    ### disambiguation. See the matching note on `available_key` below.
    ###
    ### An earlier version of this definition ended with the catch-all
    ###     (in bucket rv dlls (dempty htl) htv) <==> false
    ### intended to say "an empty original list holds nothing". Because `dlls`
    ### and `bucket`/`rv` were unrestricted, it unified with the `dlst` clauses
    ### at `o_dlls = (dempty htl)` and equated the same atom with
    ### `(Lst.in htv lsts)`, so the two clauses jointly proved
    ### `(forall x l . ~ (Lst.in x l))` — no element belongs to any list. With
    ### `Lst.In.in-lst-axiom` that made the assumption base inconsistent.
    ###
    ### The sound reading of that clause is narrower: `dlls` is always a suffix
    ### of `o_dlls`, so an empty `o_dlls` forces an empty `dlls` too. The
    ### `(dempty _) (dempty _)` clause below says exactly that. The clauses are
    ### pairwise disjoint and mirror those of `available_key` one for one.
    assert in_axioms := (fun [
        # Both lists exhausted: there is no bucket anywhere, so nothing is found.
        # This is the only clause with an empty `o_dlls`, and it is what stops
        # the wrap-around clause below from looping forever.
        (in bucket rv (dempty htl0) (dempty htl) htv) <==> false
        (in zero zero (dlst lh lsts tail_dlls) o_dlls htv) <==> (Lst.in htv lsts)
        (in zero (S rv) (dlst lh lsts tail_dlls) o_dlls htv) <==>
            [
                true 
                    when (Lst.in htv lsts)
                (in zero rv tail_dlls o_dlls htv) 
                    when (~ Lst.in htv lsts)
            ]
        (in (S bucket) rv (dlst lh lsts tail_dlls) o_dlls htv) <==>
            (in bucket rv tail_dlls o_dlls htv)
        # Wrap-around, in lock step with `available_key`: the walked suffix has
        # run out while the original list is still non-empty, so restart at the
        # head of `o_dlls` WITHOUT decrementing `bucket` or `rv`. The `dempty`
        # terminus is not a real bucket, so it must not consume a step of the
        # window, and it must not consume a step of the bucket index either.
        (in bucket rv (dempty htl) (dlst olh olsts otail_dlls) htv) <==>
            (in bucket rv (dlst olh olsts otail_dlls)
                          (dlst olh olsts otail_dlls) htv)
    ])
    
    # Generalized: dlls and o_dlls are allowed to be two *different* init lists.
    # This is the strengthening that lets the IH fit at every recursion step;
    # the original 1-list lemma (in_init_false) follows as a corollary below.
    define in_init_false_lsts :=
        (forall lsts1 lsts2 f v htl .
            (~ in zero zero (initDPrList f htl lsts1) (initDPrList f htl lsts2) v))
    by-induction in_init_false_lsts {
        empty =>
            pick-any lsts2 f v htl
            let {
                init_empty := (!chain [ (initDPrList f htl empty)
                                        = (dempty htl) [initDPrList_axioms] ])
            }
            # `in` no longer has a clause that returns false for an empty `dlls`
            # against an arbitrary `o_dlls`: with a non-empty `o_dlls` the walk
            # wraps instead. So we split on the shape of the original list.
            (!cases (!uspec* initDPrList_characterization [f htl lsts2])
                # Subcase 1: the original list is empty too, so nothing to wrap
                # onto and the (dempty _) (dempty _) clause applies.
                assume empty_lsts2 := ((initDPrList f htl lsts2) = (dempty htl))
                (!by-contradiction
                    (~ in zero zero (initDPrList f htl empty) (initDPrList f htl lsts2) v)
                    (!chain [
                        (in zero zero (initDPrList f htl empty) (initDPrList f htl lsts2) v)
                        ==> (in zero zero (dempty htl) (initDPrList f htl lsts2) v)  [init_empty]
                        ==> (in zero zero (dempty htl) (dempty htl) v)               [empty_lsts2]
                        ==> false                                                    [in_axioms]
                    ]))
                # Subcase 2: the original list is non-empty, so the walk wraps
                # onto its head. That head is a freshly initialized bucket, hence
                # empty, and with rv = 0 the walk stops there.
                assume nonempty_lsts2 :=
                    (exists l tail_l .
                        (initDPrList f htl lsts2) = (dlst l empty (initDPrList f htl tail_l)))
                pick-witnesses l2 tail_l2 for nonempty_lsts2 lsts2_char
                (!by-contradiction
                    (~ in zero zero (initDPrList f htl empty) (initDPrList f htl lsts2) v)
                    (!chain [
                        (in zero zero (initDPrList f htl empty) (initDPrList f htl lsts2) v)
                        ==> (in zero zero (dempty htl) (initDPrList f htl lsts2) v)   [init_empty]
                        ==> (in zero zero (dempty htl)
                                          (dlst l2 empty (initDPrList f htl tail_l2)) v) [lsts2_char]
                        # wrap-around onto the head of the original list
                        ==> (in zero zero (dlst l2 empty (initDPrList f htl tail_l2))
                                          (dlst l2 empty (initDPrList f htl tail_l2)) v) [in_axioms]
                        ==> (Lst.in v empty)                                             [in_axioms]
                        ==> false                                                        [Lst.in_axioms]
                    ]))
            )
      | (lst l0 tail_l) =>
            pick-any lsts2 f v htl
            let {
                init_lst := (!chain [ (initDPrList f htl (lst l0 tail_l))
                                      = (dlst l0 empty (initDPrList f htl tail_l)) [initDPrList_axioms] ])
            }
            (!by-contradiction
                (~ in zero zero (initDPrList f htl (lst l0 tail_l)) (initDPrList f htl lsts2) v)
                (!chain [
                    (in zero zero (initDPrList f htl (lst l0 tail_l)) (initDPrList f htl lsts2) v)
                    ==> (in zero zero (dlst l0 empty (initDPrList f htl tail_l)) (initDPrList f htl lsts2) v) [init_lst]
                    ==> (Lst.in v empty)                                                                     [in_axioms]
                    ==> false                                                                                [Lst.in_axioms]
                ]))
    }

    define in_init_false_rv :=
        (forall rv lsts1 lsts2 f v htl .
            (~ in zero rv (initDPrList f htl lsts1) (initDPrList f htl lsts2) v))
    by-induction in_init_false_rv {
        zero =>
            pick-any lsts1 lsts2 f v htl
                (!uspec* in_init_false_lsts [lsts1 lsts2 f v htl])
      | (S rv0) =>
            let {
                IH := (forall lsts1 lsts2 f v htl .
                        (~ in zero rv0 (initDPrList f htl lsts1) (initDPrList f htl lsts2) v))
            }
            pick-any lsts1 lsts2 f v htl
            # Bring (~ Lst.in v empty) into the assumption base so the
            # conditional (S rv)/dlst axiom selects the second branch.
            let {
                not_in_v_empty := (!chain<- [(~ Lst.in v empty) <== true [Lst.In.in-empty-axiom]])
            }
            (!cases (!uspec* initDPrList_characterization [f htl lsts1])
                # Case A: init lsts1 = dempty
                assume empty_lsts1 := ((initDPrList f htl lsts1) = (dempty htl))
                (!cases (!uspec* initDPrList_characterization [f htl lsts2])
                    # Subcase A1: init lsts2 also dempty -> falls out of axiom 6
                    assume empty_lsts2 := ((initDPrList f htl lsts2) = (dempty htl))
                    (!by-contradiction
                        (~ in zero (S rv0) (initDPrList f htl lsts1) (initDPrList f htl lsts2) v)
                        (!chain [
                            (in zero (S rv0) (initDPrList f htl lsts1) (initDPrList f htl lsts2) v)
                            # Both init-lists are empty here, so rewrite both positions
                            # and appeal to the (dempty _) (dempty _) clause of `in`.
                            ==> (in zero (S rv0) (dempty htl) (initDPrList f htl lsts2) v) [empty_lsts1]
                            ==> (in zero (S rv0) (dempty htl) (dempty htl) v)              [empty_lsts2]
                            ==> false                                                       [in_axioms]
                        ]))
                    # Subcase A2: init lsts2 = dlst l2 empty (init tail_l2); use wrap then IH
                    assume nonempty_lsts2 :=
                        (exists l tail_l .
                            (initDPrList f htl lsts2) = (dlst l empty (initDPrList f htl tail_l)))
                    pick-witnesses l2 tail_l2 for nonempty_lsts2 lsts2_char
                    let {
                        ih := (!uspec* IH [tail_l2 lsts2 f v htl])
                    }
                    (!by-contradiction
                        (~ in zero (S rv0) (initDPrList f htl lsts1) (initDPrList f htl lsts2) v)
                        (!chain [
                            (in zero (S rv0) (initDPrList f htl lsts1) (initDPrList f htl lsts2) v)
                            # Substitute the two init-positions independently.
                            ==> (in zero (S rv0) (dempty htl) (initDPrList f htl lsts2) v)               [empty_lsts1]
                            ==> (in zero (S rv0) (dempty htl) (dlst l2 empty (initDPrList f htl tail_l2)) v) [lsts2_char]
                            # wrap-around: dlls = dempty, recurse with dlls = o_dlls
                            ==> (in zero (S rv0) (dlst l2 empty (initDPrList f htl tail_l2))
                                                 (dlst l2 empty (initDPrList f htl tail_l2)) v)            [in_axioms]
                            # (S rv)/dlst conditional axiom; the not_in_v_empty fact in scope selects the false branch
                            ==> (in zero rv0 (initDPrList f htl tail_l2)
                                             (dlst l2 empty (initDPrList f htl tail_l2)) v)               [in_axioms]
                            # Rewrite o_dlls back to (init lsts2) via lsts2_char (reverse direction)
                            ==> (in zero rv0 (initDPrList f htl tail_l2) (initDPrList f htl lsts2) v)     [lsts2_char]
                            # Combine with ih (in scope) to derive false propositionally
                            ==> ((in zero rv0 (initDPrList f htl tail_l2) (initDPrList f htl lsts2) v) &
                                 (~ in zero rv0 (initDPrList f htl tail_l2) (initDPrList f htl lsts2) v)) [augment]
                            ==> false                                                                      [prop-taut]
                        ]))
                )
                # Case B: init lsts1 = dlst l1 empty (init tail_l1); peel one bucket, then IH
                assume nonempty_lsts1 :=
                    (exists l tail_l .
                        (initDPrList f htl lsts1) = (dlst l empty (initDPrList f htl tail_l)))
                pick-witnesses l1 tail_l1 for nonempty_lsts1 lsts1_char
                let {
                    ih := (!uspec* IH [tail_l1 lsts2 f v htl])
                }
                (!by-contradiction
                    (~ in zero (S rv0) (initDPrList f htl lsts1) (initDPrList f htl lsts2) v)
                    (!chain [
                        (in zero (S rv0) (initDPrList f htl lsts1) (initDPrList f htl lsts2) v)
                        ==> (in zero (S rv0) (dlst l1 empty (initDPrList f htl tail_l1))
                                             (initDPrList f htl lsts2) v)                          [lsts1_char]
                        # (S rv)/dlst conditional axiom; not_in_v_empty selects false branch
                        ==> (in zero rv0 (initDPrList f htl tail_l1) (initDPrList f htl lsts2) v)  [in_axioms]
                        ==> ((in zero rv0 (initDPrList f htl tail_l1) (initDPrList f htl lsts2) v) &
                             (~ in zero rv0 (initDPrList f htl tail_l1) (initDPrList f htl lsts2) v)) [augment]
                        ==> false                                                                   [prop-taut]
                    ]))
            )
    }

    define in_init_false_aux :=
        (forall bucket rv lsts1 lsts2 f v htl .
            (in bucket rv (initDPrList f htl lsts1) (initDPrList f htl lsts2) v) ==> false)
    by-induction in_init_false_aux {
        zero =>
            pick-any rv lsts1 lsts2 f v htl
                (!chain<- [
                    ((in zero rv (initDPrList f htl lsts1) (initDPrList f htl lsts2) v) ==> false)
                    <== (~ in zero rv (initDPrList f htl lsts1) (initDPrList f htl lsts2) v)
                    <== true [in_init_false_rv]
                ])
      | (S bucket) =>
            let {
                IH := (forall rv lsts1 lsts2 f v htl .
                        (in bucket rv (initDPrList f htl lsts1) (initDPrList f htl lsts2) v) ==> false)
            }
            pick-any rv lsts1 lsts2 f v htl
            (!cases (!uspec* initDPrList_characterization [f htl lsts1])
                # Case A: init lsts1 = dempty. The wrap-around no longer decrements
                # the bucket index — the `dempty` terminus is not a real bucket —
                # so we wrap and then take one genuine step over the head of the
                # original list. That step is what makes the index smaller and
                # lets the IH apply.
                assume empty_lsts1 := ((initDPrList f htl lsts1) = (dempty htl))
                (!cases (!uspec* initDPrList_characterization [f htl lsts2])
                    # Subcase A1: nothing to wrap onto, so `in` is false outright.
                    assume empty_lsts2 := ((initDPrList f htl lsts2) = (dempty htl))
                    (!chain [
                        (in (S bucket) rv (initDPrList f htl lsts1) (initDPrList f htl lsts2) v)
                        ==> (in (S bucket) rv (dempty htl) (initDPrList f htl lsts2) v) [empty_lsts1]
                        ==> (in (S bucket) rv (dempty htl) (dempty htl) v)              [empty_lsts2]
                        ==> false                                                       [in_axioms]
                    ])
                    # Subcase A2: wrap onto the head of the original list, then step
                    # past that head. The bucket index drops from (S bucket) to
                    # bucket, which is what the IH needs.
                    assume nonempty_lsts2 :=
                        (exists l tail_l .
                            (initDPrList f htl lsts2) = (dlst l empty (initDPrList f htl tail_l)))
                    pick-witnesses l2 tail_l2 for nonempty_lsts2 lsts2_char
                    let {
                        ih := (!uspec* IH [rv tail_l2 lsts2 f v htl])
                    }
                    (!chain [
                        (in (S bucket) rv (initDPrList f htl lsts1) (initDPrList f htl lsts2) v)
                        ==> (in (S bucket) rv (dempty htl) (initDPrList f htl lsts2) v)  [empty_lsts1]
                        ==> (in (S bucket) rv (dempty htl)
                                             (dlst l2 empty (initDPrList f htl tail_l2)) v) [lsts2_char]
                        # wrap-around: bucket index untouched
                        ==> (in (S bucket) rv (dlst l2 empty (initDPrList f htl tail_l2))
                                             (dlst l2 empty (initDPrList f htl tail_l2)) v) [in_axioms]
                        # one real bucket consumed: (S bucket) becomes bucket
                        ==> (in bucket rv (initDPrList f htl tail_l2)
                                          (dlst l2 empty (initDPrList f htl tail_l2)) v)    [in_axioms]
                        ==> (in bucket rv (initDPrList f htl tail_l2)
                                          (initDPrList f htl lsts2) v)                      [lsts2_char]
                        ==> false                                                            [ih]
                    ])
                )
                # Case B: init lsts1 = dlst l1 empty (init tail_l1) -> advance dlls, then IH
                assume nonempty_lsts1 :=
                    (exists l tail_l .
                        (initDPrList f htl lsts1) = (dlst l empty (initDPrList f htl tail_l)))
                pick-witnesses l1 tail_l1 for nonempty_lsts1 lsts1_char
                let {
                    ih := (!uspec* IH [rv tail_l1 lsts2 f v htl])
                }
                (!chain [
                    (in (S bucket) rv (initDPrList f htl lsts1) (initDPrList f htl lsts2) v)
                    ==> (in (S bucket) rv (dlst l1 empty (initDPrList f htl tail_l1))
                                          (initDPrList f htl lsts2) v)                     [lsts1_char]
                    ==> (in bucket rv (initDPrList f htl tail_l1) (initDPrList f htl lsts2) v) [in_axioms]
                    ==> false                                                                   [ih]
                ])
            )
    }

    # 1-list corollary: keeps the original public statement unchanged.
    define in_init_false :=
        (forall bucket rv lsts f v htl .
            (in bucket rv (initDPrList f htl lsts) (initDPrList f htl lsts) v) <==> false)
    conclude in_init_false
        pick-any bucket rv lsts f v htl
            (!equiv
                (!uspec* in_init_false_aux [bucket rv lsts lsts f v htl])
                (assume false
                    (!from-false (in bucket rv (initDPrList f htl lsts) (initDPrList f htl lsts) v)))
            )

    ### in_after_insert_self_bucket_zero (full proof, factored through helpers)
    ###
    ### The general statement, for any bucket index, is in_after_insert_self
    ### at the end of this module. This special case is kept because its
    ### helpers are simple and independent of `drop`.
    ###
    ### After insertDPrList at bucket=0 with any rv into a non-empty dlls, the
    ### value v is `in` the result at bucket 0. The proof is factored into
    ### two helpers:
    ###   in_head_v_true:                  if the head bucket's lsts already
    ###                                    starts with v, `in zero rv` finds v
    ###                                    immediately for any rv.
    ###   in_after_insertNAt_zero_with_v_head:
    ###                                    insertNAt zero w v preserves the
    ###                                    "head starts with v" structure (it
    ###                                    only ever prepends more v's at the
    ###                                    head), so the previous lemma still
    ###                                    applies to its output.
    ### The bucket=0 case then follows by unfolding insertDPrList into a chain
    ### through insertNAt and applying the second helper at w = countWraps...

    # Helper 1: a dlls whose head bucket starts with v is always `in`-findable
    # at bucket 0, regardless of rv (case-split on rv).
    define in_head_v_true :=
        (forall rv lh lsts1 tail_dlls o_dlls v .
            (in zero rv (dlst lh (lst v lsts1) tail_dlls) o_dlls v))
    datatype-cases in_head_v_true {
        zero =>
            pick-any lh:Location lsts1:(Lst 'S) tail_dlls:(DLst (Lst 'S))
                     o_dlls:(DLst (Lst 'S)) v:'S
                let {
                    vv := (!reflex v);
                    or_form := (!either vv (Lst.in v lsts1));
                    head_in := (!chain-> [
                        or_form ==> (Lst.in v (lst v lsts1)) [Lst.In.in-lst-axiom]
                    ])
                }
                (!chain-> [
                    head_in
                    ==> (in zero zero (dlst lh (lst v lsts1) tail_dlls) o_dlls v) [in_axioms]
                ])
      | (S rv') =>
            pick-any lh:Location lsts1:(Lst 'S) tail_dlls:(DLst (Lst 'S))
                     o_dlls:(DLst (Lst 'S)) v:'S
                let {
                    vv := (!reflex v);
                    or_form := (!either vv (Lst.in v lsts1));
                    head_in := (!chain-> [
                        or_form ==> (Lst.in v (lst v lsts1)) [Lst.In.in-lst-axiom]
                    ])
                }
                # The (S rv)/dlst conditional axiom collapses to `<==> true`
                # under head_in; extract the in-form via propositional tautology.
                (!chain-> [
                    head_in
                    ==> ((in zero (S rv') (dlst lh (lst v lsts1) tail_dlls) o_dlls v)
                            <==> true)                                        [in_axioms]
                    ==> (in zero (S rv') (dlst lh (lst v lsts1) tail_dlls) o_dlls v)
                                                                              [prop-taut]
                ])
    }

    # Helper 2: applying insertNAt zero w v to a dlls whose head already starts
    # with v keeps the head starting with v, so `in zero rv` still finds v.
    # Case-split on w (the wrap count).
    define in_after_insertNAt_zero_with_v_head :=
        (forall w rv lh lsts1 tail_dlls o_dlls v .
            (in zero rv (insertNAt zero w v (dlst lh (lst v lsts1) tail_dlls)) o_dlls v))
    datatype-cases in_after_insertNAt_zero_with_v_head {
        zero =>
            pick-any rv lh lsts1 tail_dlls o_dlls v
                let {
                    unfold := (!chain [
                        (insertNAt zero zero v (dlst lh (lst v lsts1) tail_dlls))
                        = (dlst lh (lst v lsts1) tail_dlls) [insertNAt_axioms]
                    ]);
                    head_in := (!uspec* in_head_v_true [rv lh lsts1 tail_dlls o_dlls v])
                }
                (!chain<- [
                    (in zero rv (insertNAt zero zero v (dlst lh (lst v lsts1) tail_dlls)) o_dlls v)
                    <== (in zero rv (dlst lh (lst v lsts1) tail_dlls) o_dlls v) [unfold]
                    <== true [head_in]
                ])
      | (S w') =>
            pick-any rv lh lsts1 tail_dlls o_dlls v
                let {
                    unfold := (!chain [
                        (insertNAt zero (S w') v (dlst lh (lst v lsts1) tail_dlls))
                        = (dlst lh (lst v (lst v lsts1)) (insertNAt zero w' v tail_dlls))
                            [insertNAt_axioms]
                    ]);
                    head_in := (!uspec* in_head_v_true
                                       [rv lh (lst v lsts1) (insertNAt zero w' v tail_dlls)
                                        o_dlls v])
                }
                (!chain<- [
                    (in zero rv (insertNAt zero (S w') v (dlst lh (lst v lsts1) tail_dlls))
                                o_dlls v)
                    <== (in zero rv (dlst lh (lst v (lst v lsts1)) (insertNAt zero w' v tail_dlls))
                                    o_dlls v)                          [unfold]
                    <== true [head_in]
                ])
    }

    # Bucket=0 case: after insertDPrList at bucket 0 with any rv into a
    # non-empty dlls, `in zero rv` finds v at bucket 0.
    define in_after_insert_self_bucket_zero :=
        (forall rv lh lsts tail_dlls v .
            (in zero rv (insertDPrList zero rv v (dlst lh lsts tail_dlls))
                        (insertDPrList zero rv v (dlst lh lsts tail_dlls)) v))
    conclude in_after_insert_self_bucket_zero
        pick-any rv lh lsts tail_dlls v
            let {
                # Unfold insertDPrList zero rv v (dlst lh lsts tail_dlls) into the
                # form insertNAt zero (countWraps ...) v (dlst lh (lst v lsts) ...).
                mod_eq := (!chain [
                    (insertDPrList zero rv v (dlst lh lsts tail_dlls))
                    = (insertNAt zero (countWraps (bucketIndex zero (dlst lh lsts tail_dlls)
                                                                    (dlst lh lsts tail_dlls) zero)
                                                  (S rv) (dlst lh lsts tail_dlls)) v
                        (insertNAt (bucketIndex zero (dlst lh lsts tail_dlls)
                                                     (dlst lh lsts tail_dlls) zero)
                                   (S rv) v (dlst lh lsts tail_dlls)))           [insertDPrList_axioms]
                    = (insertNAt zero (countWraps zero (S rv) (dlst lh lsts tail_dlls)) v
                        (insertNAt zero (S rv) v (dlst lh lsts tail_dlls)))      [bucketIndex_axioms]
                    = (insertNAt zero (countWraps zero rv tail_dlls) v
                        (insertNAt zero (S rv) v (dlst lh lsts tail_dlls)))      [countWraps_axioms]
                    = (insertNAt zero (countWraps zero rv tail_dlls) v
                        (dlst lh (lst v lsts) (insertNAt zero rv v tail_dlls)))  [insertNAt_axioms]
                ]);
                # Instantiate helper 2 with w = countWraps zero rv tail_dlls,
                # lsts1 = lsts, tail_dlls = (insertNAt zero rv v tail_dlls),
                # o_dlls = the modified dlls itself.
                helper := (!uspec* in_after_insertNAt_zero_with_v_head
                                  [(countWraps zero rv tail_dlls)
                                   rv lh lsts (insertNAt zero rv v tail_dlls)
                                   (insertDPrList zero rv v (dlst lh lsts tail_dlls))
                                   v])
            }
            (!chain<- [
                (in zero rv (insertDPrList zero rv v (dlst lh lsts tail_dlls))
                            (insertDPrList zero rv v (dlst lh lsts tail_dlls)) v)
                <== (in zero rv
                            (insertNAt zero (countWraps zero rv tail_dlls) v
                                (dlst lh (lst v lsts) (insertNAt zero rv v tail_dlls)))
                            (insertDPrList zero rv v (dlst lh lsts tail_dlls)) v)   [mod_eq]
                <== true [helper]
            ])

    ### in_after_insert_self (any bucket index) and in_after_insert_other are
    ### proven at the end of this module, after `drop` and the location
    ### lemmas that their proofs use.


    ### available_key
    ### Purpose:
    ###     Determine whether the bucket at index `bucket`, or any of its next `rv` 
    ###     replica buckets, is hosted at an alive location.
    ###
    ### Parameters:
    ###     bucket::N              : primary bucket index to inspect.
    ###     rv::N                  : replication factor.
    ###     dlls::(DLst (Lst S))   : current suffix of the distributed list being traversed.
    ###     o_dlls::(DLst (Lst S)) : original distributed list, used for wrap-around when 
    ###                              the end of `dlls` is reached.
    ###
    ### Returns:
    ###     Boolean indicating whether the primary bucket or any of the next `rv` buckets
    ###     (modulo the list length) is at a location that is currently alive.
    declare available_key: (S) [N N (DLst (Lst S)) (DLst (Lst S))] -> Boolean
    ### SOUNDNESS NOTE on the clause patterns below — do not make them overlap.
    ###
    ### `fun` does not give its clauses first-match (priority) semantics: each
    ### clause is asserted as an independent, universally quantified
    ### biconditional. Two clauses whose patterns can be unified therefore equate
    ### the same atom with two different right-hand sides, which is a
    ### contradiction rather than a disambiguation.
    ###
    ### An earlier version of this definition opened with the catch-all
    ###     (available_key bucket rv dlls (dempty htl)) <==> false
    ### in which `dlls` was unrestricted. Instantiating `o_dlls` to `(dempty htl)`
    ### in the second clause equates the very same atom with `(Location.alive lh)`,
    ### so the two clauses jointly prove `(forall lh . ~ (Location.alive lh))` —
    ### every location is dead. Together with any asserted alive location (at
    ### the time, `Location.aliveLocal`) that makes the assumption base
    ### inconsistent, and it makes the hypothesis of
    ### `dht_replication_correctness` unsatisfiable (hence the theorem vacuous),
    ### since `no_consecutive_failures rv dlls dlls` requires an alive location in
    ### every window.
    ###
    ### The clauses below are pairwise NON-OVERLAPPING (they differ in the
    ### constructor of `bucket`, `rv`, `dlls` or `o_dlls`) and jointly exhaustive
    ### over the constructors of (N, N, DLst, DLst), so the definition is total,
    ### consistent, and terminating.
    assert available_key_axioms := (fun [
        # Both the walked suffix and the original list are exhausted: there is no
        # bucket anywhere, so nothing is available. This is the only clause with
        # an empty `o_dlls`, and it is what stops the wrap-around clause below
        # from looping forever.
        (available_key bucket rv (dempty htl0) (dempty htl)) <==> false
        (available_key zero zero (dlst lh lsts tail_dlls) o_dlls) <==> (Location.alive lh)
        (available_key zero (S rv) (dlst lh lsts tail_dlls) o_dlls) <==>
            [
                true
                    when (Location.alive lh)
                (available_key zero rv tail_dlls o_dlls)
                    when (~ Location.alive lh)
            ]
        (available_key (S bucket) rv (dlst lh lsts tail_dlls) o_dlls) <==>
            (available_key bucket rv tail_dlls o_dlls)
        # Wrap-around. The walked suffix `dlls` has run out while the original
        # list `o_dlls` is still non-empty, so restart the walk at the head of
        # `o_dlls` WITHOUT decrementing `bucket`/`rv`: the `dempty` terminus is
        # not a real bucket, so it must not consume a step of the window. Making
        # the `o_dlls` pattern explicitly `dlst` is what keeps this clause
        # disjoint from the first one. Termination holds because every wrap is
        # immediately followed by a real bucket, which does decrement
        # `bucket` + `rv`.
        (available_key bucket rv (dempty htl) (dlst olh olsts otail_dlls)) <==>
            (available_key bucket rv (dlst olh olsts otail_dlls)
                                     (dlst olh olsts otail_dlls))
    ])

    ### available_key invariance under insertion
    ###
    ### available_key only inspects head-locations (lh) and the dempty/dlst
    ### shape of its dlls inputs (cf. available_key_axioms above — lsts never
    ### appears on any RHS). Combined with insertDPrList_preserves_locs (step 1),
    ### this means insertDPrList cannot change which buckets are considered
    ### "available" for a given (bucket, rv) query, which is what query_aux
    ### branches on inside dhtable_mateo.ath.
    ###
    ### We factor the result through an intermediate lemma stating that
    ### available_key depends on its dlls / o_dlls arguments only through
    ### their dlls_locs. The corollary below is then a one-step instantiation.
    ###
    ### The intermediate is PROVEN below, by induction on the bucket index B
    ### and, for B = zero, on the replication counter R. For a fixed (B, R) the
    ### `dlst` case is proven first (ak-dlst); the method ak-close then derives
    ### the `dempty` cases from it, because the wrap-around clause reduces a
    ### `dempty` walk to a `dlst` walk at the same (B, R).

    ### same_locs: two bucket lists of the SAME element sort have the same
    ### location projection. Defined by a single biconditional (conservative).
    ### The proof below works with same_locs rather than with the equation
    ### (dlls_locs d1) = (dlls_locs d2), because dlls_locs forgets the element
    ### sort, and Athena then gives the two lists independent sort variables,
    ### which blocks modus ponens against single-sorted hypotheses.
    declare same_locs: (S) [(DLst (Lst S)) (DLst (Lst S))] -> Boolean
    assert* same_locs_def := ((same_locs dlls1 dlls2) <==> ((dlls_locs dlls1) = (dlls_locs dlls2)))

    ### locs_eq_cases (PROVEN): two bucket lists with the same location
    ### projection are both empty, or both non-empty with the same head
    ### location and tails that again have the same location projection.
    define locs_eq_cases :=
        (forall dlls1 dlls2 .
            (same_locs dlls1 dlls2) ==>
            ((exists htl htl0 . ((dlls1 = (dempty htl)) & (dlls2 = (dempty htl0))))
             | (exists lh lsts1 tail_dlls lsts2 tail_dlls2 .
                    ((dlls1 = (dlst lh lsts1 tail_dlls)) &
                     ((dlls2 = (dlst lh lsts2 tail_dlls2)) &
                      (same_locs tail_dlls tail_dlls2))))))
    conclude locs_eq_cases
      pick-any d1:(DLst (Lst 'S)) d2:(DLst (Lst 'S))
        assume hsl := (same_locs d1 d2)
          let {heq    := (!chain-> [hsl ==> ((dlls_locs d1) = (dlls_locs d2)) [same_locs_def]]);
               leftS  := (exists htl htl0 . ((d1 = (dempty htl)) & (d2 = (dempty htl0))));
               rightS := (exists lh lsts1 tail_dlls lsts2 tail_dlls2 .
                            ((d1 = (dlst lh lsts1 tail_dlls)) &
                             ((d2 = (dlst lh lsts2 tail_dlls2)) &
                              (same_locs tail_dlls tail_dlls2))));
               goal   := (leftS | rightS)}
          (!cases (!uspec DLst.dlst-no-junk d1)
            assume e1 := (exists ?x1:Location . d1 = (dempty ?x1))
              pick-witness h1 for e1 d1e
              (!cases (!uspec DLst.dlst-no-junk d2)
                assume e2 := (exists ?x1:Location . d2 = (dempty ?x1))
                  pick-witness h2 for e2 d2e
                    let {_ := (!both d1e d2e)}
                    (!either (!egen* leftS [h1 h2]) rightS)
                assume e2 := (exists ?x1:Location ?x2:(Lst 'S) ?x3:(DLst (Lst 'S)) .
                                d2 = (dlst ?x1 ?x2 ?x3))
                  pick-witnesses a2 s2 t2 for e2 d2e
                    let {c  := (!chain [(lst a2 (dlls_locs t2))
                                        = (dlls_locs (dlst a2 s2 t2))   [dlls_locs_axioms]
                                        = (dlls_locs d2)                [d2e]
                                        = (dlls_locs d1)                [heq]
                                        = (dlls_locs (dempty h1))       [d1e]
                                        = empty                         [dlls_locs_axioms]]);
                         nc := (!uspec* Lst.lst-no-conf-empty [a2 (dlls_locs t2)])}
                    (!from-complements goal (!sym c) nc))
            assume e1 := (exists ?x1:Location ?x2:(Lst 'S) ?x3:(DLst (Lst 'S)) .
                            d1 = (dlst ?x1 ?x2 ?x3))
              pick-witnesses a1 s1 t1 for e1 d1e
              (!cases (!uspec DLst.dlst-no-junk d2)
                assume e2 := (exists ?x1:Location . d2 = (dempty ?x1))
                  pick-witness h2 for e2 d2e
                    let {c  := (!chain [(lst a1 (dlls_locs t1))
                                        = (dlls_locs (dlst a1 s1 t1))   [dlls_locs_axioms]
                                        = (dlls_locs d1)                [d1e]
                                        = (dlls_locs d2)                [heq]
                                        = (dlls_locs (dempty h2))       [d2e]
                                        = empty                         [dlls_locs_axioms]]);
                         nc := (!uspec* Lst.lst-no-conf-empty [a1 (dlls_locs t1)])}
                    (!from-complements goal (!sym c) nc)
                assume e2 := (exists ?x1:Location ?x2:(Lst 'S) ?x3:(DLst (Lst 'S)) .
                                d2 = (dlst ?x1 ?x2 ?x3))
                  pick-witnesses a2 s2 t2 for e2 d2e
                    let {c   := (!chain [(lst a1 (dlls_locs t1))
                                         = (dlls_locs (dlst a1 s1 t1))  [dlls_locs_axioms]
                                         = (dlls_locs d1)               [d1e]
                                         = (dlls_locs d2)               [heq]
                                         = (dlls_locs (dlst a2 s2 t2))  [d2e]
                                         = (lst a2 (dlls_locs t2))      [dlls_locs_axioms]]);
                         inj := (!chain-> [c ==> ((a1 = a2) & ((dlls_locs t1) = (dlls_locs t2)))
                                                                        [Lst.lst-no-conf-lst]]);
                         aeq := (!left-and inj);
                         teq := (!chain-> [(!right-and inj) ==> (same_locs t1 t2) [same_locs_def]]);
                         d2' := (!chain [d2 = (dlst a2 s2 t2)           [d2e]
                                            = (dlst a1 s2 t2)           [aeq]]);
                         _   := (!both d1e (!both d2' teq))}
                    (!either leftS (!egen* rightS [a1 s1 t1 s2 t2]))))

    # (ak-inv B R): available_key at (B, R) sees its list arguments only
    # through their location projections. Curried, so that each hypothesis
    # is discharged by its own modus ponens.
    define (ak-inv B R) :=
        (forall dlls1 dlls2 . (same_locs dlls1 dlls2) ==>
           forall o_dlls1 o_dlls2 . (same_locs o_dlls1 o_dlls2) ==>
             ((available_key B R dlls1 o_dlls1) <==> (available_key B R dlls2 o_dlls2)))

    # (ak-dlst B R): the same statement restricted to non-empty walked lists
    # with the same head location.
    define (ak-dlst B R) :=
        (forall lh lsts1 tail_dlls lsts2 tail_dlls2 . (same_locs tail_dlls tail_dlls2) ==>
           forall o_dlls1 o_dlls2 . (same_locs o_dlls1 o_dlls2) ==>
             ((available_key B R (dlst lh lsts1 tail_dlls) o_dlls1)
              <==> (available_key B R (dlst lh lsts2 tail_dlls2) o_dlls2)))

    # ak-close: from (ak-dlst B R) in the assumption base, conclude (ak-inv B R).
    # Both walked lists are empty or both are dlst (locs_eq_cases). In the empty
    # case the original lists are both empty (false on both sides) or both dlst,
    # and then the wrap-around clause reduces both sides to the dlst case.
    define (ak-close B R dc) :=
      pick-any d1:(DLst (Lst 'S)) d2:(DLst (Lst 'S))
        assume deq := (same_locs d1 d2)
          pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
            assume oeq := (same_locs o1 o2)
              (!cases (!mp (!uspec* locs_eq_cases [d1 d2]) deq)
                assume demp := (exists htl htl0 . ((d1 = (dempty htl)) & (d2 = (dempty htl0))))
                  pick-witnesses h1 h2 for demp dw
                    let {d1e := (!left-and dw);
                         d2e := (!right-and dw)}
                    (!cases (!mp (!uspec* locs_eq_cases [o1 o2]) oeq)
                      assume oemp := (exists htl htl0 . ((o1 = (dempty htl)) & (o2 = (dempty htl0))))
                        pick-witnesses g1 g2 for oemp ow
                          let {o1e := (!left-and ow);
                               o2e := (!right-and ow);
                               f1  := (!chain [(available_key B R d1 o1)
                                               <==> (available_key B R (dempty h1) (dempty g1)) [d1e o1e]
                                               <==> false                                        [available_key_axioms]]);
                               f2  := (!chain [(available_key B R d2 o2)
                                               <==> (available_key B R (dempty h2) (dempty g2)) [d2e o2e]
                                               <==> false                                        [available_key_axioms]])}
                          (!chain [(available_key B R d1 o1)
                                   <==> false                    [f1]
                                   <==> (available_key B R d2 o2) [f2]])
                      assume ocons := (exists lh lsts1 tail_dlls lsts2 tail_dlls2 .
                                         ((o1 = (dlst lh lsts1 tail_dlls)) &
                                          ((o2 = (dlst lh lsts2 tail_dlls2)) &
                                           (same_locs tail_dlls tail_dlls2))))
                        pick-witnesses a s1 t1 s2 t2 for ocons ow
                          let {o1e  := (!left-and ow);
                               o2e  := (!left-and (!right-and ow));
                               teq  := (!right-and (!right-and ow));
                               step := (!mp (!uspec* (!mp (!uspec* dc [a s1 t1 s2 t2]) teq) [o1 o2]) oeq)}
                          (!chain [(available_key B R d1 o1)
                                   <==> (available_key B R (dempty h1) (dlst a s1 t1))       [d1e o1e]
                                   <==> (available_key B R (dlst a s1 t1) (dlst a s1 t1))    [available_key_axioms]
                                   <==> (available_key B R (dlst a s1 t1) o1)                [o1e]
                                   <==> (available_key B R (dlst a s2 t2) o2)                [step]
                                   <==> (available_key B R (dlst a s2 t2) (dlst a s2 t2))    [o2e]
                                   <==> (available_key B R (dempty h2) (dlst a s2 t2))       [available_key_axioms]
                                   <==> (available_key B R d2 o2)                            [d2e o2e]]))
                assume dcons := (exists lh lsts1 tail_dlls lsts2 tail_dlls2 .
                                   ((d1 = (dlst lh lsts1 tail_dlls)) &
                                    ((d2 = (dlst lh lsts2 tail_dlls2)) &
                                     (same_locs tail_dlls tail_dlls2))))
                  pick-witnesses a s1 t1 s2 t2 for dcons dw
                    let {d1e  := (!left-and dw);
                         d2e  := (!left-and (!right-and dw));
                         teq  := (!right-and (!right-and dw));
                         step := (!mp (!uspec* (!mp (!uspec* dc [a s1 t1 s2 t2]) teq) [o1 o2]) oeq)}
                    (!chain [(available_key B R d1 o1)
                             <==> (available_key B R (dlst a s1 t1) o1)   [d1e]
                             <==> (available_key B R (dlst a s2 t2) o2)   [step]
                             <==> (available_key B R d2 o2)               [d2e]]))

    define [akc-empty-empty akc-zero-zero akc-alive akc-dead akc-step akc-wrap] :=
           available_key_axioms

    define available_key_locs_inv_all := (forall B . (forall R . (ak-inv B R)))

    by-induction available_key_locs_inv_all {
      zero =>
        by-induction (forall R . (ak-inv zero R)) {
          zero =>
            let {dc := (ak-dlst zero zero);
                 _  := conclude dc
                         pick-any a:Location s1:(Lst 'S) t1:(DLst (Lst 'S))
                                  s2:(Lst 'S) t2:(DLst (Lst 'S))
                           assume (same_locs t1 t2)
                             pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
                               assume (same_locs o1 o2)
                                 (!chain [(available_key zero zero (dlst a s1 t1) o1)
                                          <==> (Location.alive a)                         [available_key_axioms]
                                          <==> (available_key zero zero (dlst a s2 t2) o2) [available_key_axioms]])}
            (!ak-close zero zero dc)
        | (S n) =>
            let {ih := (ak-inv zero n);
                 dc := (ak-dlst zero (S n));
                 _  := conclude dc
                         pick-any a:Location s1:(Lst 'S) t1:(DLst (Lst 'S))
                                  s2:(Lst 'S) t2:(DLst (Lst 'S))
                           assume ht := (same_locs t1 t2)
                             pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
                               assume ho := (same_locs o1 o2)
                                 let {ihi := (!mp (!uspec* (!mp (!uspec* ih [t1 t2]) ht) [o1 o2]) ho)}
                                 (!two-cases
                                   assume al := (Location.alive a)
                                     let {e1 := (!mp (!uspec* akc-alive [a n s1 t1 o1]) al);
                                          e2 := (!mp (!uspec* akc-alive [a n s2 t2 o2]) al)}
                                     (!chain [(available_key zero (S n) (dlst a s1 t1) o1)
                                              <==> true                                         [e1]
                                              <==> (available_key zero (S n) (dlst a s2 t2) o2) [e2]])
                                   assume dd := (~ Location.alive a)
                                     let {e1 := (!mp (!uspec* akc-dead [a n s1 t1 o1]) dd);
                                          e2 := (!mp (!uspec* akc-dead [a n s2 t2 o2]) dd)}
                                     (!chain [(available_key zero (S n) (dlst a s1 t1) o1)
                                              <==> (available_key zero n t1 o1)                 [e1]
                                              <==> (available_key zero n t2 o2)                 [ihi]
                                              <==> (available_key zero (S n) (dlst a s2 t2) o2) [e2]]))}
            (!ak-close zero (S n) dc)
        }
    | (S n) =>
        let {ih := (forall R . (ak-inv n R))}
        pick-any R0:N
          let {dc := (ak-dlst (S n) R0);
               _  := conclude dc
                       pick-any a:Location s1:(Lst 'S) t1:(DLst (Lst 'S))
                                s2:(Lst 'S) t2:(DLst (Lst 'S))
                         assume ht := (same_locs t1 t2)
                           pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
                             assume ho := (same_locs o1 o2)
                               let {ihi := (!mp (!uspec* (!mp (!uspec* ih [R0 t1 t2]) ht) [o1 o2]) ho)}
                               (!chain [(available_key (S n) R0 (dlst a s1 t1) o1)
                                        <==> (available_key n R0 t1 o1)                 [available_key_axioms]
                                        <==> (available_key n R0 t2 o2)                 [ihi]
                                        <==> (available_key (S n) R0 (dlst a s2 t2) o2) [available_key_axioms]])}
          (!ak-close (S n) R0 dc)
    }

    # Intermediate: available_key sees its dlls / o_dlls only through dlls_locs.
    define available_key_dlls_locs_inv :=
        (forall dlls1 dlls2 .
            (dlls_locs dlls1) = (dlls_locs dlls2) ==>
            forall o_dlls1 o_dlls2 .
                (dlls_locs o_dlls1) = (dlls_locs o_dlls2) ==>
                forall B R .
                    (available_key B R dlls1 o_dlls1) <==>
                    (available_key B R dlls2 o_dlls2))
    conclude available_key_dlls_locs_inv
      pick-any d1:(DLst (Lst 'S)) d2:(DLst (Lst 'S))
        assume h1 := ((dlls_locs d1) = (dlls_locs d2))
          pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
            assume h2 := ((dlls_locs o1) = (dlls_locs o2))
              let {sd := (!chain-> [h1 ==> (same_locs d1 d2) [same_locs_def]]);
                   so := (!chain-> [h2 ==> (same_locs o1 o2) [same_locs_def]])}
              pick-any B0:N R0:N
                (!mp (!uspec* (!mp (!uspec* available_key_locs_inv_all [B0 R0 d1 d2]) sd) [o1 o2]) so)

    # Corollary: available_key is invariant under insertDPrList when both
    # arguments are taken to be the same modified dlls (which is exactly the
    # shape that query_aux uses: `available_key (hf at v) rv dlls dlls`).
    define available_key_insert_invariant :=
        (forall bucket rv v dlls B R .
            (available_key B R (insertDPrList bucket rv v dlls) (insertDPrList bucket rv v dlls)) <==>
            (available_key B R dlls dlls))
    conclude available_key_insert_invariant
        pick-any bucket:N rv:N v:'S dlls:(DLst (Lst 'S)) B:N R:N
            let {
                locs_eq := (!uspec* insertDPrList_preserves_locs [bucket rv v dlls]);
                # locs_eq : (dlls_locs (insertDPrList bucket rv v dlls)) = (dlls_locs dlls)

                # Specialize the intermediate to dlls1 = insertDPrList(..), dlls2 = dlls,
                # discharge the first dlls-locs antecedent.
                step_dlls := (!mp
                                (!uspec* available_key_dlls_locs_inv
                                        [(insertDPrList bucket rv v dlls) dlls])
                                locs_eq);
                # step_dlls : forall o_dlls1 o_dlls2 . ... ==> forall B R . ...

                # Specialize o_dlls1 = insertDPrList(..), o_dlls2 = dlls, discharge.
                step_o := (!mp
                                (!uspec* step_dlls
                                        [(insertDPrList bucket rv v dlls) dlls])
                                locs_eq)
                # step_o : forall B R . available_key B R (insertDPrList..) (insertDPrList..) <==>
                #                       available_key B R dlls dlls
            }
            (!uspec* step_o [B R])


    ### no_consecutive_failures (replication invariant for the abstract)
    ###
    ### Captures the fault-tolerance hypothesis stated in the paper's
    ### abstract: for a DHT with replication value `rv`, every key remains
    ### available so long as no run of `(rv + 1)` consecutive bucket
    ### locations is entirely dead — equivalently, starting from EVERY
    ### bucket position the (rv + 1)-replica window contains at least one
    ### alive location.
    ###
    ### WHY `rv` IS NOT DECREMENTED IN THE RECURSIVE CALL.
    ###
    ### The second clause below passes `rv` unchanged to the recursive call,
    ### which reads at first like a missing countdown. It is not. There are two
    ### separate recursions here and they count different things:
    ###
    ###   * `available_key` walks ONE window. It is the recursion that consumes
    ###     `rv`: from a given position it inspects at most `rv + 1` buckets,
    ###     decrementing `rv` at each dead bucket and stopping as soon as it
    ###     finds a live one.
    ###   * `no_consecutive_failures` walks the STARTING POSITIONS. Its
    ###     recursion consumes the bucket list, not the window budget. For the
    ###     suffix `(dlst lh lsts tail_dlls)` it demands a live window opening at
    ###     that suffix's head, then re-opens a window of the SAME size at the
    ###     next position. `rv` is a fixed parameter of the whole predicate —
    ###     the window width — so decrementing it here would shrink the window
    ###     as the walk advances, which is exactly what we do not want.
    ###
    ### So the predicate is the conjunction, over every bucket index i, of
    ### "the window [i, i+rv] contains an alive location", where the windows
    ### wrap because `available_key` restarts at the head of `o_dlls` when the
    ### suffix runs out. That conjunction says precisely: no run of `rv + 1`
    ### consecutive bucket locations is entirely dead.
    ###
    ### HOW THE "NO CONSECUTIVE FAILURES" CONDITION IS ENSURED.
    ###
    ### It is not ensured by the predicate — the predicate only states it. It is
    ### a HYPOTHESIS discharged outside the formalism, by the deployment: a
    ### placement in which no `rv + 1` adjacent replicas share a failure domain.
    ### The theorems that consume it (`DHTable.dht_replication_correctness`)
    ### take it as an antecedent and conclude availability, which is the
    ### conditional guarantee the paper claims.
    ###
    ### Because the predicate is only ever an antecedent, it is worth knowing
    ### that it is neither unsatisfiable nor trivial. `test/dlls_ncf_examples.ath`
    ### checks three concrete instances on a three-bucket ring:
    ###   L U L with rv = 1  holds;  U U L with rv = 1  fails;
    ###   U U L with rv = 2  holds.
    ### The first shows the hypothesis of `dht_replication_correctness` is
    ### satisfiable (so the theorem is not vacuous), the second shows the
    ### predicate is refutable (so it is not trivially true), and the pair of
    ### the last two shows it is monotone in `rv` in the direction the paper
    ### claims: raising the replication value tolerates longer failure runs.
    ###
    ### Parameters:
    ###     rv::N                  : replication value (window size = rv + 1).
    ###     dlls::(DLst (Lst S))   : suffix whose head is the next starting
    ###                              position to check.
    ###     o_dlls::(DLst (Lst S)) : original list, used for wrap-around
    ###                              inside `available_key`.
    declare no_consecutive_failures: (S) [N (DLst (Lst S)) (DLst (Lst S))] -> Boolean
    assert no_consecutive_failures_axioms := (fun [
        (no_consecutive_failures rv (dempty htl) o_dlls) <==> true
        (no_consecutive_failures rv (dlst lh lsts tail_dlls) o_dlls) <==>
            ((available_key zero rv (dlst lh lsts tail_dlls) o_dlls) &
             (no_consecutive_failures rv tail_dlls o_dlls))
    ])

    ### ncf_key_available_gen (PROVEN)
    ###
    ### "Every starting position is covered" implies "this starting position is
    ### covered". This is the lookup step that turns the global replication
    ### invariant into the per-key precondition `available` demands, and it is
    ### what `DHTable.no_consecutive_failures_implies_key_available` is built on.
    ###
    ### The original list is written out as `(dlst olh olsts otail_dlls)` rather
    ### than carried as a variable with a side condition. That is not cosmetic:
    ### the statement is FALSE for an empty original list, since
    ### `available_key` is false there while `no_consecutive_failures` is
    ### vacuously true, and naming the `dlst` shape in the statement is what rules
    ### that case out. Note also that a hypothesis of the form
    ### `(~ (dlls = (dempty htl)))` would NOT do the job: it only says `dlls`
    ### differs from the empty list AT ONE PARTICULAR LOCATION, and
    ### `(dempty htl2)` for some other `htl2` still satisfies it.
    ###
    ### The proof is an induction on the bucket index `n`, with a case split on
    ### the walked list at each step. The wrap-around case is the interesting one:
    ### wrapping leaves `n` untouched, so it cannot appeal to the induction
    ### hypothesis on its own. It takes one further step over the head of the
    ### original list, and that step is what decrements `n`.
    define ncf_key_available_gen :=
        (forall n dlls rv olh olsts otail_dlls .
            ((no_consecutive_failures rv dlls (dlst olh olsts otail_dlls)) &
             (no_consecutive_failures rv (dlst olh olsts otail_dlls)
                                         (dlst olh olsts otail_dlls)))
            ==> (available_key n rv dlls (dlst olh olsts otail_dlls)))

    define [ak-empty-empty ak-zero-zero ak-alive ak-dead ak-step ak-wrap] :=
           available_key_axioms
    define [ncf-empty ncf-step] := no_consecutive_failures_axioms

    ### ncf_from_all_windows (PROVEN)
    ###
    ### The converse of `ncf_key_available_gen`: if the window opening at every
    ### bucket index is available, then the replication invariant holds. Together
    ### the two give a characterization of `no_consecutive_failures` that is much
    ### easier to transport across an insertion than the recursive definition is,
    ### because it mentions the bucket list only through `available_key`.
    ###
    ### The induction is structural on the walked list, and needs no side
    ### condition: the empty list satisfies the invariant vacuously, and at a
    ### `dlst` the window at index zero is the first conjunct while the windows
    ### at every higher index are exactly the tail's windows.
    define ncf_from_all_windows :=
        (forall dlls o_dlls rv .
            (forall n . (available_key n rv dlls o_dlls))
            ==> (no_consecutive_failures rv dlls o_dlls))

    by-induction ncf_from_all_windows {
        (dempty htl:Location) =>
            pick-any o_dlls:(DLst (Lst 'S)) rv:N
            assume all := (forall n . (available_key n rv (dempty htl) o_dlls))
                let { e := (!uspec* ncf-empty [rv htl o_dlls]) }
                (!mp (!right-iff e) (!true-intro))
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { IH := (forall o_dlls rv .
                          (forall n . (available_key n rv tail_dlls o_dlls))
                          ==> (no_consecutive_failures rv tail_dlls o_dlls)) }
            pick-any o_dlls:(DLst (Lst 'S)) rv:N
            assume all := (forall n . (available_key n rv (dlst lh lsts tail_dlls) o_dlls))
                let {
                    # index zero gives the window at this suffix's own head
                    win := (!uspec all zero);
                    # index (S n) on this suffix is index n on the tail
                    tailall :=
                        pick-any n:N
                            let { st := (!uspec* ak-step
                                            [lh rv lsts tail_dlls n o_dlls]) }
                            (!mp (!left-iff st) (!uspec all (S n)));
                    ihx := (!mp (!uspec* IH [o_dlls rv]) tailall);
                    unf := (!uspec* ncf-step [lh rv lsts tail_dlls o_dlls])
                }
                (!mp (!right-iff unf) (!both win ihx))
    }

    by-induction ncf_key_available_gen {
        zero =>
          datatype-cases
            (forall dlls rv olh olsts otail_dlls .
                ((no_consecutive_failures rv dlls (dlst olh olsts otail_dlls)) &
                 (no_consecutive_failures rv (dlst olh olsts otail_dlls)
                                             (dlst olh olsts otail_dlls)))
                ==> (available_key zero rv dlls (dlst olh olsts otail_dlls))) {
            (dempty htl:Location) =>
              pick-any rv:N olh:Location olsts:(Lst 'S) otail_dlls:(DLst (Lst 'S))
              assume hyp :=
                ((no_consecutive_failures rv (dempty htl) (dlst olh olsts otail_dlls)) &
                 (no_consecutive_failures rv (dlst olh olsts otail_dlls)
                                             (dlst olh olsts otail_dlls)))
                let {
                    # The walked list is exhausted, so the window opens at the
                    # head of the original list. That window is the first
                    # conjunct the invariant gives for the original list itself.
                    h2   := (!right-and hyp);
                    unf  := (!uspec* ncf-step
                                [olh rv olsts otail_dlls (dlst olh olsts otail_dlls)]);
                    conj := (!mp (!left-iff unf) h2);
                    win  := (!left-and conj);
                    wrap := (!uspec* ak-wrap [rv htl olh olsts otail_dlls zero])
                }
                (!mp (!right-iff wrap) win)
          | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
              pick-any rv:N olh:Location olsts:(Lst 'S) otail_dlls:(DLst (Lst 'S))
              assume hyp :=
                ((no_consecutive_failures rv (dlst lh lsts tail_dlls)
                                             (dlst olh olsts otail_dlls)) &
                 (no_consecutive_failures rv (dlst olh olsts otail_dlls)
                                             (dlst olh olsts otail_dlls)))
                let {
                    # Bucket index zero: the window we need is exactly the first
                    # conjunct of the invariant at this suffix.
                    h1   := (!left-and hyp);
                    unf  := (!uspec* ncf-step
                                [lh rv lsts tail_dlls (dlst olh olsts otail_dlls)]);
                    conj := (!mp (!left-iff unf) h1)
                }
                (!left-and conj)
          }
      | (S n) =>
          let {
            IH := (forall dlls rv olh olsts otail_dlls .
                    ((no_consecutive_failures rv dlls (dlst olh olsts otail_dlls)) &
                     (no_consecutive_failures rv (dlst olh olsts otail_dlls)
                                                 (dlst olh olsts otail_dlls)))
                    ==> (available_key n rv dlls (dlst olh olsts otail_dlls)))
          }
          datatype-cases
            (forall dlls rv olh olsts otail_dlls .
                ((no_consecutive_failures rv dlls (dlst olh olsts otail_dlls)) &
                 (no_consecutive_failures rv (dlst olh olsts otail_dlls)
                                             (dlst olh olsts otail_dlls)))
                ==> (available_key (S n) rv dlls (dlst olh olsts otail_dlls))) {
            (dempty htl:Location) =>
              pick-any rv:N olh:Location olsts:(Lst 'S) otail_dlls:(DLst (Lst 'S))
              assume hyp :=
                ((no_consecutive_failures rv (dempty htl) (dlst olh olsts otail_dlls)) &
                 (no_consecutive_failures rv (dlst olh olsts otail_dlls)
                                             (dlst olh olsts otail_dlls)))
                let {
                    h2   := (!right-and hyp);
                    # Peel the invariant on the original list to get it on the tail.
                    unf  := (!uspec* ncf-step
                                [olh rv olsts otail_dlls (dlst olh olsts otail_dlls)]);
                    conj := (!mp (!left-iff unf) h2);
                    tl   := (!right-and conj);
                    # IH at the tail, one bucket further along.
                    ihx  := (!mp (!uspec* IH [otail_dlls rv olh olsts otail_dlls])
                                 (!both tl h2));
                    # Wrap first (index untouched), then take one real bucket
                    # step, which is what turns (S n) into n.
                    step := (!uspec* ak-step [olh rv olsts otail_dlls n
                                              (dlst olh olsts otail_dlls)]);
                    mid  := (!mp (!right-iff step) ihx);
                    wrap := (!uspec* ak-wrap [rv htl olh olsts otail_dlls (S n)])
                }
                (!mp (!right-iff wrap) mid)
          | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
              pick-any rv:N olh:Location olsts:(Lst 'S) otail_dlls:(DLst (Lst 'S))
              assume hyp :=
                ((no_consecutive_failures rv (dlst lh lsts tail_dlls)
                                             (dlst olh olsts otail_dlls)) &
                 (no_consecutive_failures rv (dlst olh olsts otail_dlls)
                                             (dlst olh olsts otail_dlls)))
                let {
                    h1   := (!left-and hyp);
                    h2   := (!right-and hyp);
                    unf  := (!uspec* ncf-step
                                [lh rv lsts tail_dlls (dlst olh olsts otail_dlls)]);
                    conj := (!mp (!left-iff unf) h1);
                    tl   := (!right-and conj);
                    ihx  := (!mp (!uspec* IH [tail_dlls rv olh olsts otail_dlls])
                                 (!both tl h2));
                    step := (!uspec* ak-step [lh rv lsts tail_dlls n
                                              (dlst olh olsts otail_dlls)])
                }
                (!mp (!right-iff step) ihx)
          }
    }

    ### ncf_insert_inv (PROVEN)
    ###
    ### The replication invariant is unaffected by an insertion. This is what
    ### `DHTable.dht_replication_correctness` needs in order to run its induction
    ### backwards, from the bucket list after an insert to the one before it.
    ###
    ### The recursive definition of `no_consecutive_failures` is awkward to
    ### transport across `insertDPrList`, because `insertDPrList` is not defined
    ### by structural recursion on the bucket list (it composes `insertNAt` with
    ### `countWraps`). The two lemmas above avoid that entirely: they replace the
    ### recursion by the equivalent statement "the window at every bucket index is
    ### available", which mentions the bucket list only through `available_key`,
    ### and `available_key_insert_invariant` already says insertion does not
    ### change that. Insertion only ever prepends values into buckets, so it
    ### touches no location, which is the reason the whole thing goes through.
    define ncf_insert_inv :=
        (forall n rv v0 dlls .
            (no_consecutive_failures rv
                (insertDPrList n rv v0 dlls)
                (insertDPrList n rv v0 dlls))
            <==>
            (no_consecutive_failures rv dlls dlls))

    conclude ncf_insert_inv
        pick-any n:N rv:N v0:'S dlls:(DLst (Lst 'S))
        (!cases (!uspec dlst-no-junk dlls)
            # Empty bucket list: the insertion is a no-op, so the two sides are
            # the same sentence.
            assume is_empty := (exists htl . dlls = (dempty htl))
                pick-witness wh for is_empty wh_eq
                let {
                    collapse := (!chain [
                        (insertDPrList n rv v0 dlls)
                        = (insertDPrList n rv v0 (dempty wh)) [wh_eq]
                        = (dempty wh)                         [insert_into_empty_dlls]
                        = dlls                                [wh_eq] ])
                }
                (!chain [
                    (no_consecutive_failures rv (insertDPrList n rv v0 dlls)
                                                (insertDPrList n rv v0 dlls))
                    <==> (no_consecutive_failures rv dlls dlls) [collapse] ])
            # Non-empty bucket list: go through the every-window characterization.
            assume is_dlst := (exists lh lsts tail_dlls . dlls = (dlst lh lsts tail_dlls))
                pick-witnesses dlh dlsts dtl for is_dlst dlls_char
                let {
                    # The insertion leaves the locations alone, so the result is
                    # still a non-empty bucket list.
                    locs_eq   := (!uspec* insertDPrList_preserves_locs [n rv v0 dlls]);
                    locs_dlst := (!chain [
                        (dlls_locs (insertDPrList n rv v0 dlls))
                        = (dlls_locs dlls)                 [locs_eq]
                        = (dlls_locs (dlst dlh dlsts dtl)) [dlls_char]
                        = (lst dlh (dlls_locs dtl))        [dlls_locs_axioms] ]);
                    ins_dlst  := (!mp (!uspec* locs_lst_implies_dlst
                                        [(insertDPrList n rv v0 dlls)
                                         dlh (dlls_locs dtl)])
                                      locs_dlst)
                }
                pick-witnesses ilh ilsts itl for ins_dlst ins_char
                let {
                    fwd :=
                      assume h := (no_consecutive_failures rv
                                      (insertDPrList n rv v0 dlls)
                                      (insertDPrList n rv v0 dlls))
                        let {
                            h_dlst := (!chain-> [ h
                                ==> (no_consecutive_failures rv (dlst ilh ilsts itl)
                                                                (dlst ilh ilsts itl))
                                    [ins_char] ]);
                            allw :=
                              pick-any m:N
                                let {
                                    g   := (!mp (!uspec* ncf_key_available_gen
                                                  [m (dlst ilh ilsts itl) rv
                                                   ilh ilsts itl])
                                                (!both h_dlst h_dlst));
                                    gi  := (!chain-> [ g
                                             ==> (available_key m rv
                                                    (insertDPrList n rv v0 dlls)
                                                    (insertDPrList n rv v0 dlls))
                                                 [ins_char] ]);
                                    inv := (!uspec* available_key_insert_invariant
                                                [n rv v0 dlls m rv])
                                }
                                (!mp (!left-iff inv) gi)
                        }
                        (!mp (!uspec* ncf_from_all_windows [dlls dlls rv]) allw);
                    bwd :=
                      assume h := (no_consecutive_failures rv dlls dlls)
                        let {
                            h_dlst := (!chain-> [ h
                                ==> (no_consecutive_failures rv (dlst dlh dlsts dtl)
                                                                (dlst dlh dlsts dtl))
                                    [dlls_char] ]);
                            allw :=
                              pick-any m:N
                                let {
                                    g   := (!mp (!uspec* ncf_key_available_gen
                                                  [m (dlst dlh dlsts dtl) rv
                                                   dlh dlsts dtl])
                                                (!both h_dlst h_dlst));
                                    gd  := (!chain-> [ g
                                             ==> (available_key m rv dlls dlls)
                                                 [dlls_char] ]);
                                    inv := (!uspec* available_key_insert_invariant
                                                [n rv v0 dlls m rv])
                                }
                                (!mp (!right-iff inv) gd)
                        }
                        (!mp (!uspec* ncf_from_all_windows
                                [(insertDPrList n rv v0 dlls)
                                 (insertDPrList n rv v0 dlls) rv])
                             allw)
                }
                (!equiv fwd bwd))


    ### dlls_end
    ### Purpose:
    ###     Location of the `dempty` node that ends a bucket list. For the bucket
    ###     list of a DHT this is the table location `htl`: `initDPrList` puts it
    ###     there and insertion never changes it (lemmas below). It is the
    ###     location that decides whether `values` can complete.
    declare dlls_end : (S) [(DLst (Lst S))] -> Location
    assert dlls_end_axioms := (fun [
        (dlls_end (dempty htl)) = htl
        (dlls_end (dlst lh lsts tail_dlls)) = (dlls_end tail_dlls)
    ])

    # An initialized bucket list ends at the location it was given (PROVEN).
    define initDPrList_end :=
        (forall ll f htl . (dlls_end (initDPrList f htl ll)) = htl)
    by-induction initDPrList_end {
        (ll as empty) =>
            pick-any f:(fn 'S N) htl:Location
                (!chain [ (dlls_end (initDPrList f htl empty))
                        = (dlls_end (dempty htl))                          [initDPrList_axioms]
                        = htl                                              [dlls_end_axioms] ])
      | (ll as (lst l tail_l)) =>
            let { ih := (forall f htl . (dlls_end (initDPrList f htl tail_l)) = htl) }
            pick-any f:(fn 'S N) htl:Location
                (!chain [ (dlls_end (initDPrList f htl (lst l tail_l)))
                        = (dlls_end (dlst l empty (initDPrList f htl tail_l)))  [initDPrList_axioms]
                        = (dlls_end (initDPrList f htl tail_l))                 [dlls_end_axioms]
                        = htl                                                   [ih] ])
    }

    # insertNAt rewrites bucket contents only, so the end location is
    # unchanged (PROVEN, same case analysis as insertNAt_preserves_locs).
    define insertNAt_preserves_end :=
        (forall dlls bucket n v .
            (dlls_end (insertNAt bucket n v dlls)) = (dlls_end dlls))
    by-induction insertNAt_preserves_end {
        (dempty htl) =>
            pick-any bucket:N n:N v:'S
            datatype-cases
                ((dlls_end (insertNAt bucket n v (dempty htl))) = (dlls_end (dempty htl)))
                on n
            {
                zero =>
                    (!chain [ (dlls_end (insertNAt bucket zero v (dempty htl)))
                            = (dlls_end (dempty htl))                      [insertNAt_axioms] ])
              | (S n') =>
                    (!chain [ (dlls_end (insertNAt bucket (S n') v (dempty htl)))
                            = (dlls_end (dempty htl))                      [insertNAt_axioms] ])
            }
      | (dlst lh lsts tail_dlls) =>
            let { IH := (forall bucket n v .
                            (dlls_end (insertNAt bucket n v tail_dlls)) = (dlls_end tail_dlls)) }
            pick-any bucket:N n:N v:'S
            datatype-cases
                ((dlls_end (insertNAt bucket n v (dlst lh lsts tail_dlls))) =
                 (dlls_end (dlst lh lsts tail_dlls)))
                on n
            {
                zero =>
                    (!chain [ (dlls_end (insertNAt bucket zero v (dlst lh lsts tail_dlls)))
                            = (dlls_end (dlst lh lsts tail_dlls))          [insertNAt_axioms] ])
              | (S n') =>
                    datatype-cases
                        ((dlls_end (insertNAt bucket (S n') v (dlst lh lsts tail_dlls))) =
                         (dlls_end (dlst lh lsts tail_dlls)))
                        on bucket
                    {
                        zero =>
                            let { ih := (!uspec* IH [zero n' v]) }
                            (!chain [
                                (dlls_end (insertNAt zero (S n') v (dlst lh lsts tail_dlls)))
                                = (dlls_end (dlst lh (lst v lsts)
                                                (insertNAt zero n' v tail_dlls)))   [insertNAt_axioms]
                                = (dlls_end (insertNAt zero n' v tail_dlls))        [dlls_end_axioms]
                                = (dlls_end tail_dlls)                              [ih]
                                = (dlls_end (dlst lh lsts tail_dlls))               [dlls_end_axioms]
                            ])
                      | (S bucket') =>
                            let { ih := (!uspec* IH [bucket' (S n') v]) }
                            (!chain [
                                (dlls_end (insertNAt (S bucket') (S n') v
                                                (dlst lh lsts tail_dlls)))
                                = (dlls_end (dlst lh lsts
                                                (insertNAt bucket' (S n') v tail_dlls))) [insertNAt_axioms]
                                = (dlls_end (insertNAt bucket' (S n') v tail_dlls))      [dlls_end_axioms]
                                = (dlls_end tail_dlls)                                   [ih]
                                = (dlls_end (dlst lh lsts tail_dlls))                    [dlls_end_axioms]
                            ])
                    }
            }
    }

    # Corollary: insertDPrList preserves the end location (PROVEN).
    define insertDPrList_preserves_end :=
        (forall bucket rv v dlls .
            (dlls_end (insertDPrList bucket rv v dlls)) = (dlls_end dlls))
    conclude insertDPrList_preserves_end
        pick-any bucket rv v dlls
            let {
                idx      := (bucketIndex bucket dlls dlls zero);
                inner_eq := (!uspec* insertNAt_preserves_end [dlls idx (S rv) v]);
                outer_eq := (!uspec* insertNAt_preserves_end
                                    [(insertNAt idx (S rv) v dlls)
                                     zero
                                     (countWraps idx (S rv) dlls)
                                     v])
            }
            (!chain [
                (dlls_end (insertDPrList bucket rv v dlls))
                = (dlls_end (insertNAt zero (countWraps idx (S rv) dlls) v
                                (insertNAt idx (S rv) v dlls)))              [insertDPrList_axioms]
                = (dlls_end (insertNAt idx (S rv) v dlls))                   [outer_eq]
                = (dlls_end dlls)                                             [inner_eq]
            ])

    ### values
    ### Purpose:
    ###     Compute the set of the values stored in the alive buckets of a
    ###     distributed list of buckets. A bucket at a location that is not alive
    ###     is skipped. The walk ends at the `dempty` node, whose location (the
    ###     table location `htl` for the bucket list of a DHT) is critical: when
    ###     it is not alive the result is NONE, whatever the buckets hold.
    ###
    ### Parameters:
    ###     dlls : a distributed list (DLst (Lst S)) whose nodes contain
    ###            locations and the list of stored values at each bucket.
    ###
    ### Returns:
    ###     Option (Set S), where:
    ###         * NONE  : if the location of the `dempty` node is not alive.
    ###         * SOME T: otherwise, T is the union of the value lists of all
    ###                   alive buckets.
    ###
    ### The definition is recursive, without an accumulator and without a
    ### liveness flag. The two guarded clauses for an alive head are disjoint,
    ### since (values tail_dlls) is either NONE or (SOME sets) for a unique sets.
    declare values : (S) [(DLst (Lst S))] -> (Option (Set.Set S))
    define [null insert \/] := [Set.null Set.insert Set.\/]
    assert values_axioms := (fun [
        (values (dempty htl)) = [
            NONE        when (~ Location.alive htl)
            (SOME null) when (Location.alive htl)
        ]
        (values (dlst lh lsts tail_dlls)) = [
            (values tail_dlls)
                when (~ Location.alive lh)
            (SOME ((l2s lsts) \/ sets))
                when ((Location.alive lh) & ((values tail_dlls) = (SOME sets)))
            NONE
                when ((Location.alive lh) & ((values tail_dlls) = NONE))
        ]
    ])

    # values is NONE when the end location is not alive (PROVEN).
    define values_end_dead :=
        (forall dlls . (~ Location.alive (dlls_end dlls)) ==> ((values dlls) = NONE))
    by-induction values_end_dead {
        (dempty htl:Location) =>
            assume hyp := (~ Location.alive (dlls_end (dempty htl)))
                let { nd := (!chain-> [hyp ==> (~ Location.alive htl)  [dlls_end_axioms]]) }
                (!chain [ (values (dempty htl)) = NONE                  [values_axioms] ])
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { ih := ((~ Location.alive (dlls_end tail_dlls)) ==> ((values tail_dlls) = NONE)) }
            assume hyp := (~ Location.alive (dlls_end (dlst lh lsts tail_dlls)))
                let { nd := (!chain-> [hyp ==> (~ Location.alive (dlls_end tail_dlls)) [dlls_end_axioms]]);
                      tn := (!mp ih nd) }
                (!two-cases
                    assume alv := (Location.alive lh)
                        let { _ := (!both alv tn) }
                        (!chain [ (values (dlst lh lsts tail_dlls)) = NONE   [values_axioms] ])
                    assume nalv := (~ Location.alive lh)
                        (!chain [ (values (dlst lh lsts tail_dlls))
                                = (values tail_dlls)                          [values_axioms]
                                = NONE                                        [tn] ]))
    }

    # values is SOME of a set when the end location is alive (PROVEN).
    define values_end_alive :=
        (forall dlls . (Location.alive (dlls_end dlls)) ==>
                       (exists sets . (values dlls) = (SOME sets)))
    by-induction values_end_alive {
        (dempty htl:Location) =>
            assume hyp := (Location.alive (dlls_end (dempty htl)))
                let { a := (!chain-> [hyp ==> (Location.alive htl)       [dlls_end_axioms]]);
                      e := (!chain [ (values (dempty htl)) = (SOME null)  [values_axioms] ]) }
                (!egen (exists sets . (values (dempty htl)) = (SOME sets)) null)
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { ih := ((Location.alive (dlls_end tail_dlls)) ==>
                         (exists sets . (values tail_dlls) = (SOME sets))) }
            assume hyp := (Location.alive (dlls_end (dlst lh lsts tail_dlls)))
                let { a  := (!chain-> [hyp ==> (Location.alive (dlls_end tail_dlls)) [dlls_end_axioms]]);
                      ts := (!mp ih a) }
                pick-witness t for ts tdef
                (!two-cases
                    assume alv := (Location.alive lh)
                        let { _ := (!both alv tdef);
                              e := (!chain [ (values (dlst lh lsts tail_dlls))
                                           = (SOME ((l2s lsts) \/ t))         [values_axioms] ]) }
                        (!egen (exists sets . (values (dlst lh lsts tail_dlls)) = (SOME sets))
                               ((l2s lsts) \/ t))
                    assume nalv := (~ Location.alive lh)
                        let { e := (!chain [ (values (dlst lh lsts tail_dlls))
                                           = (values tail_dlls)               [values_axioms]
                                           = (SOME t)                         [tdef] ]) }
                        (!egen (exists sets . (values (dlst lh lsts tail_dlls)) = (SOME sets)) t))
    }

    # A freshly initialized bucket list (all buckets empty) whose end location
    # is alive holds no values (PROVEN). Every alive bucket contributes
    # (l2s empty) = null, and null \/ null = null.
    define values_init :=
        (forall ll f htl . (Location.alive htl) ==>
                           ((values (initDPrList f htl ll)) = (SOME null)))
    by-induction values_init {
        (ll as empty) =>
            pick-any f:(fn 'S N) htl:Location
                assume alvh := (Location.alive htl)
                    (!chain [ (values (initDPrList f htl empty))
                            = (values (dempty htl))                      [initDPrList_axioms]
                            = (SOME null)                                [values_axioms] ])
      | (ll as (lst l tail_l)) =>
            let { ih := (forall f htl . (Location.alive htl) ==>
                                        ((values (initDPrList f htl tail_l)) = (SOME null))) }
            pick-any f:(fn 'S N) htl:Location
                assume alvh := (Location.alive htl)
                    let { ihi := (!mp (!uspec* ih [f htl]) alvh) }
                    (!two-cases
                        assume alv := (Location.alive l)
                            let { _ := (!both alv ihi) }
                            (!chain
                                [ (values (initDPrList f htl (lst l tail_l)))
                                = (values (dlst l empty (initDPrList f htl tail_l)))  [initDPrList_axioms]
                                = (SOME ((l2s empty) \/ null))                          [values_axioms]
                                = (SOME (null \/ null))                                 [Lst.toSet.toSet-empty-axiom]
                                = (SOME null)                                           [Set.union-def] ])
                        assume nalv := (~ Location.alive l)
                            (!chain
                                [ (values (initDPrList f htl (lst l tail_l)))
                                = (values (dlst l empty (initDPrList f htl tail_l)))  [initDPrList_axioms]
                                = (values (initDPrList f htl tail_l))                  [values_axioms]
                                = (SOME null)                                          [ihi] ]))
    }

    ### values_after_insert (PROVEN)
    ###
    ### Inserting v0 into dlls extends the value set returned by `values` by
    ### Set.insert v0, provided that at least one bucket in the insert's
    ### rv+1 window is alive (available_key), so v0 lands in an alive bucket.
    ### The premise `(values dlls) = (SOME s0)` names the pre-insert value set;
    ### it also says that the end location is alive.
    ###
    ### Proof structure. `hits bucket n dlls` says that some bucket at the
    ### positions [bucket, bucket + n) written by `insertNAt` is alive.
    ###   * Write side: `values_insertNAt` shows that insertNAt adds v0 to the
    ###     value set exactly when `hits` holds, and `hits_insertNAt` that
    ###     insertion does not change `hits` (it only reads locations).
    ###   * Read side: `ak_hits_insert` shows that the window accepted by
    ###     `available_key` contains an alive bucket among the two segments that
    ###     `insertDPrList` writes, the one starting at the reduced index and the
    ###     wrapped one at the front. It goes through `ak_hits` (bucket zero of a
    ###     suffix, by induction on rv) and `ak_hits_gen` (any bucket index, by
    ###     induction on it, following `bucketIndex` with the suffix function
    ###     `drop`).


    define [pos cnt] := [?pos:N ?cnt:N]
    define [setA setT] := [?setA:(Set.Set 'S) ?setT:(Set.Set 'S)]

    ### Two set identities, by extensionality.
    define union_insert_right :=
        (forall setA setT v . (setA \/ (insert v setT)) = (insert v (setA \/ setT)))
    conclude union_insert_right
        pick-any setA:(Set.Set 'S) setT:(Set.Set 'S) v:'S
            (!Set.set-identity-intro-direct
                pick-any x:'S
                    (!chain [ (Set.in x (setA \/ (insert v setT)))
                            <==> ((Set.in x setA) | (Set.in x (insert v setT)))   [Set.UC]
                            <==> ((Set.in x setA) | ((x = v) | (Set.in x setT)))  [Set.in-def]
                            <==> ((x = v) | ((Set.in x setA) | (Set.in x setT)))  [prop-taut]
                            <==> ((x = v) | (Set.in x (setA \/ setT)))            [Set.UC]
                            <==> (Set.in x (insert v (setA \/ setT)))             [Set.in-def] ]))

    define insert_idem :=
        (forall v setT . (insert v (insert v setT)) = (insert v setT))
    conclude insert_idem
        pick-any v:'S setT:(Set.Set 'S)
            (!Set.set-identity-intro-direct
                pick-any x:'S
                    (!chain [ (Set.in x (insert v (insert v setT)))
                            <==> ((x = v) | (Set.in x (insert v setT)))        [Set.in-def]
                            <==> ((x = v) | ((x = v) | (Set.in x setT)))       [Set.in-def]
                            <==> ((x = v) | (Set.in x setT))                   [prop-taut]
                            <==> (Set.in x (insert v setT))                    [Set.in-def] ]))

    ### hits: some bucket at positions [bucket, bucket + n) of dlls is alive.
    ### Same patterns as insertNAt, which writes exactly those positions.
    declare hits : (S) [N N (DLst (Lst S))] -> Boolean
    assert hits_axioms := (fun [
        (hits bucket zero dlls) <==> false
        (hits bucket (S n) (dempty htl)) <==> false
        (hits zero (S n) (dlst lh lsts tail_dlls)) <==>
            ((Location.alive lh) | (hits zero n tail_dlls))
        (hits (S bucket) (S n) (dlst lh lsts tail_dlls)) <==>
            (hits bucket (S n) tail_dlls)
    ])

    # hits is monotone in the number of positions (PROVEN).
    define hits_step :=
        (forall dlls n . (hits zero n dlls) ==> (hits zero (S n) dlls))
    by-induction hits_step {
        (dempty htl:Location) =>
            pick-any n:N
                let { nh := datatype-cases (~ hits zero n (dempty htl)) on n {
                          zero =>
                            (!by-contradiction (~ hits zero zero (dempty htl))
                                assume h := (hits zero zero (dempty htl))
                                    (!chain-> [h ==> false [hits_axioms]]))
                        | (S m') =>
                            (!by-contradiction (~ hits zero (S m') (dempty htl))
                                assume h := (hits zero (S m') (dempty htl))
                                    (!chain-> [h ==> false [hits_axioms]]))
                      } }
                assume h := (hits zero n (dempty htl))
                    (!from-complements (hits zero (S n) (dempty htl)) h nh)
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { ih := (forall n . (hits zero n tail_dlls) ==> (hits zero (S n) tail_dlls)) }
            pick-any n:N
                datatype-cases ((hits zero n (dlst lh lsts tail_dlls)) ==>
                                (hits zero (S n) (dlst lh lsts tail_dlls))) on n {
                    zero =>
                        assume h := (hits zero zero (dlst lh lsts tail_dlls))
                            let { _ := (!chain-> [h ==> false [hits_axioms]]) }
                            (!from-false (hits zero (S zero) (dlst lh lsts tail_dlls)))
                  | (S m') =>
                        assume h := (hits zero (S m') (dlst lh lsts tail_dlls))
                            (!chain-> [ h
                                ==> ((Location.alive lh) | (hits zero m' tail_dlls))     [hits_axioms]
                                ==> ((Location.alive lh) | (hits zero (S m') tail_dlls)) [ih]
                                ==> (hits zero (S (S m')) (dlst lh lsts tail_dlls))     [hits_axioms] ])
                }
    }

    # The wrapped part of a window is no longer than the window (PROVEN).
    define hits_countWraps :=
        (forall dlls n o_dlls .
            (hits zero (countWraps zero n dlls) o_dlls) ==> (hits zero n o_dlls))
    by-induction hits_countWraps {
        (dempty htl:Location) =>
            pick-any n:N o_dlls:(DLst (Lst 'S))
                datatype-cases ((hits zero (countWraps zero n (dempty htl)) o_dlls) ==>
                                (hits zero n o_dlls)) on n {
                    zero =>
                        assume h := (hits zero (countWraps zero zero (dempty htl)) o_dlls)
                            let { _ := (!chain-> [ h ==> (hits zero zero o_dlls) [countWraps_axioms]
                                                     ==> false                   [hits_axioms] ]) }
                            (!from-false (hits zero zero o_dlls))
                  | (S m') =>
                        assume h := (hits zero (countWraps zero (S m') (dempty htl)) o_dlls)
                            (!chain-> [ h ==> (hits zero (S m') o_dlls) [countWraps_axioms] ])
                }
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { ih := (forall n o_dlls .
                            (hits zero (countWraps zero n tail_dlls) o_dlls) ==> (hits zero n o_dlls)) }
            pick-any n:N o_dlls:(DLst (Lst 'S))
                datatype-cases ((hits zero (countWraps zero n (dlst lh lsts tail_dlls)) o_dlls) ==>
                                (hits zero n o_dlls)) on n {
                    zero =>
                        assume h := (hits zero (countWraps zero zero (dlst lh lsts tail_dlls)) o_dlls)
                            let { _ := (!chain-> [ h ==> (hits zero zero o_dlls) [countWraps_axioms]
                                                     ==> false                   [hits_axioms] ]) }
                            (!from-false (hits zero zero o_dlls))
                  | (S m') =>
                        assume h := (hits zero (countWraps zero (S m') (dlst lh lsts tail_dlls)) o_dlls)
                            (!chain-> [ h
                                ==> (hits zero (countWraps zero m' tail_dlls) o_dlls) [countWraps_axioms]
                                ==> (hits zero m' o_dlls)                             [ih]
                                ==> (hits zero (S m') o_dlls)                         [hits_step] ])
                }
    }

    # values on a bucket list with an alive head (PROVEN): the tail returns a
    # set, and the result is the union of the head bucket with it.
    define values_alive_head :=
        (forall lh lsts tail_dlls s0 .
            ((Location.alive lh) & ((values (dlst lh lsts tail_dlls)) = (SOME s0))) ==>
            (exists sets . ((values tail_dlls) = (SOME sets)) & (s0 = ((l2s lsts) \/ sets))))
    conclude values_alive_head
        pick-any lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S)) s0:(Set.Set 'S)
            assume hyp := ((Location.alive lh) & ((values (dlst lh lsts tail_dlls)) = (SOME s0)))
                let { alv := (!left-and hyp);
                      hv  := (!right-and hyp) }
                (!two-cases
                    assume ae := (Location.alive (dlls_end tail_dlls))
                        let { ex := (!mp (!uspec values_end_alive tail_dlls) ae) }
                        pick-witness t for ex tdef
                            let { _  := (!both alv tdef);
                                  e1 := (!chain [ (SOME s0)
                                                = (values (dlst lh lsts tail_dlls)) [hv]
                                                = (SOME ((l2s lsts) \/ t))          [values_axioms] ]);
                                  e2 := (!chain-> [ e1 ==> (s0 = ((l2s lsts) \/ t)) [(datatype-axioms "Option")] ]);
                                  c  := (!both tdef e2) }
                            (!egen (exists sets . ((values tail_dlls) = (SOME sets)) &
                                                  (s0 = ((l2s lsts) \/ sets)))
                                   t)
                    assume nae := (~ Location.alive (dlls_end tail_dlls))
                        let { tn := (!mp (!uspec values_end_dead tail_dlls) nae);
                              _  := (!both alv tn);
                              e0 := (!chain [ (values (dlst lh lsts tail_dlls)) = NONE [values_axioms] ]);
                              e1 := (!chain [ (SOME s0)
                                            = (values (dlst lh lsts tail_dlls)) [hv]
                                            = NONE                              [e0] ]);
                              e2 := (!sym e1);
                              nc := (!chain-> [ true ==> (~ NONE = (SOME s0)) [(datatype-axioms "Option")] ]) }
                        (!from-complements
                            (exists sets . ((values tail_dlls) = (SOME sets)) & (s0 = ((l2s lsts) \/ sets)))
                            e2 nc))

    define [bk1 bk2] := [?bk1:(Lst 'S) ?bk2:(Lst 'S)]
    define [Xd Yd] := [?Xd:(DLst (Lst 'S)) ?Yd:(DLst (Lst 'S))]

    ### insertNAt adds v to the value set exactly when it writes an alive
    ### bucket (PROVEN, by induction on the bucket list).
    define values_insertNAt :=
        (forall dlls bucket n v s0 .
            ((values dlls) = (SOME s0)) ==>
            (((hits bucket n dlls) ==> ((values (insertNAt bucket n v dlls)) = (SOME (insert v s0)))) &
             ((~ hits bucket n dlls) ==> ((values (insertNAt bucket n v dlls)) = (SOME s0)))))
    by-induction values_insertNAt {
        (dempty htl:Location) =>
            pick-any bucket:N n:N v:'S s0:(Set.Set 'S)
                assume hv := ((values (dempty htl)) = (SOME s0))
                    let { facts := datatype-cases ((~ hits bucket n (dempty htl)) &
                                                   ((insertNAt bucket n v (dempty htl)) = (dempty htl))) on n {
                              zero =>
                                (!both (!by-contradiction (~ hits bucket zero (dempty htl))
                                          assume h := (hits bucket zero (dempty htl))
                                              (!chain-> [h ==> false [hits_axioms]]))
                                       (!chain [(insertNAt bucket zero v (dempty htl)) = (dempty htl) [insertNAt_axioms]]))
                            | (S m') =>
                                (!both (!by-contradiction (~ hits bucket (S m') (dempty htl))
                                          assume h := (hits bucket (S m') (dempty htl))
                                              (!chain-> [h ==> false [hits_axioms]]))
                                       (!chain [(insertNAt bucket (S m') v (dempty htl)) = (dempty htl) [insertNAt_axioms]]))
                          };
                          nh  := (!left-and facts);
                          ins := (!right-and facts) }
                    (!both (assume h := (hits bucket n (dempty htl))
                              (!from-complements ((values (insertNAt bucket n v (dempty htl))) = (SOME (insert v s0)))
                                                 h nh))
                           (assume h2 := (~ hits bucket n (dempty htl))
                              (!chain [ (values (insertNAt bucket n v (dempty htl)))
                                      = (values (dempty htl))                    [ins]
                                      = (SOME s0)                                [hv] ])))
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { IH := (forall bucket n v s0 .
                            ((values tail_dlls) = (SOME s0)) ==>
                            (((hits bucket n tail_dlls) ==>
                              ((values (insertNAt bucket n v tail_dlls)) = (SOME (insert v s0)))) &
                             ((~ hits bucket n tail_dlls) ==>
                              ((values (insertNAt bucket n v tail_dlls)) = (SOME s0))))) }
            pick-any bucket:N n:N v:'S s0:(Set.Set 'S)
                assume hv := ((values (dlst lh lsts tail_dlls)) = (SOME s0))
                    datatype-cases
                        (((hits bucket n (dlst lh lsts tail_dlls)) ==>
                          ((values (insertNAt bucket n v (dlst lh lsts tail_dlls))) = (SOME (insert v s0)))) &
                         ((~ hits bucket n (dlst lh lsts tail_dlls)) ==>
                          ((values (insertNAt bucket n v (dlst lh lsts tail_dlls))) = (SOME s0))))
                    on n {
                        zero =>
                            let { nh := (!by-contradiction (~ hits bucket zero (dlst lh lsts tail_dlls))
                                           assume h := (hits bucket zero (dlst lh lsts tail_dlls))
                                               (!chain-> [h ==> false [hits_axioms]]));
                                  ins := (!chain [ (insertNAt bucket zero v (dlst lh lsts tail_dlls))
                                                 = (dlst lh lsts tail_dlls)    [insertNAt_axioms] ]) }
                            (!both (assume h := (hits bucket zero (dlst lh lsts tail_dlls))
                                      (!from-complements
                                          ((values (insertNAt bucket zero v (dlst lh lsts tail_dlls))) = (SOME (insert v s0)))
                                          h nh))
                                   (assume h2 := (~ hits bucket zero (dlst lh lsts tail_dlls))
                                      (!chain [ (values (insertNAt bucket zero v (dlst lh lsts tail_dlls)))
                                              = (values (dlst lh lsts tail_dlls))  [ins]
                                              = (SOME s0)                          [hv] ])))
                      | (S m') =>
                          datatype-cases
                            (((hits bucket (S m') (dlst lh lsts tail_dlls)) ==>
                              ((values (insertNAt bucket (S m') v (dlst lh lsts tail_dlls))) = (SOME (insert v s0)))) &
                             ((~ hits bucket (S m') (dlst lh lsts tail_dlls)) ==>
                              ((values (insertNAt bucket (S m') v (dlst lh lsts tail_dlls))) = (SOME s0))))
                          on bucket {
                            zero =>
                              let { xt   := (insertNAt zero m' v tail_dlls);
                                    insE := (!chain [ (insertNAt zero (S m') v (dlst lh lsts tail_dlls))
                                                    = (dlst lh (lst v lsts) xt)            [insertNAt_axioms] ]);
                                    hitsE := (!chain [ (hits zero (S m') (dlst lh lsts tail_dlls))
                                                     <==> ((Location.alive lh) | (hits zero m' tail_dlls)) [hits_axioms] ]) }
                              (!two-cases
                                assume alv := (Location.alive lh)
                                  let { ex := (!mp (!uspec* values_alive_head [lh lsts tail_dlls s0]) (!both alv hv)) }
                                  pick-witness t for ex tdef
                                    let { tv  := (!left-and tdef);
                                          s0e := (!sym (!right-and tdef));
                                          ih  := (!mp (!uspec* IH [zero m' v t]) tv);
                                          hz  := (!chain-> [ alv ==> ((Location.alive lh) | (hits zero m' tail_dlls)) [alternate]
                                                                 ==> (hits zero (S m') (dlst lh lsts tail_dlls)) [hitsE] ]);
                                          res := (!two-cases
                                                   assume hm := (hits zero m' tail_dlls)
                                                     let { xv := (!mp (!left-and ih) hm);
                                                           _  := (!both alv xv) }
                                                     (!chain [ (values (insertNAt zero (S m') v (dlst lh lsts tail_dlls)))
                                                             = (values (dlst lh (lst v lsts) xt))                [insE]
                                                             = (SOME ((l2s (lst v lsts)) \/ (insert v t)))        [values_axioms]
                                                             = (SOME ((insert v (l2s lsts)) \/ (insert v t)))     [Lst.toSet.toSet-lst-axiom]
                                                             = (SOME (insert v ((l2s lsts) \/ (insert v t))))     [Set.union-def]
                                                             = (SOME (insert v (insert v ((l2s lsts) \/ t))))     [union_insert_right]
                                                             = (SOME (insert v ((l2s lsts) \/ t)))                [insert_idem]
                                                             = (SOME (insert v s0))                               [s0e] ])
                                                   assume nhm := (~ hits zero m' tail_dlls)
                                                     let { xv := (!mp (!right-and ih) nhm);
                                                           _  := (!both alv xv) }
                                                     (!chain [ (values (insertNAt zero (S m') v (dlst lh lsts tail_dlls)))
                                                             = (values (dlst lh (lst v lsts) xt))                [insE]
                                                             = (SOME ((l2s (lst v lsts)) \/ t))                   [values_axioms]
                                                             = (SOME ((insert v (l2s lsts)) \/ t))                [Lst.toSet.toSet-lst-axiom]
                                                             = (SOME (insert v ((l2s lsts) \/ t)))                [Set.union-def]
                                                             = (SOME (insert v s0))                               [s0e] ])) }
                                    (!both (assume h := (hits zero (S m') (dlst lh lsts tail_dlls)) (!claim res))
                                           (assume nh := (~ hits zero (S m') (dlst lh lsts tail_dlls))
                                              (!from-complements
                                                  ((values (insertNAt zero (S m') v (dlst lh lsts tail_dlls))) = (SOME s0))
                                                  hz nh)))
                                assume nalv := (~ Location.alive lh)
                                  let { dv := (!chain [ (values (dlst lh lsts tail_dlls)) = (values tail_dlls) [values_axioms] ]);
                                        tv := (!chain [ (values tail_dlls) = (values (dlst lh lsts tail_dlls)) [dv]
                                                                           = (SOME s0)                         [hv] ]);
                                        ih := (!mp (!uspec* IH [zero m' v s0]) tv);
                                        xvE := (!chain [ (values (insertNAt zero (S m') v (dlst lh lsts tail_dlls)))
                                                       = (values (dlst lh (lst v lsts) xt))  [insE]
                                                       = (values xt)                         [values_axioms] ]) }
                                  (!both (assume h := (hits zero (S m') (dlst lh lsts tail_dlls))
                                            let { hm := (!dsyl (!chain-> [h ==> ((Location.alive lh) | (hits zero m' tail_dlls)) [hitsE]]) nalv);
                                                  xv := (!mp (!left-and ih) hm) }
                                            (!chain [ (values (insertNAt zero (S m') v (dlst lh lsts tail_dlls)))
                                                    = (values xt)              [xvE]
                                                    = (SOME (insert v s0))     [xv] ]))
                                         (assume nh := (~ hits zero (S m') (dlst lh lsts tail_dlls))
                                            let { nhm := (!by-contradiction (~ hits zero m' tail_dlls)
                                                            assume hm := (hits zero m' tail_dlls)
                                                              (!absurd (!chain-> [ hm ==> ((Location.alive lh) | (hits zero m' tail_dlls)) [alternate]
                                                                                      ==> (hits zero (S m') (dlst lh lsts tail_dlls)) [hitsE] ])
                                                                       nh));
                                                  xv := (!mp (!right-and ih) nhm) }
                                            (!chain [ (values (insertNAt zero (S m') v (dlst lh lsts tail_dlls)))
                                                    = (values xt)              [xvE]
                                                    = (SOME s0)                [xv] ]))))
                          | (S b') =>
                              let { xt   := (insertNAt b' (S m') v tail_dlls);
                                    insE := (!chain [ (insertNAt (S b') (S m') v (dlst lh lsts tail_dlls))
                                                    = (dlst lh lsts xt)                    [insertNAt_axioms] ]);
                                    hitsE := (!chain [ (hits (S b') (S m') (dlst lh lsts tail_dlls))
                                                     <==> (hits b' (S m') tail_dlls)        [hits_axioms] ]);
                                    fwd := assume h := (hits (S b') (S m') (dlst lh lsts tail_dlls))
                                             (!chain-> [h ==> (hits b' (S m') tail_dlls) [hitsE]]);
                                    bwd := assume nh := (~ hits (S b') (S m') (dlst lh lsts tail_dlls))
                                             (!by-contradiction (~ hits b' (S m') tail_dlls)
                                                assume hm := (hits b' (S m') tail_dlls)
                                                  (!absurd (!chain-> [hm ==> (hits (S b') (S m') (dlst lh lsts tail_dlls)) [hitsE]])
                                                           nh)) }
                              (!two-cases
                                assume alv := (Location.alive lh)
                                  let { ex := (!mp (!uspec* values_alive_head [lh lsts tail_dlls s0]) (!both alv hv)) }
                                  pick-witness t for ex tdef
                                    let { tv  := (!left-and tdef);
                                          s0e := (!sym (!right-and tdef));
                                          ih  := (!mp (!uspec* IH [b' (S m') v t]) tv) }
                                    (!both (assume h := (hits (S b') (S m') (dlst lh lsts tail_dlls))
                                              let { xv := (!mp (!left-and ih) (!mp fwd h));
                                                    _  := (!both alv xv) }
                                              (!chain [ (values (insertNAt (S b') (S m') v (dlst lh lsts tail_dlls)))
                                                      = (values (dlst lh lsts xt))                     [insE]
                                                      = (SOME ((l2s lsts) \/ (insert v t)))             [values_axioms]
                                                      = (SOME (insert v ((l2s lsts) \/ t)))             [union_insert_right]
                                                      = (SOME (insert v s0))                            [s0e] ]))
                                           (assume nh := (~ hits (S b') (S m') (dlst lh lsts tail_dlls))
                                              let { xv := (!mp (!right-and ih) (!mp bwd nh));
                                                    _  := (!both alv xv) }
                                              (!chain [ (values (insertNAt (S b') (S m') v (dlst lh lsts tail_dlls)))
                                                      = (values (dlst lh lsts xt))                     [insE]
                                                      = (SOME ((l2s lsts) \/ t))                        [values_axioms]
                                                      = (SOME s0)                                       [s0e] ])))
                                assume nalv := (~ Location.alive lh)
                                  let { dv := (!chain [ (values (dlst lh lsts tail_dlls)) = (values tail_dlls) [values_axioms] ]);
                                        tv := (!chain [ (values tail_dlls) = (values (dlst lh lsts tail_dlls)) [dv]
                                                                           = (SOME s0)                         [hv] ]);
                                        ih := (!mp (!uspec* IH [b' (S m') v s0]) tv);
                                        xvE := (!chain [ (values (insertNAt (S b') (S m') v (dlst lh lsts tail_dlls)))
                                                       = (values (dlst lh lsts xt))   [insE]
                                                       = (values xt)                  [values_axioms] ]) }
                                  (!both (assume h := (hits (S b') (S m') (dlst lh lsts tail_dlls))
                                            let { xv := (!mp (!left-and ih) (!mp fwd h)) }
                                            (!chain [ (values (insertNAt (S b') (S m') v (dlst lh lsts tail_dlls)))
                                                    = (values xt)              [xvE]
                                                    = (SOME (insert v s0))     [xv] ]))
                                         (assume nh := (~ hits (S b') (S m') (dlst lh lsts tail_dlls))
                                            let { xv := (!mp (!right-and ih) (!mp bwd nh)) }
                                            (!chain [ (values (insertNAt (S b') (S m') v (dlst lh lsts tail_dlls)))
                                                    = (values xt)              [xvE]
                                                    = (SOME s0)                [xv] ]))))
                          }
                    }
    }

    ### hits only reads the locations of a bucket list (PROVEN). Two bucket
    ### lists with the same head location and tails with the same hits agree.
    define hits_cons :=
        (forall lh bk1 bk2 Xd Yd .
            (forall bucket n . (hits bucket n Xd) <==> (hits bucket n Yd)) ==>
            (forall bucket n . (hits bucket n (dlst lh bk1 Xd)) <==> (hits bucket n (dlst lh bk2 Yd))))
    conclude hits_cons
        pick-any lh:Location bk1:(Lst 'S) bk2:(Lst 'S) Xd:(DLst (Lst 'S)) Yd:(DLst (Lst 'S))
            assume hyp := (forall bucket n . (hits bucket n Xd) <==> (hits bucket n Yd))
                pick-any bucket:N n:N
                    datatype-cases ((hits bucket n (dlst lh bk1 Xd)) <==> (hits bucket n (dlst lh bk2 Yd))) on n {
                        zero =>
                            (!chain [ (hits bucket zero (dlst lh bk1 Xd))
                                    <==> false                              [hits_axioms]
                                    <==> (hits bucket zero (dlst lh bk2 Yd)) [hits_axioms] ])
                      | (S m') =>
                            datatype-cases ((hits bucket (S m') (dlst lh bk1 Xd)) <==>
                                            (hits bucket (S m') (dlst lh bk2 Yd))) on bucket {
                                zero =>
                                    (!chain [ (hits zero (S m') (dlst lh bk1 Xd))
                                            <==> ((Location.alive lh) | (hits zero m' Xd)) [hits_axioms]
                                            <==> ((Location.alive lh) | (hits zero m' Yd)) [hyp]
                                            <==> (hits zero (S m') (dlst lh bk2 Yd))        [hits_axioms] ])
                              | (S b') =>
                                    (!chain [ (hits (S b') (S m') (dlst lh bk1 Xd))
                                            <==> (hits b' (S m') Xd)                    [hits_axioms]
                                            <==> (hits b' (S m') Yd)                    [hyp]
                                            <==> (hits (S b') (S m') (dlst lh bk2 Yd))   [hits_axioms] ])
                            }
                    }

    # insertNAt does not change hits (PROVEN, by induction on the bucket list).
    define hits_insertNAt :=
        (forall dlls bucket0 cnt v bucket n .
            (hits bucket n (insertNAt bucket0 cnt v dlls)) <==> (hits bucket n dlls))
    by-induction hits_insertNAt {
        (dempty htl:Location) =>
            pick-any bucket0:N cnt:N v:'S bucket:N n:N
                let { ins := datatype-cases ((insertNAt bucket0 cnt v (dempty htl)) = (dempty htl)) on cnt {
                              zero   => (!chain [(insertNAt bucket0 zero v (dempty htl)) = (dempty htl) [insertNAt_axioms]])
                            | (S k') => (!chain [(insertNAt bucket0 (S k') v (dempty htl)) = (dempty htl) [insertNAt_axioms]])
                          } }
                (!chain [ (hits bucket n (insertNAt bucket0 cnt v (dempty htl)))
                        <==> (hits bucket n (dempty htl))                     [ins] ])
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { IH := (forall bucket0 cnt v bucket n .
                            (hits bucket n (insertNAt bucket0 cnt v tail_dlls)) <==> (hits bucket n tail_dlls)) }
            pick-any bucket0:N cnt:N v:'S bucket:N n:N
                datatype-cases ((hits bucket n (insertNAt bucket0 cnt v (dlst lh lsts tail_dlls))) <==>
                                (hits bucket n (dlst lh lsts tail_dlls))) on cnt {
                    zero =>
                        (!chain [ (hits bucket n (insertNAt bucket0 zero v (dlst lh lsts tail_dlls)))
                                <==> (hits bucket n (dlst lh lsts tail_dlls))         [insertNAt_axioms] ])
                  | (S k') =>
                        datatype-cases ((hits bucket n (insertNAt bucket0 (S k') v (dlst lh lsts tail_dlls))) <==>
                                        (hits bucket n (dlst lh lsts tail_dlls))) on bucket0 {
                            zero =>
                                let { xt  := (insertNAt zero k' v tail_dlls);
                                      tl_eq := pick-any bucket:N n:N (!uspec* IH [zero k' v bucket n]);
                                      hl  := (!mp (!uspec* hits_cons [lh (lst v lsts) lsts xt tail_dlls]) tl_eq) }
                                (!chain [ (hits bucket n (insertNAt zero (S k') v (dlst lh lsts tail_dlls)))
                                        <==> (hits bucket n (dlst lh (lst v lsts) xt))   [insertNAt_axioms]
                                        <==> (hits bucket n (dlst lh lsts tail_dlls))    [hl] ])
                          | (S b0') =>
                                let { xt  := (insertNAt b0' (S k') v tail_dlls);
                                      tl_eq := pick-any bucket:N n:N (!uspec* IH [b0' (S k') v bucket n]);
                                      hl  := (!mp (!uspec* hits_cons [lh lsts lsts xt tail_dlls]) tl_eq) }
                                (!chain [ (hits bucket n (insertNAt (S b0') (S k') v (dlst lh lsts tail_dlls)))
                                        <==> (hits bucket n (dlst lh lsts xt))           [insertNAt_axioms]
                                        <==> (hits bucket n (dlst lh lsts tail_dlls))    [hl] ])
                        }
                }
    }

    ### drop: the suffix of a bucket list after pos buckets.
    declare drop : (S) [N (DLst (Lst S))] -> (DLst (Lst S))
    assert drop_axioms := (fun [
        (drop zero dlls) = dlls
        (drop (S pos) (dempty htl)) = (dempty htl)
        (drop (S pos) (dlst lh lsts tail_dlls)) = (drop pos tail_dlls)
    ])

    # hits at position pos is hits at position zero of the suffix (PROVEN).
    define hits_drop :=
        (forall dlls pos n . (hits pos n dlls) <==> (hits zero n (drop pos dlls)))
    by-induction hits_drop {
        (dempty htl:Location) =>
            pick-any pos:N n:N
                datatype-cases ((hits pos n (dempty htl)) <==> (hits zero n (drop pos (dempty htl)))) on pos {
                    zero =>
                        (!chain [ (hits zero n (dempty htl))
                                <==> (hits zero n (drop zero (dempty htl)))    [drop_axioms] ])
                  | (S p') =>
                        datatype-cases ((hits (S p') n (dempty htl)) <==>
                                        (hits zero n (drop (S p') (dempty htl)))) on n {
                            zero =>
                                (!chain [ (hits (S p') zero (dempty htl))
                                        <==> false                                    [hits_axioms]
                                        <==> (hits zero zero (dempty htl))            [hits_axioms]
                                        <==> (hits zero zero (drop (S p') (dempty htl))) [drop_axioms] ])
                          | (S m') =>
                                (!chain [ (hits (S p') (S m') (dempty htl))
                                        <==> false                                       [hits_axioms]
                                        <==> (hits zero (S m') (dempty htl))             [hits_axioms]
                                        <==> (hits zero (S m') (drop (S p') (dempty htl))) [drop_axioms] ])
                        }
                }
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { IH := (forall pos n . (hits pos n tail_dlls) <==> (hits zero n (drop pos tail_dlls))) }
            pick-any pos:N n:N
                datatype-cases ((hits pos n (dlst lh lsts tail_dlls)) <==>
                                (hits zero n (drop pos (dlst lh lsts tail_dlls)))) on pos {
                    zero =>
                        (!chain [ (hits zero n (dlst lh lsts tail_dlls))
                                <==> (hits zero n (drop zero (dlst lh lsts tail_dlls)))  [drop_axioms] ])
                  | (S p') =>
                        datatype-cases ((hits (S p') n (dlst lh lsts tail_dlls)) <==>
                                        (hits zero n (drop (S p') (dlst lh lsts tail_dlls)))) on n {
                            zero =>
                                (!chain [ (hits (S p') zero (dlst lh lsts tail_dlls))
                                        <==> false                                              [hits_axioms]
                                        <==> (hits zero zero (drop p' tail_dlls))               [hits_axioms]
                                        <==> (hits zero zero (drop (S p') (dlst lh lsts tail_dlls))) [drop_axioms] ])
                          | (S m') =>
                                (!chain [ (hits (S p') (S m') (dlst lh lsts tail_dlls))
                                        <==> (hits p' (S m') tail_dlls)                          [hits_axioms]
                                        <==> (hits zero (S m') (drop p' tail_dlls))              [IH]
                                        <==> (hits zero (S m') (drop (S p') (dlst lh lsts tail_dlls))) [drop_axioms] ])
                        }
                }
    }

    # countWraps at position pos is countWraps at position zero of the suffix (PROVEN).
    define countWraps_drop :=
        (forall dlls pos n . (countWraps pos n dlls) = (countWraps zero n (drop pos dlls)))
    by-induction countWraps_drop {
        (dempty htl:Location) =>
            pick-any pos:N n:N
                datatype-cases ((countWraps pos n (dempty htl)) = (countWraps zero n (drop pos (dempty htl)))) on pos {
                    zero =>
                        (!chain [ (countWraps zero n (dempty htl))
                                = (countWraps zero n (drop zero (dempty htl)))    [drop_axioms] ])
                  | (S p') =>
                        datatype-cases ((countWraps (S p') n (dempty htl)) =
                                        (countWraps zero n (drop (S p') (dempty htl)))) on n {
                            zero =>
                                (!chain [ (countWraps (S p') zero (dempty htl))
                                        = zero                                          [countWraps_axioms]
                                        = (countWraps zero zero (drop (S p') (dempty htl))) [countWraps_axioms] ])
                          | (S m') =>
                                (!chain [ (countWraps (S p') (S m') (dempty htl))
                                        = (S m')                                          [countWraps_axioms]
                                        = (countWraps zero (S m') (dempty htl))           [countWraps_axioms]
                                        = (countWraps zero (S m') (drop (S p') (dempty htl))) [drop_axioms] ])
                        }
                }
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { IH := (forall pos n . (countWraps pos n tail_dlls) = (countWraps zero n (drop pos tail_dlls))) }
            pick-any pos:N n:N
                datatype-cases ((countWraps pos n (dlst lh lsts tail_dlls)) =
                                (countWraps zero n (drop pos (dlst lh lsts tail_dlls)))) on pos {
                    zero =>
                        (!chain [ (countWraps zero n (dlst lh lsts tail_dlls))
                                = (countWraps zero n (drop zero (dlst lh lsts tail_dlls)))  [drop_axioms] ])
                  | (S p') =>
                        datatype-cases ((countWraps (S p') n (dlst lh lsts tail_dlls)) =
                                        (countWraps zero n (drop (S p') (dlst lh lsts tail_dlls)))) on n {
                            zero =>
                                (!chain [ (countWraps (S p') zero (dlst lh lsts tail_dlls))
                                        = zero                                                       [countWraps_axioms]
                                        = (countWraps zero zero (drop (S p') (dlst lh lsts tail_dlls))) [countWraps_axioms] ])
                          | (S m') =>
                                (!chain [ (countWraps (S p') (S m') (dlst lh lsts tail_dlls))
                                        = (countWraps p' (S m') tail_dlls)                           [countWraps_axioms]
                                        = (countWraps zero (S m') (drop p' tail_dlls))               [IH]
                                        = (countWraps zero (S m') (drop (S p') (dlst lh lsts tail_dlls))) [drop_axioms] ])
                        }
                }
    }

    # The suffix after a non-empty suffix is its tail (PROVEN).
    define drop_dempty :=
        (forall pos htl . (drop pos (dempty htl)) = (dempty htl))
    conclude drop_dempty
        pick-any pos:N htl:Location
            datatype-cases ((drop pos (dempty htl)) = (dempty htl)) on pos {
                zero   => (!chain [(drop zero (dempty htl)) = (dempty htl) [drop_axioms]])
              | (S p') => (!chain [(drop (S p') (dempty htl)) = (dempty htl) [drop_axioms]])
            }

    define [lh9 lsts9 tl9] := [?lh9:Location ?lsts9:(Lst 'S) ?tl9:(DLst (Lst 'S))]

    define drop_step :=
        (forall dlls pos lh9 lsts9 tl9 .
            ((drop pos dlls) = (dlst lh9 lsts9 tl9)) ==> ((drop (S pos) dlls) = tl9))
    by-induction drop_step {
        (dempty htl:Location) =>
            pick-any pos:N lh9:Location lsts9:(Lst 'S) tl9:(DLst (Lst 'S))
                assume hyp := ((drop pos (dempty htl)) = (dlst lh9 lsts9 tl9))
                    let { e  := (!chain [ (dempty htl) = (drop pos (dempty htl)) [drop_dempty]
                                                       = (dlst lh9 lsts9 tl9)  [hyp] ]);
                          nc := (!uspec* dlst-no-conf [htl lh9 lsts9 tl9]) }
                    (!from-complements ((drop (S pos) (dempty htl)) = tl9) e nc)
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { IH := (forall pos lh9 lsts9 tl9 .
                            ((drop pos tail_dlls) = (dlst lh9 lsts9 tl9)) ==> ((drop (S pos) tail_dlls) = tl9)) }
            pick-any pos:N lh9:Location lsts9:(Lst 'S) tl9:(DLst (Lst 'S))
                datatype-cases (((drop pos (dlst lh lsts tail_dlls)) = (dlst lh9 lsts9 tl9)) ==>
                                ((drop (S pos) (dlst lh lsts tail_dlls)) = tl9)) on pos {
                    zero =>
                        assume hyp := ((drop zero (dlst lh lsts tail_dlls)) = (dlst lh9 lsts9 tl9))
                            let { teq := (!chain [ tail_dlls
                                                 = (vTail (dlst lh lsts tail_dlls))                 [DLst.dlst-vTail]
                                                 = (vTail (drop zero (dlst lh lsts tail_dlls)))     [drop_axioms]
                                                 = (vTail (dlst lh9 lsts9 tl9))                     [hyp]
                                                 = tl9                                              [DLst.dlst-vTail] ]) }
                            (!chain [ (drop (S zero) (dlst lh lsts tail_dlls))
                                    = (drop zero tail_dlls)       [drop_axioms]
                                    = tail_dlls                   [drop_axioms]
                                    = tl9                         [teq] ])
                  | (S p') =>
                        assume hyp := ((drop (S p') (dlst lh lsts tail_dlls)) = (dlst lh9 lsts9 tl9))
                            let { h2 := (!chain [ (drop p' tail_dlls)
                                                = (drop (S p') (dlst lh lsts tail_dlls))   [drop_axioms]
                                                = (dlst lh9 lsts9 tl9)                     [hyp] ]);
                                  ih := (!mp (!uspec* IH [p' lh9 lsts9 tl9]) h2) }
                            (!chain [ (drop (S (S p')) (dlst lh lsts tail_dlls))
                                    = (drop (S p') tail_dlls)     [drop_axioms]
                                    = tl9                         [ih] ])
                }
    }

    ### Read side. setA window that available_key accepts at bucket zero of a
    ### suffix dlls contains an alive bucket among the (S rv) positions that an
    ### insertion writes from there: the part inside dlls, or the wrapped part
    ### at the front of o_dlls.
    define ak_hits_wrap :=
        (forall rv .
            (forall lh lsts tail_dlls o_dlls .
                ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                 (available_key zero rv (dlst lh lsts tail_dlls) o_dlls)) ==>
                ((hits zero (S rv) (dlst lh lsts tail_dlls)) |
                 (hits zero (countWraps zero (S rv) (dlst lh lsts tail_dlls)) o_dlls)))
            ==>
            (forall htl o_dlls .
                ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                 (available_key zero rv (dempty htl) o_dlls)) ==>
                ((hits zero (S rv) (dempty htl)) |
                 (hits zero (countWraps zero (S rv) (dempty htl)) o_dlls))))
    conclude ak_hits_wrap
        pick-any rv:N
            assume dc := (forall lh lsts tail_dlls o_dlls .
                            ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                             (available_key zero rv (dlst lh lsts tail_dlls) o_dlls)) ==>
                            ((hits zero (S rv) (dlst lh lsts tail_dlls)) |
                             (hits zero (countWraps zero (S rv) (dlst lh lsts tail_dlls)) o_dlls)))
                pick-any htl:Location o_dlls:(DLst (Lst 'S))
                    assume hyp := ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                                   (available_key zero rv (dempty htl) o_dlls))
                        let { ex := (!left-and hyp);
                              ak := (!right-and hyp) }
                        pick-witnesses w1 w2 w3 for ex oeq
                            let { ak2 := (!chain-> [ ak
                                            ==> (available_key zero rv (dempty htl) (dlst w1 w2 w3))     [oeq]
                                            ==> (available_key zero rv (dlst w1 w2 w3) (dlst w1 w2 w3))  [available_key_axioms] ]);
                                  _   := (!reflex (dlst w1 w2 w3));
                                  ex2 := (!egen* (exists olh olsts otail_dlls .
                                                    (dlst w1 w2 w3) = (dlst olh olsts otail_dlls))
                                                 [w1 w2 w3]);
                                  r   := (!mp (!uspec* dc [w1 w2 w3 (dlst w1 w2 w3)]) (!both ex2 ak2));
                                  oeqs := (!sym oeq);
                                  r2  := (!chain-> [ r
                                            ==> ((hits zero (S rv) o_dlls) |
                                                 (hits zero (countWraps zero (S rv) o_dlls) o_dlls))  [oeqs] ]);
                                  hs  := (!cases r2
                                            assume a := (hits zero (S rv) o_dlls) (!claim a)
                                            assume b := (hits zero (countWraps zero (S rv) o_dlls) o_dlls)
                                                (!mp (!uspec* hits_countWraps [o_dlls (S rv) o_dlls]) b));
                                  cw  := (!chain [ (countWraps zero (S rv) (dempty htl)) = (S rv) [countWraps_axioms] ]);
                                  hs2 := (!chain-> [ hs ==> (hits zero (countWraps zero (S rv) (dempty htl)) o_dlls) [cw] ]) }
                            (!either (hits zero (S rv) (dempty htl)) hs2)

    define ak_hits :=
        (forall rv dlls o_dlls .
            ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
             (available_key zero rv dlls o_dlls)) ==>
            ((hits zero (S rv) dlls) | (hits zero (countWraps zero (S rv) dlls) o_dlls)))
    by-induction ak_hits {
        zero =>
            let { dc := pick-any lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S)) o_dlls:(DLst (Lst 'S))
                          assume hyp := ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                                         (available_key zero zero (dlst lh lsts tail_dlls) o_dlls))
                              (!chain-> [ (!right-and hyp)
                                  ==> (Location.alive lh)                                        [available_key_axioms]
                                  ==> ((Location.alive lh) | (hits zero zero tail_dlls))         [alternate]
                                  ==> (hits zero (S zero) (dlst lh lsts tail_dlls))              [hits_axioms]
                                  ==> ((hits zero (S zero) (dlst lh lsts tail_dlls)) |
                                       (hits zero (countWraps zero (S zero) (dlst lh lsts tail_dlls)) o_dlls)) [alternate] ]);
                  de := (!mp (!uspec ak_hits_wrap zero) dc) }
            pick-any dlls:(DLst (Lst 'S)) o_dlls:(DLst (Lst 'S))
                datatype-cases (((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                                 (available_key zero zero dlls o_dlls)) ==>
                                ((hits zero (S zero) dlls) | (hits zero (countWraps zero (S zero) dlls) o_dlls)))
                on dlls {
                    (dempty eh:Location) => (!uspec* de [eh o_dlls])
                  | (dlst dla:Location dlb:(Lst 'S) dlc:(DLst (Lst 'S))) => (!uspec* dc [dla dlb dlc o_dlls])
                }
      | (S r) =>
            let { IH := (forall dlls o_dlls .
                            ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                             (available_key zero r dlls o_dlls)) ==>
                            ((hits zero (S r) dlls) | (hits zero (countWraps zero (S r) dlls) o_dlls)));
                  dc := pick-any lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S)) o_dlls:(DLst (Lst 'S))
                          assume hyp := ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                                         (available_key zero (S r) (dlst lh lsts tail_dlls) o_dlls))
                            let { ak := (!right-and hyp) }
                            (!two-cases
                                assume alv := (Location.alive lh)
                                    (!chain-> [ alv
                                        ==> ((Location.alive lh) | (hits zero (S r) tail_dlls))   [alternate]
                                        ==> (hits zero (S (S r)) (dlst lh lsts tail_dlls))        [hits_axioms]
                                        ==> ((hits zero (S (S r)) (dlst lh lsts tail_dlls)) |
                                             (hits zero (countWraps zero (S (S r)) (dlst lh lsts tail_dlls)) o_dlls)) [alternate] ])
                                assume nalv := (~ Location.alive lh)
                                    let { ak2 := (!chain-> [ ak ==> (available_key zero r tail_dlls o_dlls) [available_key_axioms] ]);
                                          ih  := (!mp (!uspec* IH [tail_dlls o_dlls]) (!both (!left-and hyp) ak2));
                                          cw  := (!chain [ (countWraps zero (S (S r)) (dlst lh lsts tail_dlls))
                                                         = (countWraps zero (S r) tail_dlls)   [countWraps_axioms] ]);
                                          cws := (!sym cw) }
                                    (!cases ih
                                        assume a := (hits zero (S r) tail_dlls)
                                            (!chain-> [ a
                                                ==> ((Location.alive lh) | (hits zero (S r) tail_dlls))   [alternate]
                                                ==> (hits zero (S (S r)) (dlst lh lsts tail_dlls))        [hits_axioms]
                                                ==> ((hits zero (S (S r)) (dlst lh lsts tail_dlls)) |
                                                     (hits zero (countWraps zero (S (S r)) (dlst lh lsts tail_dlls)) o_dlls)) [alternate] ])
                                        assume b := (hits zero (countWraps zero (S r) tail_dlls) o_dlls)
                                            let { b2 := (!chain-> [ b ==> (hits zero (countWraps zero (S (S r)) (dlst lh lsts tail_dlls)) o_dlls) [cws] ]) }
                                            (!either (hits zero (S (S r)) (dlst lh lsts tail_dlls)) b2)));
                  de := (!mp (!uspec ak_hits_wrap (S r)) dc) }
            pick-any dlls:(DLst (Lst 'S)) o_dlls:(DLst (Lst 'S))
                datatype-cases (((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                                 (available_key zero (S r) dlls o_dlls)) ==>
                                ((hits zero (S (S r)) dlls) | (hits zero (countWraps zero (S (S r)) dlls) o_dlls)))
                on dlls {
                    (dempty eh:Location) => (!uspec* de [eh o_dlls])
                  | (dlst dla:Location dlb:(Lst 'S) dlc:(DLst (Lst 'S))) => (!uspec* dc [dla dlb dlc o_dlls])
                }
    }

    ### Lifting ak_hits from bucket zero to any bucket index: available_key
    ### and bucketIndex walk the bucket index in lock step.
    # Reduction of the `dempty` suffix case to the `dlst` case at position
    # zero. setA method rather than a stated lemma: it is applied once per case of
    # the induction below, to the `dlst`-case sentence `dc` proven there.
    define ak_hits_gen_wrap :=
        method (bucket dc)
                pick-any pos:N rv:N o_dlls:(DLst (Lst 'S))
                    assume hyp := ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) & (available_key bucket rv (drop pos o_dlls) o_dlls))
                        let { ex := (!left-and hyp);
                              ak := (!right-and hyp) }
                        (!cases (!uspec dlst-no-junk (drop pos o_dlls))
                            assume is_empty := (exists htl . (drop pos o_dlls) = (dempty htl))
                                pick-witness wh for is_empty weq
                                pick-witnesses ow1 ow2 ow3 for ex oeq
                                    let { oeqs := (!sym oeq);
                                          ak1 := (!chain-> [ ak
                                                    ==> (available_key bucket rv (dempty wh) o_dlls)               [weq]
                                                    ==> (available_key bucket rv (dempty wh) (dlst ow1 ow2 ow3))   [oeq]
                                                    ==> (available_key bucket rv (dlst ow1 ow2 ow3) (dlst ow1 ow2 ow3)) [available_key_axioms] ]);
                                          bi  := (!chain [ (bucketIndex bucket (drop pos o_dlls) o_dlls pos)
                                                         = (bucketIndex bucket (dempty wh) o_dlls pos)                 [weq]
                                                         = (bucketIndex bucket (dempty wh) (dlst ow1 ow2 ow3) pos)     [oeq]
                                                         = (bucketIndex bucket (dlst ow1 ow2 ow3) (dlst ow1 ow2 ow3) zero) [bucketIndex_axioms] ]);
                                          dq0 := (!chain [ (drop zero (dlst ow1 ow2 ow3)) = (dlst ow1 ow2 ow3) [drop_axioms] ]);
                                          _   := (!reflex (dlst ow1 ow2 ow3));
                                          ex0 := (!egen* (exists olh olsts otail_dlls .
                                                            (dlst ow1 ow2 ow3) = (dlst olh olsts otail_dlls))
                                                         [ow1 ow2 ow3]);
                                          r0  := (!mp (!uspec* dc [zero rv (dlst ow1 ow2 ow3) ow1 ow2 ow3])
                                                      (!both dq0 (!both ex0 ak1))) }
                                    (!chain-> [ r0
                                        ==> ((hits (bucketIndex bucket (dlst ow1 ow2 ow3) (dlst ow1 ow2 ow3) zero) (S rv) o_dlls) |
                                             (hits zero (countWraps (bucketIndex bucket (dlst ow1 ow2 ow3) (dlst ow1 ow2 ow3) zero) (S rv) o_dlls) o_dlls))
                                                                                                          [oeqs]
                                        ==> ((hits (bucketIndex bucket (drop pos o_dlls) o_dlls pos) (S rv) o_dlls) |
                 (hits zero (countWraps (bucketIndex bucket (drop pos o_dlls) o_dlls pos) (S rv) o_dlls) o_dlls))                          [bi] ])
                            assume is_dlst := (exists lh lsts tail_dlls . (drop pos o_dlls) = (dlst lh lsts tail_dlls))
                                pick-witnesses w1 w2 w3 for is_dlst weq
                                    let { akw := (!chain-> [ ak ==> (available_key bucket rv (dlst w1 w2 w3) o_dlls) [weq] ]);
                                          r   := (!mp (!uspec* dc [pos rv o_dlls w1 w2 w3]) (!both weq (!both ex akw))) }
                                    (!chain-> [ r ==> ((hits (bucketIndex bucket (drop pos o_dlls) o_dlls pos) (S rv) o_dlls) |
                 (hits zero (countWraps (bucketIndex bucket (drop pos o_dlls) o_dlls pos) (S rv) o_dlls) o_dlls)) [weq] ]))

    define ak_hits_gen :=
        (forall bucket pos rv o_dlls .
            ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) & (available_key bucket rv (drop pos o_dlls) o_dlls)) ==>
            ((hits (bucketIndex bucket (drop pos o_dlls) o_dlls pos) (S rv) o_dlls) |
                 (hits zero (countWraps (bucketIndex bucket (drop pos o_dlls) o_dlls pos) (S rv) o_dlls) o_dlls)))
    by-induction ak_hits_gen {
        zero =>
            let { dc := pick-any pos:N rv:N o_dlls:(DLst (Lst 'S)) lh9:Location lsts9:(Lst 'S) tl9:(DLst (Lst 'S))
                          assume hyp := (((drop pos o_dlls) = (dlst lh9 lsts9 tl9)) & (exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                                         (available_key zero rv (dlst lh9 lsts9 tl9) o_dlls))
                            let { dq := (!left-and hyp);
                                  ex := (!left-and (!right-and hyp));
                                  ak := (!right-and (!right-and hyp));
                                  akd := (!chain-> [ ak ==> (available_key zero rv (drop pos o_dlls) o_dlls) [dq] ]);
                                  e  := (!mp (!uspec* ak_hits [rv (drop pos o_dlls) o_dlls]) (!both ex akd));
                                  h1 := (!uspec* hits_drop [o_dlls pos (S rv)]);
                                  c1 := (!uspec* countWraps_drop [o_dlls pos (S rv)]);
                                  bi := (!chain [ (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) = pos [bucketIndex_axioms] ]) }
                            (!cases e
                                assume a := (hits zero (S rv) (drop pos o_dlls))
                                    (!chain-> [ a
                                        ==> (hits pos (S rv) o_dlls)                                      [h1]
                                        ==> (hits (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) (S rv) o_dlls) [bi]
                                        ==> ((hits (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) (S rv) o_dlls) |
                 (hits zero (countWraps (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) (S rv) o_dlls) o_dlls))                    [alternate] ])
                                assume bx := (hits zero (countWraps zero (S rv) (drop pos o_dlls)) o_dlls)
                                    let { b2 := (!chain-> [ bx
                                            ==> (hits zero (countWraps pos (S rv) o_dlls) o_dlls)          [c1]
                                            ==> (hits zero (countWraps (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) (S rv) o_dlls) o_dlls) [bi] ]) }
                                    (!either (hits (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) (S rv) o_dlls) b2)) }
            (!ak_hits_gen_wrap zero dc)
      | (S bx) =>
            let { IH := (forall pos rv o_dlls .
                            ((exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) & (available_key bx rv (drop pos o_dlls) o_dlls)) ==>
                            ((hits (bucketIndex bx (drop pos o_dlls) o_dlls pos) (S rv) o_dlls) |
                 (hits zero (countWraps (bucketIndex bx (drop pos o_dlls) o_dlls pos) (S rv) o_dlls) o_dlls)));
                  dc := pick-any pos:N rv:N o_dlls:(DLst (Lst 'S)) lh9:Location lsts9:(Lst 'S) tl9:(DLst (Lst 'S))
                          assume hyp := (((drop pos o_dlls) = (dlst lh9 lsts9 tl9)) & (exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) &
                                         (available_key (S bx) rv (dlst lh9 lsts9 tl9) o_dlls))
                            let { dq := (!left-and hyp);
                                  ex := (!left-and (!right-and hyp));
                                  ak := (!right-and (!right-and hyp));
                                  ds := (!mp (!uspec* drop_step [o_dlls pos lh9 lsts9 tl9]) dq);
                                  ak3 := (!chain-> [ ak
                                            ==> (available_key bx rv tl9 o_dlls)                [available_key_axioms]
                                            ==> (available_key bx rv (drop (S pos) o_dlls) o_dlls) [ds] ]);
                                  r  := (!mp (!uspec* IH [(S pos) rv o_dlls]) (!both ex ak3));
                                  bi := (!chain [ (bucketIndex (S bx) (dlst lh9 lsts9 tl9) o_dlls pos)
                                                = (bucketIndex bx tl9 o_dlls (S pos))                 [bucketIndex_axioms]
                                                = (bucketIndex bx (drop (S pos) o_dlls) o_dlls (S pos)) [ds] ]) }
                            (!chain-> [ r ==> ((hits (bucketIndex (S bx) (dlst lh9 lsts9 tl9) o_dlls pos) (S rv) o_dlls) |
                 (hits zero (countWraps (bucketIndex (S bx) (dlst lh9 lsts9 tl9) o_dlls pos) (S rv) o_dlls) o_dlls)) [bi] ]) }
            (!ak_hits_gen_wrap (S bx) dc)
    }

    # The window that available_key accepts contains an alive bucket that
    # insertDPrList writes (PROVEN).
    define ak_hits_insert :=
        (forall bucket rv dlls .
            (available_key bucket rv dlls dlls) ==>
            ((hits (bucketIndex bucket dlls dlls zero) (S rv) dlls) |
             (hits zero (countWraps (bucketIndex bucket dlls dlls zero) (S rv) dlls) dlls)))
    conclude ak_hits_insert
        pick-any bucket:N rv:N dlls:(DLst (Lst 'S))
            assume ak := (available_key bucket rv dlls dlls)
                (!cases (!uspec dlst-no-junk dlls)
                    assume is_empty := (exists htl . dlls = (dempty htl))
                        pick-witness wh for is_empty weq
                            let { _ := (!chain-> [ ak
                                        ==> (available_key bucket rv (dempty wh) (dempty wh)) [weq]
                                        ==> false                                             [available_key_axioms] ]) }
                            (!from-false ((hits (bucketIndex bucket dlls dlls zero) (S rv) dlls) |
                                          (hits zero (countWraps (bucketIndex bucket dlls dlls zero) (S rv) dlls) dlls)))
                    assume is_dlst := (exists lh lsts tail_dlls . dlls = (dlst lh lsts tail_dlls))
                        let { ak0 := (!chain-> [ ak ==> (available_key bucket rv (drop zero dlls) dlls) [drop_axioms] ]);
                              r   := (!mp (!uspec* ak_hits_gen [bucket zero rv dlls]) (!both is_dlst ak0)) }
                        (!chain-> [ r
                            ==> ((hits (bucketIndex bucket dlls dlls zero) (S rv) dlls) |
                                 (hits zero (countWraps (bucketIndex bucket dlls dlls zero) (S rv) dlls) dlls)) [drop_axioms] ]))

    define values_after_insert :=
        (forall bucket rv v0 dlls s0 .
            (((available_key bucket rv dlls dlls) &
              ((values dlls) = (SOME s0))) ==>
             ((values (insertDPrList bucket rv v0 dlls)) = (SOME (Set.insert v0 s0)))))
    conclude values_after_insert
        pick-any bucket:N rv:N v0:'S dlls:(DLst (Lst 'S)) s0:(Set.Set 'S)
            assume hyp := ((available_key bucket rv dlls dlls) & ((values dlls) = (SOME s0)))
                let { ak  := (!left-and hyp);
                      hv  := (!right-and hyp);
                      idx := (bucketIndex bucket dlls dlls zero);
                      w   := (countWraps idx (S rv) dlls);
                      d1  := (insertNAt idx (S rv) v0 dlls);
                      c   := (!mp (!uspec* ak_hits_insert [bucket rv dlls]) ak);
                      b1  := (!mp (!uspec* values_insertNAt [dlls idx (S rv) v0 s0]) hv);
                      ins := (!chain [ (insertDPrList bucket rv v0 dlls) = (insertNAt zero w v0 d1) [insertDPrList_axioms] ]) }
                (!two-cases
                    assume h1 := (hits idx (S rv) dlls)
                        let { d1v := (!mp (!left-and b1) h1);
                              b2  := (!mp (!uspec* values_insertNAt [d1 zero w v0 (insert v0 s0)]) d1v) }
                        (!two-cases
                            assume h2 := (hits zero w d1)
                                let { r2 := (!mp (!left-and b2) h2) }
                                (!chain [ (values (insertDPrList bucket rv v0 dlls))
                                        = (values (insertNAt zero w v0 d1))        [ins]
                                        = (SOME (insert v0 (insert v0 s0)))        [r2]
                                        = (SOME (insert v0 s0))                    [insert_idem] ])
                            assume nh2 := (~ hits zero w d1)
                                let { r2 := (!mp (!right-and b2) nh2) }
                                (!chain [ (values (insertDPrList bucket rv v0 dlls))
                                        = (values (insertNAt zero w v0 d1))        [ins]
                                        = (SOME (insert v0 s0))                    [r2] ]))
                    assume nh1 := (~ hits idx (S rv) dlls)
                        let { hw   := (!dsyl c nh1);
                              hiff := (!uspec* hits_insertNAt [dlls idx (S rv) v0 zero w]);
                              hd1  := (!mp (!right-iff hiff) hw);
                              d1v  := (!mp (!right-and b1) nh1);
                              b2   := (!mp (!uspec* values_insertNAt [d1 zero w v0 s0]) d1v);
                              r2   := (!mp (!left-and b2) hd1) }
                        (!chain [ (values (insertDPrList bucket rv v0 dlls))
                                = (values (insertNAt zero w v0 d1))        [ins]
                                = (SOME (insert v0 s0))                    [r2] ]))


    ### Lookup after insertion (PROVEN).
    ###
    ### in_after_insert_other: inserting v0 =/= v does not change the result of
    ### `in` for v. `in` reads a bucket only through (Lst.in v lsts), so it sees
    ### a bucket list only through `same_mem v` (in_mem_inv_all, same structure
    ### as available_key_locs_inv_all), and insertion of v0 preserves same_mem.
    ###
    ### in_after_insert_self: after inserting v at any bucket index of a
    ### non-empty bucket list, `in` finds v. The lookup walk ends at the bucket
    ### that bucketIndex computes (in_walk), insertion does not change that
    ### index (bucketIndex_insert_invariant), and that bucket starts with v
    ### (head_after_insertNAt, head_kept_insertNAt).


    ### same_mem v d1 d2: the two bucket lists have the same shape and agree,
    ### bucket by bucket, on whether the bucket contains v.
    declare same_mem : (S) [S (DLst (Lst S)) (DLst (Lst S))] -> Boolean
    assert same_mem_axioms := (fun [
        (same_mem v (dempty htl) (dempty htl0)) <==> true
        (same_mem v (dempty htl) (dlst lh2 lsts2 tail_dlls2)) <==> false
        (same_mem v (dlst lh lsts tail_dlls) (dempty htl0)) <==> false
        (same_mem v (dlst lh lsts tail_dlls) (dlst lh2 lsts2 tail_dlls2)) <==>
            (((Lst.in v lsts) <==> (Lst.in v lsts2)) & (same_mem v tail_dlls tail_dlls2))
    ])

    # same_mem is reflexive (PROVEN).
    define same_mem_refl :=
        (forall dlls v . same_mem v dlls dlls)
    by-induction same_mem_refl {
        (dempty htl:Location) =>
            pick-any v:'S
                (!chain-> [ true ==> (same_mem v (dempty htl) (dempty htl)) [same_mem_axioms] ])
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { IH := (forall v . same_mem v tail_dlls tail_dlls) }
            pick-any v:'S
                let { e  := (!chain-> [ true ==> ((Lst.in v lsts) <==> (Lst.in v lsts)) [prop-taut] ]);
                      ih := (!uspec IH v) }
                (!chain-> [ (!both e ih)
                    ==> (same_mem v (dlst lh lsts tail_dlls) (dlst lh lsts tail_dlls)) [same_mem_axioms] ])
    }

    # Both empty, or both non-empty with heads that agree on v and tails
    # related by same_mem (PROVEN).
    define mem_cases :=
        (forall v dlls1 dlls2 .
            (same_mem v dlls1 dlls2) ==>
            ((exists htl htl0 . ((dlls1 = (dempty htl)) & (dlls2 = (dempty htl0))))
             | (exists lh lsts1 tail_dlls lh2 lsts2 tail_dlls2 .
                    ((dlls1 = (dlst lh lsts1 tail_dlls)) &
                     ((dlls2 = (dlst lh2 lsts2 tail_dlls2)) &
                      (((Lst.in v lsts1) <==> (Lst.in v lsts2)) &
                       (same_mem v tail_dlls tail_dlls2)))))))
    conclude mem_cases
      pick-any v:'S d1:(DLst (Lst 'S)) d2:(DLst (Lst 'S))
        assume hsl := (same_mem v d1 d2)
          let { leftS  := (exists htl htl0 . ((d1 = (dempty htl)) & (d2 = (dempty htl0))));
                rightS := (exists lh lsts1 tail_dlls lh2 lsts2 tail_dlls2 .
                             ((d1 = (dlst lh lsts1 tail_dlls)) &
                              ((d2 = (dlst lh2 lsts2 tail_dlls2)) &
                               (((Lst.in v lsts1) <==> (Lst.in v lsts2)) &
                                (same_mem v tail_dlls tail_dlls2)))));
                goal   := (leftS | rightS) }
          (!cases (!uspec DLst.dlst-no-junk d1)
            assume e1 := (exists ?x1:Location . d1 = (dempty ?x1))
              pick-witness h1 for e1 d1e
              (!cases (!uspec DLst.dlst-no-junk d2)
                assume e2 := (exists ?x1:Location . d2 = (dempty ?x1))
                  pick-witness h2 for e2 d2e
                    let { _ := (!both d1e d2e) }
                    (!either (!egen* leftS [h1 h2]) rightS)
                assume e2 := (exists ?x1:Location ?x2:(Lst 'S) ?x3:(DLst (Lst 'S)) . d2 = (dlst ?x1 ?x2 ?x3))
                  pick-witnesses a2 s2 t2 for e2 d2e
                    let { _ := (!chain-> [ hsl ==> (same_mem v (dempty h1) (dlst a2 s2 t2)) [d1e d2e]
                                              ==> false                                    [same_mem_axioms] ]) }
                    (!from-false goal))
            assume e1 := (exists ?x1:Location ?x2:(Lst 'S) ?x3:(DLst (Lst 'S)) . d1 = (dlst ?x1 ?x2 ?x3))
              pick-witnesses a1 s1 t1 for e1 d1e
              (!cases (!uspec DLst.dlst-no-junk d2)
                assume e2 := (exists ?x1:Location . d2 = (dempty ?x1))
                  pick-witness h2 for e2 d2e
                    let { _ := (!chain-> [ hsl ==> (same_mem v (dlst a1 s1 t1) (dempty h2)) [d1e d2e]
                                              ==> false                                    [same_mem_axioms] ]) }
                    (!from-false goal)
                assume e2 := (exists ?x1:Location ?x2:(Lst 'S) ?x3:(DLst (Lst 'S)) . d2 = (dlst ?x1 ?x2 ?x3))
                  pick-witnesses a2 s2 t2 for e2 d2e
                    let { c := (!chain-> [ hsl ==> (same_mem v (dlst a1 s1 t1) (dlst a2 s2 t2)) [d1e d2e]
                                              ==> (((Lst.in v s1) <==> (Lst.in v s2)) & (same_mem v t1 t2)) [same_mem_axioms] ]);
                          _ := (!both d1e (!both d2e c)) }
                    (!either leftS (!egen* rightS [a1 s1 t1 a2 s2 t2]))))

    # (mi-inv B R v): `in` at (B, R) for the key v sees its list arguments only
    # through same_mem. Same structure as ak-inv above.
    define (mi-inv B R v) :=
        (forall dlls1 dlls2 . (same_mem v dlls1 dlls2) ==>
           forall o_dlls1 o_dlls2 . (same_mem v o_dlls1 o_dlls2) ==>
             ((in B R dlls1 o_dlls1 v) <==> (in B R dlls2 o_dlls2 v)))

    define (mi-dlst B R v) :=
        (forall lh lsts1 tail_dlls lh2 lsts2 tail_dlls2 .
           (((Lst.in v lsts1) <==> (Lst.in v lsts2)) & (same_mem v tail_dlls tail_dlls2)) ==>
           forall o_dlls1 o_dlls2 . (same_mem v o_dlls1 o_dlls2) ==>
             ((in B R (dlst lh lsts1 tail_dlls) o_dlls1 v) <==> (in B R (dlst lh2 lsts2 tail_dlls2) o_dlls2 v)))

    # mi-close: from (mi-dlst B R v) in the assumption base, conclude (mi-inv B R v).
    define (mi-close B R v dc) :=
      pick-any d1:(DLst (Lst 'S)) d2:(DLst (Lst 'S))
        assume deq := (same_mem v d1 d2)
          pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
            assume oeq := (same_mem v o1 o2)
              (!cases (!mp (!uspec* mem_cases [v d1 d2]) deq)
                assume demp := (exists htl htl0 . ((d1 = (dempty htl)) & (d2 = (dempty htl0))))
                  pick-witnesses h1 h2 for demp dw
                    let { d1e := (!left-and dw);
                          d2e := (!right-and dw) }
                    (!cases (!mp (!uspec* mem_cases [v o1 o2]) oeq)
                      assume oemp := (exists htl htl0 . ((o1 = (dempty htl)) & (o2 = (dempty htl0))))
                        pick-witnesses g1 g2 for oemp ow
                          let { o1e := (!left-and ow);
                                o2e := (!right-and ow);
                                f1  := (!chain [ (in B R d1 o1 v)
                                               <==> (in B R (dempty h1) (dempty g1) v)   [d1e o1e]
                                               <==> false                                 [in_axioms] ]);
                                f2  := (!chain [ (in B R d2 o2 v)
                                               <==> (in B R (dempty h2) (dempty g2) v)   [d2e o2e]
                                               <==> false                                 [in_axioms] ]) }
                          (!chain [ (in B R d1 o1 v) <==> false [f1] <==> (in B R d2 o2 v) [f2] ])
                      assume ocons := (exists lh lsts1 tail_dlls lh2 lsts2 tail_dlls2 .
                                         ((o1 = (dlst lh lsts1 tail_dlls)) &
                                          ((o2 = (dlst lh2 lsts2 tail_dlls2)) &
                                           (((Lst.in v lsts1) <==> (Lst.in v lsts2)) &
                                            (same_mem v tail_dlls tail_dlls2)))))
                        pick-witnesses a1 s1 t1 a2 s2 t2 for ocons ow
                          let { o1e  := (!left-and ow);
                                o2e  := (!left-and (!right-and ow));
                                hrest := (!right-and (!right-and ow));
                                step := (!mp (!uspec* (!mp (!uspec* dc [a1 s1 t1 a2 s2 t2]) hrest) [o1 o2]) oeq) }
                          (!chain [ (in B R d1 o1 v)
                                  <==> (in B R (dempty h1) (dlst a1 s1 t1) v)          [d1e o1e]
                                  <==> (in B R (dlst a1 s1 t1) (dlst a1 s1 t1) v)      [in_axioms]
                                  <==> (in B R (dlst a1 s1 t1) o1 v)                   [o1e]
                                  <==> (in B R (dlst a2 s2 t2) o2 v)                   [step]
                                  <==> (in B R (dlst a2 s2 t2) (dlst a2 s2 t2) v)      [o2e]
                                  <==> (in B R (dempty h2) (dlst a2 s2 t2) v)          [in_axioms]
                                  <==> (in B R d2 o2 v)                                [d2e o2e] ]))
                assume dcons := (exists lh lsts1 tail_dlls lh2 lsts2 tail_dlls2 .
                                   ((d1 = (dlst lh lsts1 tail_dlls)) &
                                    ((d2 = (dlst lh2 lsts2 tail_dlls2)) &
                                     (((Lst.in v lsts1) <==> (Lst.in v lsts2)) &
                                      (same_mem v tail_dlls tail_dlls2)))))
                  pick-witnesses a1 s1 t1 a2 s2 t2 for dcons dw
                    let { d1e  := (!left-and dw);
                          d2e  := (!left-and (!right-and dw));
                          hrest := (!right-and (!right-and dw));
                          step := (!mp (!uspec* (!mp (!uspec* dc [a1 s1 t1 a2 s2 t2]) hrest) [o1 o2]) oeq) }
                    (!chain [ (in B R d1 o1 v)
                            <==> (in B R (dlst a1 s1 t1) o1 v)   [d1e]
                            <==> (in B R (dlst a2 s2 t2) o2 v)   [step]
                            <==> (in B R d2 o2 v)                [d2e] ]))

    define in_mem_inv_all := (forall B . (forall R . (forall v . (mi-inv B R v))))

    by-induction in_mem_inv_all {
      zero =>
        by-induction (forall R . (forall v . (mi-inv zero R v))) {
          zero =>
            pick-any v:'S
              let { dc := (mi-dlst zero zero v);
                    _  := conclude dc
                            pick-any a1:Location s1:(Lst 'S) t1:(DLst (Lst 'S))
                                     a2:Location s2:(Lst 'S) t2:(DLst (Lst 'S))
                              assume hh := (((Lst.in v s1) <==> (Lst.in v s2)) & (same_mem v t1 t2))
                                pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
                                  assume (same_mem v o1 o2)
                                    let { hi := (!left-and hh) }
                                    (!chain [ (in zero zero (dlst a1 s1 t1) o1 v)
                                            <==> (Lst.in v s1)                         [in_axioms]
                                            <==> (Lst.in v s2)                         [hi]
                                            <==> (in zero zero (dlst a2 s2 t2) o2 v)   [in_axioms] ]) }
              (!mi-close zero zero v dc)
        | (S n) =>
            let { ih := (forall v . (mi-inv zero n v)) }
            pick-any v:'S
              let { dc := (mi-dlst zero (S n) v);
                    _  := conclude dc
                            pick-any a1:Location s1:(Lst 'S) t1:(DLst (Lst 'S))
                                     a2:Location s2:(Lst 'S) t2:(DLst (Lst 'S))
                              assume hh := (((Lst.in v s1) <==> (Lst.in v s2)) & (same_mem v t1 t2))
                                pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
                                  assume ho := (same_mem v o1 o2)
                                    let { hi  := (!left-and hh);
                                          ht  := (!right-and hh);
                                          ihi := (!mp (!uspec* (!mp (!uspec* (!uspec ih v) [t1 t2]) ht) [o1 o2]) ho) }
                                    (!two-cases
                                      assume i1 := (Lst.in v s1)
                                        let { i2 := (!chain-> [ i1 ==> (Lst.in v s2) [hi] ]);
                                              e1 := (!chain-> [ i1 ==> ((in zero (S n) (dlst a1 s1 t1) o1 v) <==> true) [in_axioms] ]);
                                              e2 := (!chain-> [ i2 ==> ((in zero (S n) (dlst a2 s2 t2) o2 v) <==> true) [in_axioms] ]) }
                                        (!chain [ (in zero (S n) (dlst a1 s1 t1) o1 v)
                                                <==> true                                    [e1]
                                                <==> (in zero (S n) (dlst a2 s2 t2) o2 v)    [e2] ])
                                      assume n1 := (~ Lst.in v s1)
                                        let { n2 := (!by-contradiction (~ Lst.in v s2)
                                                       assume i2 := (Lst.in v s2)
                                                         (!absurd (!chain-> [ i2 ==> (Lst.in v s1) [hi] ]) n1));
                                              e1 := (!chain-> [ n1 ==> ((in zero (S n) (dlst a1 s1 t1) o1 v) <==> (in zero n t1 o1 v)) [in_axioms] ]);
                                              e2 := (!chain-> [ n2 ==> ((in zero (S n) (dlst a2 s2 t2) o2 v) <==> (in zero n t2 o2 v)) [in_axioms] ]) }
                                        (!chain [ (in zero (S n) (dlst a1 s1 t1) o1 v)
                                                <==> (in zero n t1 o1 v)                     [e1]
                                                <==> (in zero n t2 o2 v)                     [ihi]
                                                <==> (in zero (S n) (dlst a2 s2 t2) o2 v)    [e2] ])) }
              (!mi-close zero (S n) v dc)
        }
    | (S n) =>
        let { ih := (forall R . (forall v . (mi-inv n R v))) }
        pick-any R0:N
          pick-any v:'S
            let { dc := (mi-dlst (S n) R0 v);
                  _  := conclude dc
                          pick-any a1:Location s1:(Lst 'S) t1:(DLst (Lst 'S))
                                   a2:Location s2:(Lst 'S) t2:(DLst (Lst 'S))
                            assume hh := (((Lst.in v s1) <==> (Lst.in v s2)) & (same_mem v t1 t2))
                              pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
                                assume ho := (same_mem v o1 o2)
                                  let { ht  := (!right-and hh);
                                        ihi := (!mp (!uspec* (!mp (!uspec* (!uspec* ih [R0 v]) [t1 t2]) ht) [o1 o2]) ho) }
                                  (!chain [ (in (S n) R0 (dlst a1 s1 t1) o1 v)
                                          <==> (in n R0 t1 o1 v)                  [in_axioms]
                                          <==> (in n R0 t2 o2 v)                  [ihi]
                                          <==> (in (S n) R0 (dlst a2 s2 t2) o2 v) [in_axioms] ]) }
            (!mi-close (S n) R0 v dc)
    }

    # same_mem is transitive (PROVEN, by induction on the first list).
    define same_mem_trans :=
        (forall dlls1 v dlls2 o_dlls1 .
            ((same_mem v dlls1 dlls2) & (same_mem v dlls2 o_dlls1)) ==> (same_mem v dlls1 o_dlls1))
    by-induction same_mem_trans {
        (dempty h1:Location) =>
            pick-any v:'S d2:(DLst (Lst 'S)) d3:(DLst (Lst 'S))
              assume hyp := ((same_mem v (dempty h1) d2) & (same_mem v d2 d3))
                let { hy1 := (!left-and hyp);
                      hy2 := (!right-and hyp) }
                (!cases (!uspec DLst.dlst-no-junk d2)
                  assume e2 := (exists ?x1:Location . d2 = (dempty ?x1))
                    pick-witness h2 for e2 d2e
                    (!cases (!uspec DLst.dlst-no-junk d3)
                      assume e3 := (exists ?x1:Location . d3 = (dempty ?x1))
                        pick-witness h3 for e3 d3e
                          (!chain-> [ true ==> (same_mem v (dempty h1) (dempty h3)) [same_mem_axioms]
                                           ==> (same_mem v (dempty h1) d3)          [d3e] ])
                      assume e3 := (exists ?x1:Location ?x2:(Lst 'S) ?x3:(DLst (Lst 'S)) . d3 = (dlst ?x1 ?x2 ?x3))
                        pick-witnesses a3 s3 t3 for e3 d3e
                          let { _ := (!chain-> [ hy2 ==> (same_mem v (dempty h2) (dlst a3 s3 t3)) [d2e d3e]
                                                     ==> false                                    [same_mem_axioms] ]) }
                          (!from-false (same_mem v (dempty h1) d3)))
                  assume e2 := (exists ?x1:Location ?x2:(Lst 'S) ?x3:(DLst (Lst 'S)) . d2 = (dlst ?x1 ?x2 ?x3))
                    pick-witnesses a2 s2 t2 for e2 d2e
                      let { _ := (!chain-> [ hy1 ==> (same_mem v (dempty h1) (dlst a2 s2 t2)) [d2e]
                                                 ==> false                                    [same_mem_axioms] ]) }
                      (!from-false (same_mem v (dempty h1) d3)))
      | (dlst a1:Location s1:(Lst 'S) t1:(DLst (Lst 'S))) =>
            let { IH := (forall v dlls2 o_dlls1 .
                            ((same_mem v t1 dlls2) & (same_mem v dlls2 o_dlls1)) ==> (same_mem v t1 o_dlls1)) }
            pick-any v:'S d2:(DLst (Lst 'S)) d3:(DLst (Lst 'S))
              assume hyp := ((same_mem v (dlst a1 s1 t1) d2) & (same_mem v d2 d3))
                let { hy1 := (!left-and hyp);
                      hy2 := (!right-and hyp) }
                (!cases (!uspec DLst.dlst-no-junk d2)
                  assume e2 := (exists ?x1:Location . d2 = (dempty ?x1))
                    pick-witness h2 for e2 d2e
                      let { _ := (!chain-> [ hy1 ==> (same_mem v (dlst a1 s1 t1) (dempty h2)) [d2e]
                                                 ==> false                                    [same_mem_axioms] ]) }
                      (!from-false (same_mem v (dlst a1 s1 t1) d3))
                  assume e2 := (exists ?x1:Location ?x2:(Lst 'S) ?x3:(DLst (Lst 'S)) . d2 = (dlst ?x1 ?x2 ?x3))
                    pick-witnesses a2 s2 t2 for e2 d2e
                    (!cases (!uspec DLst.dlst-no-junk d3)
                      assume e3 := (exists ?x1:Location . d3 = (dempty ?x1))
                        pick-witness h3 for e3 d3e
                          let { _ := (!chain-> [ hy2 ==> (same_mem v (dlst a2 s2 t2) (dempty h3)) [d2e d3e]
                                                     ==> false                                    [same_mem_axioms] ]) }
                          (!from-false (same_mem v (dlst a1 s1 t1) d3))
                      assume e3 := (exists ?x1:Location ?x2:(Lst 'S) ?x3:(DLst (Lst 'S)) . d3 = (dlst ?x1 ?x2 ?x3))
                        pick-witnesses a3 s3 t3 for e3 d3e
                          let { c1 := (!chain-> [ hy1 ==> (same_mem v (dlst a1 s1 t1) (dlst a2 s2 t2)) [d2e]
                                                      ==> (((Lst.in v s1) <==> (Lst.in v s2)) & (same_mem v t1 t2)) [same_mem_axioms] ]);
                                c2 := (!chain-> [ hy2 ==> (same_mem v (dlst a2 s2 t2) (dlst a3 s3 t3)) [d2e d3e]
                                                      ==> (((Lst.in v s2) <==> (Lst.in v s3)) & (same_mem v t2 t3)) [same_mem_axioms] ]);
                                i13 := (!chain-> [ (!both (!left-and c1) (!left-and c2))
                                                   ==> ((Lst.in v s1) <==> (Lst.in v s3)) [prop-taut] ]);
                                t13 := (!mp (!uspec* IH [v t2 t3]) (!both (!right-and c1) (!right-and c2))) }
                          (!chain-> [ (!both i13 t13)
                              ==> (same_mem v (dlst a1 s1 t1) (dlst a3 s3 t3)) [same_mem_axioms]
                              ==> (same_mem v (dlst a1 s1 t1) d3)              [d3e] ])))
    }

    # Inserting v0 =/= v does not change which buckets contain v (PROVEN).
    define same_mem_insertNAt :=
        (forall dlls bucket n v v0 .
            (~ (v = v0)) ==> (same_mem v (insertNAt bucket n v0 dlls) dlls))
    by-induction same_mem_insertNAt {
        (dempty htl:Location) =>
            pick-any bucket:N n:N v:'S v0:'S
              assume nv := (~ (v = v0))
                let { ins := datatype-cases ((insertNAt bucket n v0 (dempty htl)) = (dempty htl)) on n {
                              zero   => (!chain [(insertNAt bucket zero v0 (dempty htl)) = (dempty htl) [insertNAt_axioms]])
                            | (S m') => (!chain [(insertNAt bucket (S m') v0 (dempty htl)) = (dempty htl) [insertNAt_axioms]])
                          } }
                (!chain-> [ true ==> (same_mem v (dempty htl) (dempty htl))                       [same_mem_axioms]
                                 ==> (same_mem v (insertNAt bucket n v0 (dempty htl)) (dempty htl)) [ins] ])
      | (dlst lh:Location lsts:(Lst 'S) tail_dlls:(DLst (Lst 'S))) =>
            let { IH := (forall bucket n v v0 .
                            (~ (v = v0)) ==> (same_mem v (insertNAt bucket n v0 tail_dlls) tail_dlls)) }
            pick-any bucket:N n:N v:'S v0:'S
              assume nv := (~ (v = v0))
                datatype-cases (same_mem v (insertNAt bucket n v0 (dlst lh lsts tail_dlls)) (dlst lh lsts tail_dlls)) on n {
                    zero =>
                        let { rf  := (!uspec* same_mem_refl [(dlst lh lsts tail_dlls) v]);
                              ins := (!chain [ (insertNAt bucket zero v0 (dlst lh lsts tail_dlls))
                                             = (dlst lh lsts tail_dlls)                          [insertNAt_axioms] ]);
                              eqv := (!chain [ (same_mem v (insertNAt bucket zero v0 (dlst lh lsts tail_dlls)) (dlst lh lsts tail_dlls))
                                             <==> (same_mem v (dlst lh lsts tail_dlls) (dlst lh lsts tail_dlls)) [ins] ]) }
                        (!mp (!right-iff eqv) rf)
                  | (S m') =>
                        datatype-cases (same_mem v (insertNAt bucket (S m') v0 (dlst lh lsts tail_dlls)) (dlst lh lsts tail_dlls)) on bucket {
                            zero =>
                                let { e := (!equiv
                                              (assume h := (Lst.in v (lst v0 lsts))
                                                 (!dsyl (!chain-> [ h ==> ((v = v0) | (Lst.in v lsts)) [Lst.In.in-lst-axiom] ]) nv))
                                              (assume h := (Lst.in v lsts)
                                                 (!chain-> [ h ==> ((v = v0) | (Lst.in v lsts)) [alternate]
                                                               ==> (Lst.in v (lst v0 lsts))      [Lst.In.in-lst-axiom] ])));
                                      ih := (!mp (!uspec* IH [zero m' v v0]) nv) }
                                (!chain-> [ (!both e ih)
                                    ==> (same_mem v (dlst lh (lst v0 lsts) (insertNAt zero m' v0 tail_dlls)) (dlst lh lsts tail_dlls)) [same_mem_axioms]
                                    ==> (same_mem v (insertNAt zero (S m') v0 (dlst lh lsts tail_dlls)) (dlst lh lsts tail_dlls))     [insertNAt_axioms] ])
                          | (S b') =>
                                let { e  := (!chain-> [ true ==> ((Lst.in v lsts) <==> (Lst.in v lsts)) [prop-taut] ]);
                                      ih := (!mp (!uspec* IH [b' (S m') v v0]) nv) }
                                (!chain-> [ (!both e ih)
                                    ==> (same_mem v (dlst lh lsts (insertNAt b' (S m') v0 tail_dlls)) (dlst lh lsts tail_dlls)) [same_mem_axioms]
                                    ==> (same_mem v (insertNAt (S b') (S m') v0 (dlst lh lsts tail_dlls)) (dlst lh lsts tail_dlls)) [insertNAt_axioms] ])
                        }
                }
    }

    define same_mem_insertDPrList :=
        (forall bucket rv v v0 dlls .
            (~ (v = v0)) ==> (same_mem v (insertDPrList bucket rv v0 dlls) dlls))
    conclude same_mem_insertDPrList
        pick-any bucket:N rv:N v:'S v0:'S dlls:(DLst (Lst 'S))
          assume nv := (~ (v = v0))
            let { idx := (bucketIndex bucket dlls dlls zero);
                  d1  := (insertNAt idx (S rv) v0 dlls);
                  w   := (countWraps idx (S rv) dlls);
                  s1  := (!mp (!uspec* same_mem_insertNAt [d1 zero w v v0]) nv);
                  s2  := (!mp (!uspec* same_mem_insertNAt [dlls idx (S rv) v v0]) nv);
                  s12 := (!mp (!uspec* same_mem_trans [(insertNAt zero w v0 d1) v d1 dlls]) (!both s1 s2)) }
            (!chain-> [ s12 ==> (same_mem v (insertDPrList bucket rv v0 dlls) dlls) [insertDPrList_axioms] ])

    define in_after_insert_other :=
        (forall bucket bucket0 rv v v0 dlls .
            (~ (v = v0)) ==>
            ((in bucket0 rv (insertDPrList bucket rv v0 dlls)
                            (insertDPrList bucket rv v0 dlls) v)
             <==>
             (in bucket0 rv dlls dlls v)))
    conclude in_after_insert_other
        pick-any bucket:N bucket0:N rv:N v:'S v0:'S dlls:(DLst (Lst 'S))
          assume nv := (~ (v = v0))
            let { d' := (insertDPrList bucket rv v0 dlls);
                  sm := (!mp (!uspec* same_mem_insertDPrList [bucket rv v v0 dlls]) nv) }
            (!mp (!uspec* (!mp (!uspec* (!uspec* in_mem_inv_all [bucket0 rv v]) [d' dlls]) sm) [d' dlls]) sm)

    ### bucketIndex sees its list arguments only through their locations
    ### (PROVEN, same structure as ak-inv).
    define (bi-inv B) :=
        (forall dlls1 dlls2 . (same_locs dlls1 dlls2) ==>
           forall o_dlls1 o_dlls2 . (same_locs o_dlls1 o_dlls2) ==>
             forall n . (bucketIndex B dlls1 o_dlls1 n) = (bucketIndex B dlls2 o_dlls2 n))

    define (bi-dlst B) :=
        (forall lh lsts1 tail_dlls lsts2 tail_dlls2 . (same_locs tail_dlls tail_dlls2) ==>
           forall o_dlls1 o_dlls2 . (same_locs o_dlls1 o_dlls2) ==>
             forall n . (bucketIndex B (dlst lh lsts1 tail_dlls) o_dlls1 n) =
                        (bucketIndex B (dlst lh lsts2 tail_dlls2) o_dlls2 n))

    define (bi-close B dc) :=
      pick-any d1:(DLst (Lst 'S)) d2:(DLst (Lst 'S))
        assume deq := (same_locs d1 d2)
          pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
            assume oeq := (same_locs o1 o2)
              pick-any n:N
              (!cases (!mp (!uspec* locs_eq_cases [d1 d2]) deq)
                assume demp := (exists htl htl0 . ((d1 = (dempty htl)) & (d2 = (dempty htl0))))
                  pick-witnesses h1 h2 for demp dw
                    let { d1e := (!left-and dw);
                          d2e := (!right-and dw) }
                    (!cases (!mp (!uspec* locs_eq_cases [o1 o2]) oeq)
                      assume oemp := (exists htl htl0 . ((o1 = (dempty htl)) & (o2 = (dempty htl0))))
                        pick-witnesses g1 g2 for oemp ow
                          let { o1e := (!left-and ow);
                                o2e := (!right-and ow) }
                          (!chain [ (bucketIndex B d1 o1 n)
                                  = (bucketIndex B (dempty h1) (dempty g1) n)  [d1e o1e]
                                  = zero                                        [bucketIndex_axioms]
                                  = (bucketIndex B (dempty h2) (dempty g2) n)  [bucketIndex_axioms]
                                  = (bucketIndex B d2 o2 n)                    [d2e o2e] ])
                      assume ocons := (exists lh lsts1 tail_dlls lsts2 tail_dlls2 .
                                         ((o1 = (dlst lh lsts1 tail_dlls)) &
                                          ((o2 = (dlst lh lsts2 tail_dlls2)) &
                                           (same_locs tail_dlls tail_dlls2))))
                        pick-witnesses a s1 t1 s2 t2 for ocons ow
                          let { o1e  := (!left-and ow);
                                o2e  := (!left-and (!right-and ow));
                                teq  := (!right-and (!right-and ow));
                                step := (!uspec (!mp (!uspec* (!mp (!uspec* dc [a s1 t1 s2 t2]) teq) [o1 o2]) oeq) zero) }
                          (!chain [ (bucketIndex B d1 o1 n)
                                  = (bucketIndex B (dempty h1) (dlst a s1 t1) n)            [d1e o1e]
                                  = (bucketIndex B (dlst a s1 t1) (dlst a s1 t1) zero)      [bucketIndex_axioms]
                                  = (bucketIndex B (dlst a s1 t1) o1 zero)                  [o1e]
                                  = (bucketIndex B (dlst a s2 t2) o2 zero)                  [step]
                                  = (bucketIndex B (dlst a s2 t2) (dlst a s2 t2) zero)      [o2e]
                                  = (bucketIndex B (dempty h2) (dlst a s2 t2) n)            [bucketIndex_axioms]
                                  = (bucketIndex B d2 o2 n)                                 [d2e o2e] ]))
                assume dcons := (exists lh lsts1 tail_dlls lsts2 tail_dlls2 .
                                   ((d1 = (dlst lh lsts1 tail_dlls)) &
                                    ((d2 = (dlst lh lsts2 tail_dlls2)) &
                                     (same_locs tail_dlls tail_dlls2))))
                  pick-witnesses a s1 t1 s2 t2 for dcons dw
                    let { d1e  := (!left-and dw);
                          d2e  := (!left-and (!right-and dw));
                          teq  := (!right-and (!right-and dw));
                          step := (!uspec (!mp (!uspec* (!mp (!uspec* dc [a s1 t1 s2 t2]) teq) [o1 o2]) oeq) n) }
                    (!chain [ (bucketIndex B d1 o1 n)
                            = (bucketIndex B (dlst a s1 t1) o1 n)   [d1e]
                            = (bucketIndex B (dlst a s2 t2) o2 n)   [step]
                            = (bucketIndex B d2 o2 n)               [d2e] ]))

    define bucketIndex_locs_inv_all := (forall B . (bi-inv B))
    by-induction bucketIndex_locs_inv_all {
      zero =>
        let { dc := (bi-dlst zero);
              _  := conclude dc
                      pick-any a:Location s1:(Lst 'S) t1:(DLst (Lst 'S)) s2:(Lst 'S) t2:(DLst (Lst 'S))
                        assume (same_locs t1 t2)
                          pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
                            assume (same_locs o1 o2)
                              pick-any n:N
                                (!chain [ (bucketIndex zero (dlst a s1 t1) o1 n)
                                        = n                                        [bucketIndex_axioms]
                                        = (bucketIndex zero (dlst a s2 t2) o2 n)   [bucketIndex_axioms] ]) }
        (!bi-close zero dc)
    | (S bx) =>
        let { ih := (bi-inv bx);
              dc := (bi-dlst (S bx));
              _  := conclude dc
                      pick-any a:Location s1:(Lst 'S) t1:(DLst (Lst 'S)) s2:(Lst 'S) t2:(DLst (Lst 'S))
                        assume ht := (same_locs t1 t2)
                          pick-any o1:(DLst (Lst 'S)) o2:(DLst (Lst 'S))
                            assume ho := (same_locs o1 o2)
                              pick-any n:N
                                let { ihi := (!uspec (!mp (!uspec* (!mp (!uspec* ih [t1 t2]) ht) [o1 o2]) ho) (S n)) }
                                (!chain [ (bucketIndex (S bx) (dlst a s1 t1) o1 n)
                                        = (bucketIndex bx t1 o1 (S n))                 [bucketIndex_axioms]
                                        = (bucketIndex bx t2 o2 (S n))                 [ihi]
                                        = (bucketIndex (S bx) (dlst a s2 t2) o2 n)     [bucketIndex_axioms] ]) }
        (!bi-close (S bx) dc)
    }

    # Corollary: insertion does not change the reduced bucket index (PROVEN).
    define bucketIndex_insert_invariant :=
        (forall bucket rv v dlls bucket0 .
            (bucketIndex bucket0 (insertDPrList bucket rv v dlls) (insertDPrList bucket rv v dlls) zero) =
            (bucketIndex bucket0 dlls dlls zero))
    conclude bucketIndex_insert_invariant
        pick-any bucket:N rv:N v:'S dlls:(DLst (Lst 'S)) bucket0:N
            let { le := (!uspec* insertDPrList_preserves_locs [bucket rv v dlls]);
                  sl := (!chain-> [ le ==> (same_locs (insertDPrList bucket rv v dlls) dlls) [same_locs_def] ]) }
            (!uspec (!mp (!uspec* (!mp (!uspec* (!uspec bucketIndex_locs_inv_all bucket0)
                                                [(insertDPrList bucket rv v dlls) dlls]) sl)
                                  [(insertDPrList bucket rv v dlls) dlls]) sl) zero)

    ### Insertion at position pos puts v at the head of the bucket at pos
    ### (PROVEN, by induction on the bucket list).
    define head_after_insertNAt :=
        (forall dlls pos cnt v .
            (exists lh lsts tail_dlls . (drop pos dlls) = (dlst lh lsts tail_dlls)) ==> (exists lh lsts tail_dlls . (((drop pos (insertNAt pos (S cnt) v dlls)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))))
    by-induction head_after_insertNAt {
        (dempty htl:Location) =>
            pick-any pos:N cnt:N v:'S
              assume hyp := (exists lh lsts tail_dlls . (drop pos (dempty htl)) = (dlst lh lsts tail_dlls))
                pick-witnesses w1 w2 w3 for hyp weq
                  let { e  := (!chain [ (dempty htl) = (drop pos (dempty htl)) [drop_dempty]
                                                      = (dlst w1 w2 w3)         [weq] ]);
                        nc := (!uspec* dlst-no-conf [htl w1 w2 w3]) }
                  (!from-complements (exists lh lsts tail_dlls . (((drop pos (insertNAt pos (S cnt) v (dempty htl))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) e nc)
      | (dlst a:Location s:(Lst 'S) t:(DLst (Lst 'S))) =>
            let { IH := (forall pos cnt v . (exists lh lsts tail_dlls . (drop pos t) = (dlst lh lsts tail_dlls)) ==> (exists lh lsts tail_dlls . (((drop pos (insertNAt pos (S cnt) v t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))) }
            pick-any pos:N cnt:N v:'S
              datatype-cases ((exists lh lsts tail_dlls . (drop pos (dlst a s t)) = (dlst lh lsts tail_dlls)) ==> (exists lh lsts tail_dlls . (((drop pos (insertNAt pos (S cnt) v (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))) on pos {
                zero =>
                  assume hyp := (exists lh lsts tail_dlls . (drop zero (dlst a s t)) = (dlst lh lsts tail_dlls))
                    let { e1 := (!chain [ (drop zero (insertNAt zero (S cnt) v (dlst a s t)))
                                         = (insertNAt zero (S cnt) v (dlst a s t))              [drop_axioms]
                                         = (dlst a (lst v s) (insertNAt zero cnt v t))          [insertNAt_axioms] ]);
                          i1 := (!chain-> [ (!reflex v) ==> ((v = v) | (Lst.in v s))           [alternate]
                                                        ==> (Lst.in v (lst v s))               [Lst.In.in-lst-axiom] ]);
                          _  := (!both e1 i1) }
                    (!egen* (exists lh lsts tail_dlls . (((drop zero (insertNAt zero (S cnt) v (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [a (lst v s) (insertNAt zero cnt v t)])
              | (S p') =>
                  assume hyp := (exists lh lsts tail_dlls . (drop (S p') (dlst a s t)) = (dlst lh lsts tail_dlls))
                    let { h2 := (!chain-> [ hyp ==> (exists lh lsts tail_dlls . (drop p' t) = (dlst lh lsts tail_dlls)) [drop_axioms] ]);
                          ih := (!mp (!uspec* IH [p' cnt v]) h2) }
                    (!chain-> [ ih ==> (exists lh lsts tail_dlls . (((drop (S p') (insertNAt (S p') (S cnt) v (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [insertNAt_axioms drop_axioms] ])
              }
    }

    ### Further insertions keep v in the bucket at pos (PROVEN). They only
    ### prepend values to buckets.
    define head_kept_insertNAt :=
        (forall dlls pos bucket cnt v v0 .
            (exists lh lsts tail_dlls . (((drop pos dlls) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) ==> (exists lh lsts tail_dlls . (((drop pos (insertNAt bucket cnt v0 dlls)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))))
    by-induction head_kept_insertNAt {
        (dempty htl:Location) =>
            pick-any pos:N bucket:N cnt:N v:'S v0:'S
              assume hyp := (exists lh lsts tail_dlls . (((drop pos (dempty htl)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))
                pick-witnesses w1 w2 w3 for hyp hw
                  let { dw := (!left-and hw);
                        e  := (!chain [ (dempty htl) = (drop pos (dempty htl)) [drop_dempty]
                                                      = (dlst w1 w2 w3)         [dw] ]);
                        nc := (!uspec* dlst-no-conf [htl w1 w2 w3]) }
                  (!from-complements (exists lh lsts tail_dlls . (((drop pos (insertNAt bucket cnt v0 (dempty htl))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) e nc)
      | (dlst a:Location s:(Lst 'S) t:(DLst (Lst 'S))) =>
            let { IH := (forall pos bucket cnt v v0 . (exists lh lsts tail_dlls . (((drop pos t) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) ==> (exists lh lsts tail_dlls . (((drop pos (insertNAt bucket cnt v0 t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))));
                  # the head bucket of (dlst a s t) is s
                  headin := method (vv hyp)
                              pick-witnesses w1 w2 w3 for hyp hw
                                let { dw  := (!left-and hw);
                                      iw  := (!right-and hw);
                                      deq := (!chain [ (dlst a s t) = (drop zero (dlst a s t)) [drop_axioms]
                                                                    = (dlst w1 w2 w3)           [dw] ]);
                                      s_eq := (!chain [ s = (vHead (dlst a s t))    [DLst.dlst-vHead]
                                                          = (vHead (dlst w1 w2 w3)) [deq]
                                                          = w2                      [DLst.dlst-vHead] ]) }
                                (!chain-> [ iw ==> (Lst.in vv s) [s_eq] ]) }
            pick-any pos:N bucket:N cnt:N v:'S v0:'S
              datatype-cases ((exists lh lsts tail_dlls . (((drop pos (dlst a s t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) ==> (exists lh lsts tail_dlls . (((drop pos (insertNAt bucket cnt v0 (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))) on cnt {
                zero =>
                  assume hyp := (exists lh lsts tail_dlls . (((drop pos (dlst a s t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))
                    (!chain-> [ hyp ==> (exists lh lsts tail_dlls . (((drop pos (insertNAt bucket zero v0 (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [insertNAt_axioms] ])
              | (S m') =>
                  datatype-cases ((exists lh lsts tail_dlls . (((drop pos (dlst a s t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) ==> (exists lh lsts tail_dlls . (((drop pos (insertNAt bucket (S m') v0 (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))) on bucket {
                    zero =>
                      datatype-cases ((exists lh lsts tail_dlls . (((drop pos (dlst a s t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) ==> (exists lh lsts tail_dlls . (((drop pos (insertNAt zero (S m') v0 (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))) on pos {
                        zero =>
                          assume hyp := (exists lh lsts tail_dlls . (((drop zero (dlst a s t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))
                            let { ins := (!headin v hyp);
                                  e1  := (!chain [ (drop zero (insertNAt zero (S m') v0 (dlst a s t)))
                                                 = (insertNAt zero (S m') v0 (dlst a s t))          [drop_axioms]
                                                 = (dlst a (lst v0 s) (insertNAt zero m' v0 t))     [insertNAt_axioms] ]);
                                  i1  := (!chain-> [ ins ==> ((v = v0) | (Lst.in v s))  [alternate]
                                                         ==> (Lst.in v (lst v0 s))      [Lst.In.in-lst-axiom] ]);
                                  _   := (!both e1 i1) }
                            (!egen* (exists lh lsts tail_dlls . (((drop zero (insertNAt zero (S m') v0 (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [a (lst v0 s) (insertNAt zero m' v0 t)])
                      | (S p') =>
                          assume hyp := (exists lh lsts tail_dlls . (((drop (S p') (dlst a s t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))
                            let { h2 := (!chain-> [ hyp ==> (exists lh lsts tail_dlls . (((drop p' t) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [drop_axioms] ]);
                                  ih := (!mp (!uspec* IH [p' zero m' v v0]) h2) }
                            (!chain-> [ ih ==> (exists lh lsts tail_dlls . (((drop (S p') (insertNAt zero (S m') v0 (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [insertNAt_axioms drop_axioms] ])
                      }
                  | (S b') =>
                      datatype-cases ((exists lh lsts tail_dlls . (((drop pos (dlst a s t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) ==> (exists lh lsts tail_dlls . (((drop pos (insertNAt (S b') (S m') v0 (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))) on pos {
                        zero =>
                          assume hyp := (exists lh lsts tail_dlls . (((drop zero (dlst a s t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))
                            let { ins := (!headin v hyp);
                                  e1  := (!chain [ (drop zero (insertNAt (S b') (S m') v0 (dlst a s t)))
                                                 = (insertNAt (S b') (S m') v0 (dlst a s t))       [drop_axioms]
                                                 = (dlst a s (insertNAt b' (S m') v0 t))           [insertNAt_axioms] ]);
                                  _   := (!both e1 ins) }
                            (!egen* (exists lh lsts tail_dlls . (((drop zero (insertNAt (S b') (S m') v0 (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [a s (insertNAt b' (S m') v0 t)])
                      | (S p') =>
                          assume hyp := (exists lh lsts tail_dlls . (((drop (S p') (dlst a s t)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))
                            let { h2 := (!chain-> [ hyp ==> (exists lh lsts tail_dlls . (((drop p' t) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [drop_axioms] ]);
                                  ih := (!mp (!uspec* IH [p' b' (S m') v v0]) h2) }
                            (!chain-> [ ih ==> (exists lh lsts tail_dlls . (((drop (S p') (insertNAt (S b') (S m') v0 (dlst a s t))) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [insertNAt_axioms drop_axioms] ])
                      }
                  }
              }
    }

    ### The lookup walk of `in` from bucket index `bucket` ends at the bucket
    ### that bucketIndex computes, and that bucket exists. If it contains v,
    ### `in` finds v (PROVEN, by induction on the bucket index).
    define in_walk_wrap :=
        method (bucket dc)
            pick-any pos:N rv:N o_dlls:(DLst (Lst 'S)) v:'S
                assume ex := (exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls))
                    (!cases (!uspec dlst-no-junk (drop pos o_dlls))
                        assume is_empty := (exists htl . (drop pos o_dlls) = (dempty htl))
                            pick-witness wh for is_empty weq
                            pick-witnesses ow1 ow2 ow3 for ex oeq
                                let { oeqs := (!sym oeq);
                                      bi := (!chain [ (bucketIndex bucket (drop pos o_dlls) o_dlls pos)
                                                    = (bucketIndex bucket (dempty wh) o_dlls pos)    [weq]
                                                    = (bucketIndex bucket (dempty wh) (dlst ow1 ow2 ow3) pos)       [oeq]
                                                    = (bucketIndex bucket (dlst ow1 ow2 ow3) (dlst ow1 ow2 ow3) zero)              [bucketIndex_axioms]
                                                    = (bucketIndex bucket o_dlls o_dlls zero)        [oeqs] ]);
                                      ie := (!chain [ (in bucket rv (drop pos o_dlls) o_dlls v)
                                                    <==> (in bucket rv (dempty wh) o_dlls v)         [weq]
                                                    <==> (in bucket rv (dempty wh) (dlst ow1 ow2 ow3) v)            [oeq]
                                                    <==> (in bucket rv (dlst ow1 ow2 ow3) (dlst ow1 ow2 ow3) v)                    [in_axioms]
                                                    <==> (in bucket rv o_dlls o_dlls v)              [oeqs] ]);
                                      dq0 := (!chain [ (drop zero (dlst ow1 ow2 ow3)) = (dlst ow1 ow2 ow3) [drop_axioms] ]);
                                      _   := (!reflex (dlst ow1 ow2 ow3));
                                      ex0 := (!egen* (exists olh olsts otail_dlls . (dlst ow1 ow2 ow3) = (dlst olh olsts otail_dlls)) [ow1 ow2 ow3]);
                                      r0  := (!mp (!uspec* dc [zero rv (dlst ow1 ow2 ow3) v ow1 ow2 ow3]) (!both dq0 ex0));
                                      r1  := (!chain-> [ r0 ==> ((exists lh lsts tail_dlls . (drop (bucketIndex bucket o_dlls o_dlls zero) o_dlls) = (dlst lh lsts tail_dlls)) &
             ((exists lh lsts tail_dlls . (((drop (bucketIndex bucket o_dlls o_dlls zero) o_dlls) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) ==> (in bucket rv o_dlls o_dlls v))) [oeqs] ]);
                                      a1  := (!chain-> [ (!left-and r1) ==> (exists lh lsts tail_dlls . (drop (bucketIndex bucket (drop pos o_dlls) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) [bi] ]);
                                      im  := assume h := (exists lh lsts tail_dlls . (((drop (bucketIndex bucket (drop pos o_dlls) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))
                                               let { h0 := (!chain-> [ h ==> (exists lh lsts tail_dlls . (((drop (bucketIndex bucket o_dlls o_dlls zero) o_dlls) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [bi] ]);
                                                     i0 := (!mp (!right-and r1) h0) }
                                               (!chain-> [ i0 ==> (in bucket rv (drop pos o_dlls) o_dlls v) [ie] ]) }
                                (!both a1 im)
                        assume is_dlst := (exists lh lsts tail_dlls . (drop pos o_dlls) = (dlst lh lsts tail_dlls))
                            pick-witnesses w1 w2 w3 for is_dlst weq
                                let { r := (!mp (!uspec* dc [pos rv o_dlls v w1 w2 w3]) (!both weq ex)) }
                                (!chain-> [ r ==> ((exists lh lsts tail_dlls . (drop (bucketIndex bucket (drop pos o_dlls) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) &
             ((exists lh lsts tail_dlls . (((drop (bucketIndex bucket (drop pos o_dlls) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) ==> (in bucket rv (drop pos o_dlls) o_dlls v))) [weq] ]))

    define in_walk :=
        (forall bucket pos rv o_dlls v . (exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) ==> ((exists lh lsts tail_dlls . (drop (bucketIndex bucket (drop pos o_dlls) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) &
             ((exists lh lsts tail_dlls . (((drop (bucketIndex bucket (drop pos o_dlls) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) ==> (in bucket rv (drop pos o_dlls) o_dlls v))))
    by-induction in_walk {
        zero =>
            let { dc := pick-any pos:N rv:N o_dlls:(DLst (Lst 'S)) v:'S lh9:Location lsts9:(Lst 'S) tl9:(DLst (Lst 'S))
                          assume hyp := (((drop pos o_dlls) = (dlst lh9 lsts9 tl9)) & (exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)))
                            let { dq := (!left-and hyp);
                                  bi := (!chain [ (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) = pos [bucketIndex_axioms] ]);
                                  de := (!chain [ (drop (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) o_dlls)
                                                = (drop pos o_dlls)           [bi]
                                                = (dlst lh9 lsts9 tl9)        [dq] ]);
                                  a1 := (!egen* (exists lh lsts tail_dlls . (drop (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) [lh9 lsts9 tl9]);
                                  im := assume h := (exists lh lsts tail_dlls . (((drop (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))
                                          pick-witnesses w1 w2 w3 for h hw
                                            let { dw  := (!left-and hw);
                                                  iw  := (!right-and hw);
                                                  deq := (!chain [ (dlst lh9 lsts9 tl9)
                                                                 = (drop (bucketIndex zero (dlst lh9 lsts9 tl9) o_dlls pos) o_dlls) [de]
                                                                 = (dlst w1 w2 w3)                                                  [dw] ]);
                                                  s_eq := (!chain [ lsts9 = (vHead (dlst lh9 lsts9 tl9)) [DLst.dlst-vHead]
                                                                          = (vHead (dlst w1 w2 w3))     [deq]
                                                                          = w2                          [DLst.dlst-vHead] ]);
                                                  il  := (!chain-> [ iw ==> (Lst.in v lsts9) [s_eq] ]) }
                                            datatype-cases (in zero rv (dlst lh9 lsts9 tl9) o_dlls v) on rv {
                                                zero   => (!chain-> [ il ==> (in zero zero (dlst lh9 lsts9 tl9) o_dlls v) [in_axioms] ])
                                              | (S r') => (!chain-> [ il ==> ((in zero (S r') (dlst lh9 lsts9 tl9) o_dlls v) <==> true) [in_axioms]
                                                                        ==> (in zero (S r') (dlst lh9 lsts9 tl9) o_dlls v)            [prop-taut] ])
                                            } }
                            (!both a1 im) }
            (!in_walk_wrap zero dc)
      | (S bx) =>
            let { IH := (forall pos rv o_dlls v . (exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)) ==> ((exists lh lsts tail_dlls . (drop (bucketIndex bx (drop pos o_dlls) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) &
             ((exists lh lsts tail_dlls . (((drop (bucketIndex bx (drop pos o_dlls) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) ==> (in bx rv (drop pos o_dlls) o_dlls v))));
                  dc := pick-any pos:N rv:N o_dlls:(DLst (Lst 'S)) v:'S lh9:Location lsts9:(Lst 'S) tl9:(DLst (Lst 'S))
                          assume hyp := (((drop pos o_dlls) = (dlst lh9 lsts9 tl9)) & (exists olh olsts otail_dlls . o_dlls = (dlst olh olsts otail_dlls)))
                            let { dq := (!left-and hyp);
                                  ex := (!right-and hyp);
                                  ds := (!mp (!uspec* drop_step [o_dlls pos lh9 lsts9 tl9]) dq);
                                  bi := (!chain [ (bucketIndex (S bx) (dlst lh9 lsts9 tl9) o_dlls pos)
                                                = (bucketIndex bx tl9 o_dlls (S pos))                     [bucketIndex_axioms]
                                                = (bucketIndex bx (drop (S pos) o_dlls) o_dlls (S pos))   [ds] ]);
                                  r  := (!mp (!uspec* IH [(S pos) rv o_dlls v]) ex);
                                  a1 := (!chain-> [ (!left-and r) ==> (exists lh lsts tail_dlls . (drop (bucketIndex (S bx) (dlst lh9 lsts9 tl9) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) [bi] ]);
                                  im := assume h := (exists lh lsts tail_dlls . (((drop (bucketIndex (S bx) (dlst lh9 lsts9 tl9) o_dlls pos) o_dlls) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts)))
                                          let { h1 := (!chain-> [ h ==> (exists lh lsts tail_dlls . (((drop (bucketIndex bx (drop (S pos) o_dlls) o_dlls (S pos)) o_dlls) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [bi] ]);
                                                i1 := (!mp (!right-and r) h1) }
                                          (!chain-> [ i1 ==> (in bx rv tl9 o_dlls v)                         [ds]
                                                         ==> (in (S bx) rv (dlst lh9 lsts9 tl9) o_dlls v)    [in_axioms] ]) }
                            (!both a1 im) }
            (!in_walk_wrap (S bx) dc)
    }

    ### After inserting v at any bucket index of a non-empty bucket list,
    ### `in` finds v (PROVEN).
    define in_after_insert_self :=
        (forall bucket rv v dlls .
            (exists lh lsts tail_dlls . dlls = (dlst lh lsts tail_dlls)) ==>
            (in bucket rv (insertDPrList bucket rv v dlls) (insertDPrList bucket rv v dlls) v))
    conclude in_after_insert_self
        pick-any bucket:N rv:N v:'S dlls:(DLst (Lst 'S))
          assume ne := (exists lh lsts tail_dlls . dlls = (dlst lh lsts tail_dlls))
            let { idx := (bucketIndex bucket dlls dlls zero);
                  d1  := (insertNAt idx (S rv) v dlls);
                  w   := (countWraps idx (S rv) dlls);
                  d'  := (insertDPrList bucket rv v dlls);
                  w0  := (!mp (!uspec* in_walk [bucket zero rv dlls v]) ne);
                  a0  := (!chain-> [ (!left-and w0) ==> (exists lh lsts tail_dlls . (drop idx dlls) = (dlst lh lsts tail_dlls)) [drop_axioms] ]);
                  h1  := (!mp (!uspec* head_after_insertNAt [dlls idx rv v]) a0);
                  h2  := (!mp (!uspec* head_kept_insertNAt [d1 idx zero w v v]) h1);
                  h3  := (!chain-> [ h2 ==> (exists lh lsts tail_dlls . (((drop idx (insertDPrList bucket rv v dlls)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [insertDPrList_axioms] ]);
                  bii := (!uspec* bucketIndex_insert_invariant [bucket rv v dlls bucket]);
                  h4  := (!chain-> [ h3 ==> (exists lh lsts tail_dlls . (((drop (bucketIndex bucket (insertDPrList bucket rv v dlls) (insertDPrList bucket rv v dlls) zero) (insertDPrList bucket rv v dlls)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [bii] ]) }
            pick-witnesses nl nlsts nt for ne neq
              let { le  := (!uspec* insertDPrList_preserves_locs [bucket rv v dlls]);
                    lc  := (!chain [ (dlls_locs (insertDPrList bucket rv v dlls))
                                   = (dlls_locs dlls)                     [le]
                                   = (dlls_locs (dlst nl nlsts nt))       [neq]
                                   = (lst nl (dlls_locs nt))              [dlls_locs_axioms] ]);
                    ne' := (!mp (!uspec* locs_lst_implies_dlst [(insertDPrList bucket rv v dlls) nl (dlls_locs nt)]) lc);
                    w1  := (!mp (!uspec* in_walk [bucket zero rv (insertDPrList bucket rv v dlls) v]) ne');
                    h5  := (!chain-> [ h4 ==> (exists lh lsts tail_dlls . (((drop (bucketIndex bucket (drop zero (insertDPrList bucket rv v dlls)) (insertDPrList bucket rv v dlls) zero) (insertDPrList bucket rv v dlls)) = (dlst lh lsts tail_dlls)) & (Lst.in v lsts))) [drop_axioms] ]);
                    i5  := (!mp (!right-and w1) h5) }
              (!chain-> [ i5 ==> (in bucket rv (insertDPrList bucket rv v dlls) (insertDPrList bucket rv v dlls) v) [drop_axioms] ])
}

open DL_L_S